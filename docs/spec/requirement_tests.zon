        .{ .id = "basic/authorization#049-6cd185", .tests = .{ "src/mcp/auth/resource_server.zig:challenges and decisions", "src/grpc/spec_test/authorization_test.zig:grpc server requires a valid bearer token for the audience when auth is set" }, .note = "Tokens for another audience are refused. The principal gives claims to handlers but never the token." },
        .{ .id = "basic/authorization#050-ff46d9", .tests = .{"src/mcp/spec_test/authorization_test.zig:oauth client refuses authorization server endpoints without https"}, .note = "Token endpoints must use https. The client does not keep refresh tokens at all." },
