        .{ .id = "basic/authorization/security-considerations#009-b4ed9a", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component. The client refuses http authorization and token endpoints." },
        .{ .id = "basic/authorization/security-considerations#010-f0753f", .status = .gap, .reason = "The default redirect URI is a loopback URI. The client does not check Options.redirect_uri. No test." },
