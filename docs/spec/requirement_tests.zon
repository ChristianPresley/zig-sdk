// Maps each requirement of docs/spec/requirements.zon to tests, or to a status with a reason.
// Maintained by hand. `zig build spec-matrix` checks this file and renders
// docs/generated/conformance-matrix.md.
//
// A test is "path.zig:test name", "conformance:server/NAME" or "conformance:client/NAME".
// The status is .tested (the default), .na, .app or .gap. Each status other than .tested
// needs a .reason. A .gap entry can list tests that cover a part of the requirement.
.{
    .harness = "@modelcontextprotocol/conformance@0.2.0-alpha.11",
    // The scored scenarios of `--requirements 2026-07-28`. The CI job conformance runs them.
    .scenarios = .{
        .server = .{
            "server-stateless",
            "completion-complete",
            "tools-list",
            "tools-call-simple-text",
            "tools-call-image",
            "tools-call-audio",
            "tools-call-embedded-resource",
            "tools-call-mixed-content",
            "tools-call-error",
            "tools-call-with-progress",
            "server-sse-multiple-streams",
            "resources-list",
            "resources-read-text",
            "resources-read-binary",
            "resources-templates-read",
            "sep-2164-resource-not-found",
            "prompts-list",
            "prompts-get-simple",
            "prompts-get-with-args",
            "prompts-get-embedded-resource",
            "prompts-get-with-image",
            "dns-rebinding-protection",
            "caching",
            "input-required-result-basic-elicitation",
            "input-required-result-basic-sampling",
            "input-required-result-basic-list-roots",
            "input-required-result-request-state",
            "input-required-result-multiple-input-requests",
            "input-required-result-multi-round",
            "input-required-result-missing-input-response",
            "input-required-result-non-tool-request",
            "input-required-result-result-type",
            "input-required-result-unsupported-methods",
            "input-required-result-tampered-state",
            "input-required-result-capability-check",
            "input-required-result-ignore-extra-params",
            "input-required-result-validate-input",
        },
        .client = .{
            "tools_call",
            "request-metadata",
            "auth/metadata-default",
            "auth/metadata-var1",
            "auth/metadata-var2",
            "auth/metadata-var3",
            "auth/basic-cimd",
            "auth/scope-from-www-authenticate",
            "auth/scope-from-scopes-supported",
            "auth/scope-omitted-when-undefined",
            "auth/scope-step-up",
            "auth/scope-retry-limit",
            "auth/token-endpoint-auth-basic",
            "auth/token-endpoint-auth-post",
            "auth/token-endpoint-auth-none",
            "auth/pre-registration",
            "auth/resource-mismatch",
            "auth/offline-access-scope",
            "auth/offline-access-not-supported",
            "auth/authorization-server-migration",
            "auth/iss-supported",
            "auth/iss-not-advertised",
            "auth/iss-supported-missing",
            "auth/iss-wrong-issuer",
            "auth/iss-unexpected",
            "auth/iss-normalized",
            "auth/metadata-issuer-mismatch",
            "sep-2322-client-request-state",
            "http-standard-headers",
            "http-custom-headers",
            "http-invalid-tool-headers",
            "json-schema-ref-no-deref",
        },
    },
    .mappings = .{
        .{ .id = "basic/authorization/authorization-server-discovery#001-3cb045", .tests = .{ "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal", "src/mcp/auth/resource_server.zig:challenges and decisions" }, .note = "The HTTP server serves the RFC 9728 document from ResourceServer.metadataJson." },
        .{ .id = "basic/authorization/authorization-server-discovery#002-fdbecb", .tests = .{"src/mcp/auth/resource_server.zig:challenges and decisions"}, .note = "The document lists the configured authorization servers. The SDK does not reject an empty list." },
        .{ .id = "basic/authorization/authorization-server-discovery#003-bec089", .status = .gap, .tests = .{"conformance:client/auth/authorization-server-migration"}, .reason = "Dynamic registration state is kept per issuer and cleared on a change. Pre-registered credentials carry no issuer and the client reuses them for a new authorization server." },
        .{ .id = "basic/authorization/authorization-server-discovery#004-e296db", .tests = .{ "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal", "src/mcp/auth/resource_server.zig:challenges and decisions" } },
        .{ .id = "basic/authorization/authorization-server-discovery#005-07b364", .tests = .{"src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal"}, .note = "The server serves the document at the path-inserted well-known URI." },
        .{ .id = "basic/authorization/authorization-server-discovery#006-7b3f9c", .tests = .{ "conformance:client/auth/metadata-default", "conformance:client/auth/metadata-var1", "conformance:client/auth/metadata-var2", "conformance:client/auth/metadata-var3", "src/mcp/spec_test/authorization_discovery_test.zig:client without a challenge URL falls back to well-known resource and server metadata in order" } },
        .{ .id = "basic/authorization/authorization-server-discovery#007-306b0f", .tests = .{ "src/mcp/auth/oauth_client.zig:challenge parsing", "conformance:client/auth/metadata-default", "conformance:client/auth/scope-from-www-authenticate" } },
        .{ .id = "basic/authorization/authorization-server-discovery#008-7a2391", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client tries the three well-known locations in order for an issuer with a path", "src/mcp/spec_test/authorization_discovery_test.zig:client without a challenge URL falls back to well-known resource and server metadata in order", "conformance:client/auth/metadata-var1", "conformance:client/auth/metadata-var3" } },
        .{ .id = "basic/authorization/authorization-server-discovery#009-0199fa", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client tries the three well-known locations in order for an issuer with a path", "conformance:client/auth/metadata-var2" } },
        .{ .id = "basic/authorization/authorization-server-discovery#010-2f643d", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client tries the three well-known locations in order for an issuer with a path", "src/mcp/spec_test/authorization_discovery_test.zig:client uses openid configuration with path insertion for an issuer with a path" } },
        .{ .id = "basic/authorization/authorization-server-discovery#011-139a23", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client tries the three well-known locations in order for an issuer with a path", "conformance:client/auth/metadata-var3" } },
        .{ .id = "basic/authorization/authorization-server-discovery#012-45aa38", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client without a challenge URL falls back to well-known resource and server metadata in order", "conformance:client/auth/metadata-default" } },
        .{ .id = "basic/authorization/authorization-server-discovery#013-ce9c0e", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client without a challenge URL falls back to well-known resource and server metadata in order", "conformance:client/auth/metadata-var1" } },
        .{ .id = "basic/authorization/authorization-server-discovery#014-25f4f1", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client rejects authorization server metadata whose issuer differs from the queried issuer", "conformance:client/auth/metadata-issuer-mismatch" } },
        .{ .id = "basic/authorization/authorization-server-discovery#015-87796f", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client rejects authorization server metadata whose issuer differs from the queried issuer", "conformance:client/auth/metadata-issuer-mismatch" }, .note = "No endpoint of the rejected document is used." },
        .{ .id = "basic/authorization/authorization-server-discovery#016-519ccd", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client rejects authorization server metadata whose issuer differs from the queried issuer", "conformance:client/auth/metadata-issuer-mismatch" } },
        .{ .id = "basic/authorization/client-registration#001-ddabcf", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client prefers pre-registered credentials over metadata documents and registration", "conformance:client/auth/pre-registration" }, .note = "The application selects pre-registration in OAuthClient.Options.registration." },
        .{ .id = "basic/authorization/client-registration#002-f566f8", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client uses its metadata document URL as client_id when the server supports it", "conformance:client/auth/basic-cimd" } },
        .{ .id = "basic/authorization/client-registration#003-19e9a0", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client registers dynamically with application_type native and its redirect URI", "conformance:client/auth/metadata-default" }, .note = "A configured metadata document URL falls back to dynamic registration." },
        .{ .id = "basic/authorization/client-registration#004-914195", .status = .app, .reason = "The client returns error.RegistrationUnavailable. The application then asks the user for client information." },
        .{ .id = "basic/authorization/client-registration#005-e2964f", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client uses its metadata document URL as client_id when the server supports it", "conformance:client/auth/basic-cimd" }, .note = "Client side only. The SDK has no authorization server." },
        .{ .id = "basic/authorization/client-registration#006-c0308c", .status = .na, .reason = "This restates the Client ID Metadata Document rules. Items 007 to 017 of this page map them one by one." },
        .{ .id = "basic/authorization/client-registration#007-274d15", .status = .app, .reason = "The application hosts the metadata document. The SDK only sends the configured URL as client_id." },
        .{ .id = "basic/authorization/client-registration#008-807408", .status = .gap, .reason = "The SDK does not check that Registration.client_metadata_url uses https and has a path. No test." },
        .{ .id = "basic/authorization/client-registration#009-a80226", .status = .app, .reason = "The application writes and hosts the metadata document. The SDK does not produce it." },
        .{ .id = "basic/authorization/client-registration#010-16562a", .status = .app, .reason = "The application writes the metadata document. The SDK does not produce or fetch it." },
        .{ .id = "basic/authorization/client-registration#011-6739be", .status = .na, .reason = "The optional private_key_jwt client authentication is not implemented." },
        .{ .id = "basic/authorization/client-registration#012-8c6382", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization/client-registration#013-b65a58", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization/client-registration#014-2f4c4c", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization/client-registration#015-13abde", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization/client-registration#016-9f5d63", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization/client-registration#017-aadfbc", .status = .na, .reason = "This is an obligation of the authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization/client-registration#018-b6692e", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client uses its metadata document URL as client_id when the server supports it", "src/mcp/spec_test/authorization_discovery_test.zig:client registers dynamically with application_type native and its redirect URI", "conformance:client/auth/basic-cimd", "conformance:client/auth/metadata-default" }, .note = "The client reads client_id_metadata_document_supported and falls back to dynamic registration." },
        .{ .id = "basic/authorization/client-registration#019-e73da8", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client prefers pre-registered credentials over metadata documents and registration", "conformance:client/auth/pre-registration" }, .note = "Registration.pre_registered takes a static client_id and secret." },
        .{ .id = "basic/authorization/client-registration#020-716332", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client registers dynamically with application_type native and its redirect URI", "conformance:client/auth/metadata-default" }, .note = "Client side only." },
        .{ .id = "basic/authorization/client-registration#021-abc98d", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client registers dynamically with application_type native and its redirect URI", "conformance:client/auth/metadata-default" }, .note = "The harness check sep-837-application-type-present runs in every registration." },
        .{ .id = "basic/authorization/client-registration#022-077c8a", .tests = .{"src/mcp/spec_test/authorization_discovery_test.zig:client registers dynamically with application_type native and its redirect URI"}, .note = "The client always sends native." },
        .{ .id = "basic/authorization/client-registration#023-a0dc65", .status = .gap, .reason = "The client always sends application_type native. It has no option for web applications." },
        .{ .id = "basic/authorization/client-registration#024-83ff62", .tests = .{"src/mcp/spec_test/authorization_discovery_test.zig:client returns an error when dynamic registration fails"}, .note = "A rejected registration gives error.RegistrationFailed and the flow stops." },
        .{ .id = "basic/authorization/client-registration#025-823ee2", .status = .gap, .tests = .{"src/mcp/spec_test/authorization_discovery_test.zig:client returns an error when dynamic registration fails"}, .reason = "handleChallenge returns error.RegistrationFailed but drops the error text of the server. The HTTP client transport reports only the HTTP status." },
        .{ .id = "basic/authorization/client-registration#026-1bbfbc", .status = .na, .reason = "The optional retry with another application_type is not implemented." },
        .{ .id = "basic/authorization/client-registration#027-242409", .status = .gap, .tests = .{"conformance:client/auth/authorization-server-migration"}, .reason = "Registered credentials are tied to the current issuer. Registration.pre_registered has no issuer, so pre-registered credentials are not keyed by issuer." },
        .{ .id = "basic/authorization/client-registration#028-e7ba6f", .status = .gap, .tests = .{"conformance:client/auth/authorization-server-migration"}, .reason = "Dynamic registration repeats on an issuer change. Pre-registered credentials are sent to the new authorization server again." },
        .{ .id = "basic/authorization/client-registration#029-776f2c", .status = .gap, .reason = "On an issuer change the client silently registers again or reuses pre-registered credentials. It does not surface an error." },
        .{ .id = "basic/authorization#001-33415a", .status = .app, .reason = "The application decides. The auth option of the HTTP and gRPC server transports and of the HTTP client transport is null by default." },
        .{ .id = "basic/authorization#002-55e7ce", .status = .na, .reason = "Summary sentence. Each rule of this page has its own entry in this list." },
        .{ .id = "basic/authorization#003-52eaed", .status = .app, .reason = "The stdio transport has no authorization. The host gives credentials to the server process through the environment." },
        .{ .id = "basic/authorization#004-a5409e", .tests = .{ "src/grpc/spec_test/authorization_test.zig:grpc server requires a valid bearer token for the audience when auth is set", "src/grpc/grpc_test.zig:grpc over TLS with ALPN h2" }, .note = "The gRPC transport uses TLS and the same bearer token checks as HTTP." },
        .{ .id = "basic/authorization#005-be0180", .status = .na, .reason = "Obligation of an authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization#006-103d81", .tests = .{"conformance:client/auth/basic-cimd"}, .note = "Client side. The SDK has no authorization server." },
        .{ .id = "basic/authorization#007-63de29", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client registers the refresh_token grant and does not require a refresh token", "conformance:client/auth/metadata-default" }, .note = "Client side. The client registers dynamically when the server has no client ID metadata document support." },
        .{ .id = "basic/authorization#008-15cf12", .tests = .{ "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal", "src/mcp/auth/resource_server.zig:challenges and decisions" } },
        .{ .id = "basic/authorization#009-4d66f7", .tests = .{ "conformance:client/auth/metadata-default", "conformance:client/auth/metadata-var1", "conformance:client/auth/metadata-var2", "conformance:client/auth/metadata-var3" } },
        .{ .id = "basic/authorization#010-38796e", .status = .na, .reason = "Obligation of an authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization#011-0ec528", .status = .na, .reason = "Obligation of an authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization#012-0e707a", .tests = .{ "conformance:client/auth/metadata-default", "conformance:client/auth/metadata-var1", "conformance:client/auth/metadata-var2", "conformance:client/auth/metadata-var3" }, .note = "metadata-default and var2 use RFC 8414. var1 and var3 use OpenID Connect Discovery." },
        .{ .id = "basic/authorization#013-fadf86", .status = .na, .reason = "Restates the rules of basic/authorization/authorization-server-discovery. They have their own entries." },
        .{ .id = "basic/authorization#014-e66bad", .tests = .{ "conformance:client/auth/basic-cimd", "conformance:client/auth/pre-registration", "conformance:client/auth/metadata-default" }, .note = "One scenario for each registration mechanism." },
        .{ .id = "basic/authorization#015-c238df", .tests = .{ "src/mcp/auth/resource_server.zig:challenges and decisions", "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal", "src/mcp/spec_test/authorization_test.zig:resource server challenges insufficient scope with 403 and all required scopes at once" } },
        .{ .id = "basic/authorization#016-c10fcb", .status = .app, .reason = "The server author chooses scopes_supported and required_scopes of ResourceServer. The client rule is basic/authorization#017." },
        .{ .id = "basic/authorization#017-6b4a26", .tests = .{"src/mcp/spec_test/authorization_test.zig:oauth client requests exactly the challenged scopes whatever their relation to scopes_supported"} },
        .{ .id = "basic/authorization#018-d28691", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client requests exactly the challenged scopes whatever their relation to scopes_supported", "conformance:client/auth/scope-from-www-authenticate", "conformance:client/auth/scope-step-up" } },
        .{ .id = "basic/authorization#019-caf8b2", .tests = .{"conformance:client/auth/scope-step-up"}, .note = "Check sep-2350-scope-union-on-reauth." },
        .{ .id = "basic/authorization#020-1659de", .status = .app, .reason = "The server author configures the scope sets of ResourceServer." },
        .{ .id = "basic/authorization#021-8a1d74", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client requests exactly the challenged scopes whatever their relation to scopes_supported", "conformance:client/auth/scope-from-www-authenticate", "conformance:client/auth/scope-omitted-when-undefined" }, .note = "The client asks only for the challenged or advertised scopes." },
        .{ .id = "basic/authorization#022-bdced4", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client requests exactly the challenged scopes whatever their relation to scopes_supported", "conformance:client/auth/scope-from-www-authenticate" } },
        .{ .id = "basic/authorization#023-e52488", .tests = .{ "conformance:client/auth/scope-from-scopes-supported", "conformance:client/auth/scope-omitted-when-undefined" } },
        .{ .id = "basic/authorization#024-697778", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client rejects a wrong or normalized iss before it contacts the token endpoint", "conformance:client/auth/iss-supported", "conformance:client/auth/iss-wrong-issuer", "conformance:client/auth/iss-unexpected", "conformance:client/auth/metadata-issuer-mismatch" }, .note = "The client compares iss with the issuer of the validated metadata." },
        .{ .id = "basic/authorization#025-40fa10", .status = .na, .reason = "Obligation of an authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization#026-248374", .status = .na, .reason = "Obligation of an authorization server. The SDK has no authorization server component." },
        .{ .id = "basic/authorization#027-0870de", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client rejects a wrong or normalized iss before it contacts the token endpoint", "conformance:client/auth/iss-supported", "conformance:client/auth/iss-not-advertised", "conformance:client/auth/iss-supported-missing", "conformance:client/auth/iss-wrong-issuer", "conformance:client/auth/iss-unexpected" }, .note = "The Zig test also checks that no token request occurs." },
        .{ .id = "basic/authorization#028-b7b835", .status = .na, .reason = "States a possible change in a future revision. It sets no requirement now." },
        .{ .id = "basic/authorization#029-7a1e7a", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client rejects a wrong or normalized iss before it contacts the token endpoint", "conformance:client/auth/iss-normalized" } },
        .{ .id = "basic/authorization#030-e50055", .tests = .{"src/mcp/spec_test/authorization_test.zig:oauth client does not act on an error response whose iss does not match"}, .note = "The client returns a generic failure and never reads the error fields." },
        .{ .id = "basic/authorization#031-45decc", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the canonical server uri as resource in the authorization and token requests", "conformance:client/auth/token-endpoint-auth-basic", "conformance:client/auth/token-endpoint-auth-post", "conformance:client/auth/token-endpoint-auth-none" } },
        .{ .id = "basic/authorization#032-c48b81", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the canonical server uri as resource in the authorization and token requests", "conformance:client/auth/token-endpoint-auth-basic", "conformance:client/auth/token-endpoint-auth-post", "conformance:client/auth/token-endpoint-auth-none" }, .note = "Checks resource-parameter-in-authorization and resource-parameter-in-token." },
        .{ .id = "basic/authorization#033-48a3a4", .tests = .{"src/mcp/spec_test/authorization_test.zig:oauth client sends the canonical server uri as resource in the authorization and token requests"}, .note = "The resource value equals the MCP server URL." },
        .{ .id = "basic/authorization#034-2f75d9", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the canonical server uri as resource in the authorization and token requests", "conformance:client/auth/token-endpoint-auth-none" }, .note = "Checks resource-parameter-valid-uri and the equality with the server URL." },
        .{ .id = "basic/authorization#035-d35bce", .status = .gap, .reason = "The client sends the resource of the metadata. It can be a parent of the server URL and so less specific. No test." },
        .{ .id = "basic/authorization#036-d4a300", .status = .gap, .reason = "The client compares the metadata resource with the server URL byte for byte. JwtVerifier compares the audience byte for byte. Uppercase forms fail." },
        .{ .id = "basic/authorization#037-85aada", .status = .app, .reason = "The server author sets ResourceServer.resource. The client sends the metadata resource without change." },
        .{ .id = "basic/authorization#038-97c806", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the canonical server uri as resource in the authorization and token requests", "conformance:client/auth/token-endpoint-auth-none" }, .note = "The mock authorization servers do not advertise resource indicator support." },
        .{ .id = "basic/authorization#039-ba16b4", .tests = .{ "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal", "src/mcp/auth/resource_server.zig:challenges and decisions" } },
        .{ .id = "basic/authorization#040-579236", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the token in the authorization header of every request and never in the query", "conformance:client/auth/metadata-default" } },
        .{ .id = "basic/authorization#041-93a522", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the token in the authorization header of every request and never in the query", "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal" }, .note = "Client: every request after the authorization carries the token. Server: a request without a token gets 401." },
        .{ .id = "basic/authorization#042-5545d0", .tests = .{ "src/mcp/spec_test/authorization_test.zig:oauth client sends the token in the authorization header of every request and never in the query", "src/mcp/spec_test/authorization_test.zig:http server does not accept an access token in the query string" }, .note = "Client: no token in any request target. Server: a token in the query is ignored." },
        .{ .id = "basic/authorization#043-ddbb48", .tests = .{ "src/mcp/auth/resource_server.zig:challenges and decisions", "src/mcp/auth/jwt.zig:hs256 round trip and claims", "src/mcp/auth/jwt.zig:es256 verification", "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal" } },
        .{ .id = "basic/authorization#044-ffdbb4", .tests = .{ "src/mcp/auth/resource_server.zig:challenges and decisions", "src/mcp/auth/jwt.zig:hs256 round trip and claims" }, .note = "A token for another audience gets 401." },
        .{ .id = "basic/authorization#045-b31c92", .tests = .{ "src/mcp/auth/resource_server.zig:challenges and decisions", "src/mcp/spec_test/authorization_test.zig:resource server challenges insufficient scope with 403 and all required scopes at once" } },
