        .{ .id = "basic/authorization/security-considerations#031-625008", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:http server rejects tokens for another audience or without an audience before the handler runs", "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal" }, .note = "The HTTP server checks the token before it reads the body and returns no result." },
        .{ .id = "basic/authorization/security-considerations#032-b5ded2", .tests = .{ "src/mcp/auth/jwt.zig:hs256 round trip and claims", "src/mcp/auth/jwt.zig:es256 verification", "src/mcp/auth/resource_server.zig:challenges and decisions" }, .note = "Signature, algorithm, expiry, issuer and audience checks." },
        .{ .id = "basic/authorization/security-considerations#033-2b577b", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:http server rejects tokens for another audience or without an audience before the handler runs", "src/mcp/auth/resource_server.zig:challenges and decisions", "src/mcp/auth/jwt.zig:hs256 round trip and claims" }, .note = "The audience check needs JwtVerifier options.audience. Null skips it." },
        .{ .id = "basic/authorization/security-considerations#034-2a5363", .status = .app, .reason = "The SDK never forwards the token and Principal carries no raw token. Calls to other services are handler code." },
        .{ .id = "basic/authorization/security-considerations#035-655246", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:client sends the resource parameter and an S256 PKCE challenge in authorization and token requests", "conformance:client/auth/token-endpoint-auth-basic", "conformance:client/auth/token-endpoint-auth-post", "conformance:client/auth/token-endpoint-auth-none" }, .note = "The harness checks resource-parameter-valid-uri and resource-parameter-consistency." },
        .{ .id = "basic#001-a0816e", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/server/server_test.zig:subscriptions listen stream", "src/mcp/client/client_test.zig:multi round-trip requests are driven by the hooks" }, .note = "Umbrella requirement. The detailed rules of the base, versioning and pattern pages have their own ids." },
        .{ .id = "basic#002-fcc424", .status = .na, .reason = "Permission only. It names no behaviour to check." },
        .{ .id = "basic#003-9774fb", .tests = .{ "src/mcp/jsonrpc/message.zig:parse request, notification, response, error", "src/mcp/jsonrpc/message.zig:write error response with null id", "src/mcp/spec_test/base_protocol_test.zig:every result of the server is a JSON-RPC 2.0 result object with a resultType", "src/mcp/spec_test/base_protocol_test.zig:stdio server answers a parse error with -32700 and a null id" } },
        .{ .id = "basic#004-bdbccc", .tests = .{ "src/mcp/jsonrpc/id.zig:request id parse and print", "src/mcp/jsonrpc/message.zig:parse request, notification, response, error", "src/mcp/spec_test/base_protocol_test.zig:stdio server rejects a request id that is null or not an integer", "src/mcp/spec_test/base_protocol_test.zig:client request ids are unique and carry the required _meta fields" } },
        .{ .id = "basic#005-69460b", .tests = .{ "src/mcp/jsonrpc/message.zig:parse request, notification, response, error", "src/mcp/jsonrpc/id.zig:request id parse and print", "src/mcp/spec_test/base_protocol_test.zig:stdio server rejects a request id that is null or not an integer" } },
        .{ .id = "basic#006-d3a20c", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:client request ids are unique and carry the required _meta fields", "src/mcp/spec_test/base_protocol_test.zig:client retries once when the server lists its version and fails otherwise", "conformance:client/sep-2322-client-request-state" }, .note = "The client takes ids from one atomic counter. Retries get new ids." },
        .{ .id = "basic#007-e767e5", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:a result response echoes a string or an integer request id", "src/mcp/spec_test/base_protocol_test.zig:stdio server echoes each request id and sends nothing for notifications" } },
        .{ .id = "basic#008-0c3e2c", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:every result of the server is a JSON-RPC 2.0 result object with a resultType", "src/mcp/spec_test/base_protocol_test.zig:a result response echoes a string or an integer request id" } },
        .{ .id = "basic#009-3dada6", .status = .na, .reason = "Permission only. The SDK parses each result into the result type of its method." },
        .{ .id = "basic#010-f96ef0", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:every result of the server is a JSON-RPC 2.0 result object with a resultType", "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "conformance:server/input-required-result-result-type" } },
        .{ .id = "basic#011-ec6f50", .status = .na, .reason = "Permission for extensions. The Tasks extension adds the task result type. See basic#012." },
        .{ .id = "basic#012-f2831f", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:client accepts the task result type only for a declared extension", "src/mcp/server/server_test.zig:tasks extension: gate, sync fallback and lifecycle" }, .note = "The task result type is valid only for tools/call when the client declared the Tasks extension." },
        .{ .id = "basic#013-321463", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:client rejects a result with an unknown resultType"} },
        .{ .id = "basic#014-4c9652", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:client treats a result without resultType as complete"} },
        .{ .id = "basic#015-448dd0", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:error responses echo the id and carry an integer code and a string message", "src/mcp/spec_test/base_protocol_test.zig:stdio server answers a parse error with -32700 and a null id", "src/mcp/spec_test/base_protocol_test.zig:stdio server rejects a request id that is null or not an integer", "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" }, .note = "The HTTP transport sends a null id for an invalid request even when the id is readable." },
        .{ .id = "basic#016-b9a325", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:error responses echo the id and carry an integer code and a string message"} },
        .{ .id = "basic#017-a2dc63", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:error responses echo the id and carry an integer code and a string message"}, .note = "The server sends integer codes. The parser rejects a code that is not an integer." },
        .{ .id = "basic#018-312208", .tests = .{ "src/mcp/protocol/errors.zig:unsupported protocol version error shape", "src/mcp/spec_test/base_protocol_test.zig:client surfaces legacy and implementation-defined error codes as errors" }, .note = "The server sends data on -32022. The client keeps the data it receives." },
        .{ .id = "basic#019-b8ef1f", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:no error code of the SDK is in the legacy sub-range"}, .note = "The SDK defines no code in this sub-range." },
        .{ .id = "basic#020-c3e6cc", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:client surfaces legacy and implementation-defined error codes as errors"}, .note = "The client returns -32001 and -32002 as plain errors with no special handling." },
        .{ .id = "basic#021-41c1d6", .tests = .{ "src/mcp/protocol/errors.zig:emittable codes", "src/mcp/spec_test/base_protocol_test.zig:no error code of the SDK is in the legacy sub-range" }, .note = "Checks the predicate. Server.sendError only asserts it, so a release build sends a handler code without a check." },
        .{ .id = "basic#022-5fe4ec", .tests = .{ "src/mcp/server/server_test.zig:resources, templates, prompts, completion", "src/mcp/protocol/errors.zig:emittable codes", "conformance:server/sep-2164-resource-not-found" } },
        .{ .id = "basic#023-96e2d9", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:client surfaces legacy and implementation-defined error codes as errors"} },
        .{ .id = "basic#024-f56c3a", .tests = .{"src/mcp/protocol/errors.zig:emittable codes"}, .note = "No code path sends -32042. URL elicitation uses input requests." },
        .{ .id = "basic#025-18b8d7", .status = .app, .reason = "The handler author picks application error codes. The SDK allocates no new codes." },
        .{ .id = "basic#026-405883", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:the server sends no response to a notification", "src/mcp/spec_test/base_protocol_test.zig:stdio server echoes each request id and sends nothing for notifications", "src/mcp/transport/http_test.zig:http ladder and json responses" }, .note = "On HTTP a notification gets 202 with no body." },
        .{ .id = "basic#027-c3b3f8", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:notifications from the server carry no id", "src/mcp/jsonrpc/message.zig:parse request, notification, response, error" } },
        .{ .id = "basic#028-0705ef", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:the server takes capabilities from each request and not from the connection", "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:server/server-stateless" } },
        .{ .id = "basic#029-e542f6", .tests = .{"conformance:server/server-sse-multiple-streams"}, .note = "Concurrent requests on separate streams. The stdio transport also runs requests concurrently." },
        .{ .id = "basic#030-f10aa0", .tests = .{ "conformance:server/server-stateless", "conformance:server/input-required-result-multi-round" }, .note = "Each request is a separate HTTP POST. Round state travels in requestState." },
        .{ .id = "basic#031-698d0a", .status = .app, .reason = "The host decides the process lifetime. The SDK gives stdio.Client.spawn and deinit, and one process serves many requests." },
        .{ .id = "basic#032-88b3c1", .tests = .{ "conformance:client/sep-2322-client-request-state", "src/mcp/client/client_test.zig:tasks are awaited and their input requests answered" }, .note = "The client echoes requestState and sends the taskId on each task request." },
        .{ .id = "basic#033-44fc33", .tests = .{ "src/mcp/transport/http_auth_test.zig:resource server: metadata, challenges and the principal", "conformance:client/auth/metadata-default" }, .note = "HTTP part. The stdio transport has no authorization, so stdio credentials come from the environment." },
        .{ .id = "basic#034-ebf9e8", .status = .na, .reason = "Permission only. The SDK has no custom authentication negotiation." },
        .{ .id = "basic#035-c2e6b5", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:tool registration checks the schema dialect and the schema", "src/mcp/schema/validator.zig:logic, conditionals and references" }, .note = "An explicit 2020-12 $schema is accepted." },
        .{ .id = "basic#036-d5aeb2", .status = .gap, .reason = "Partial. The validator supports a subset of 2020-12 and rejects pattern, patternProperties, unevaluated keywords and dynamic references at registration.", .tests = .{ "src/mcp/schema/validator.zig:type, enum and const", "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas" } },
        .{ .id = "basic#037-caaa47", .tests = .{"src/mcp/schema/derive.zig:derive schema for a struct"}, .note = "Derived schemas have no $schema, so they use 2020-12." },
        .{ .id = "basic#038-396de4", .tests = .{ "src/mcp/schema/validator.zig:type, enum and const", "src/mcp/schema/validator.zig:logic, conditionals and references" }, .note = "Schemas without $schema are validated as 2020-12, within the supported subset. See basic#036." },
        .{ .id = "basic#039-eac9c7", .tests = .{ "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas", "src/mcp/spec_test/base_protocol_test.zig:tool registration checks the schema dialect and the schema" } },
        .{ .id = "basic#040-3672ea", .tests = .{ "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas", "src/mcp/spec_test/base_protocol_test.zig:tool registration checks the schema dialect and the schema" }, .note = "Registration returns error.UnsupportedDialect." },
        .{ .id = "basic#041-abc112", .status = .na, .reason = "Documentation duty with no test. The README and the validator doc comment name the 2020-12 subset." },
        .{ .id = "basic#042-b42c05", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:tool registration checks the schema dialect and the schema", "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas" } },
        .{ .id = "basic#043-6d081f", .tests = .{ "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas", "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "conformance:client/json-schema-ref-no-deref" } },
        .{ .id = "basic#044-c9e4e3", .status = .na, .reason = "The SDK has no mode that fetches remote references. The validator always rejects them." },
        .{ .id = "basic#045-d4d646", .tests = .{ "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas", "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output" } },
        .{ .id = "basic#046-64ac13", .tests = .{ "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas", "src/mcp/schema/validator.zig:failure report and evaluation limits" }, .note = "Depth, subschema count, reference hops and an evaluation budget." },
        .{ .id = "basic#047-ec91ba", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:a request with a missing or malformed required _meta field is rejected with -32602", "src/mcp/protocol/meta.zig:lift envelope" }, .note = "The server checks the type of each reserved value before use." },
        .{ .id = "basic#048-6982ac", .tests = .{ "src/mcp/protocol/meta.zig:meta key grammar", "src/mcp/spec_test/base_protocol_test.zig:meta key labels and names follow the grammar" }, .note = "The helper protocol.meta.validateKey checks the grammar. The SDK does not apply it to received keys." },
        .{ .id = "basic#049-c3a0e7", .tests = .{ "src/mcp/protocol/meta.zig:meta key grammar", "src/mcp/spec_test/base_protocol_test.zig:meta key labels and names follow the grammar" } },
        .{ .id = "basic#050-2b8069", .status = .app, .reason = "The application names its own keys. The SDK keys use the io.modelcontextprotocol/ prefix." },
        .{ .id = "basic#051-ca10c6", .tests = .{ "src/mcp/protocol/meta.zig:meta key grammar", "src/mcp/spec_test/base_protocol_test.zig:meta key labels and names follow the grammar" }, .note = "validateKey also rejects an empty name, which the text permits." },
        .{ .id = "basic#052-fb7b59", .tests = .{ "src/mcp/protocol/meta.zig:meta key grammar", "src/mcp/spec_test/base_protocol_test.zig:meta key labels and names follow the grammar" } },
        .{ .id = "basic#053-3b953b", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:client request ids are unique and carry the required _meta fields", "conformance:client/request-metadata" } },
        .{ .id = "basic#054-289424", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:a request with a missing or malformed required _meta field is rejected with -32602", "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:server/server-stateless" } },
        .{ .id = "basic#055-263eff", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" } },
        .{ .id = "basic#056-b03baa", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:client request ids are unique and carry the required _meta fields", "conformance:client/request-metadata" }, .note = "The client always sends clientInfo. It has no option to leave it out." },
        .{ .id = "basic#057-7063c4", .tests = .{ "src/mcp/server/server_test.zig:tools list and call", "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/base_protocol_test.zig:the server takes capabilities from each request and not from the connection", "conformance:server/server-stateless", "conformance:server/input-required-result-capability-check" } },
        .{ .id = "basic#058-24204d", .tests = .{ "src/mcp/server/server_test.zig:tools list and call", "src/mcp/spec_test/base_protocol_test.zig:the server takes capabilities from each request and not from the connection", "conformance:server/server-stateless" } },
        .{ .id = "basic#059-263eff", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:http server answers a missing client capability with 400 and -32021", "conformance:server/server-stateless" } },
        .{ .id = "basic#060-0d96e2", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:every result of the server names the server in _meta", "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:server/server-stateless" }, .note = "The server stamps serverInfo on every result. It has no option to leave it out." },
        .{ .id = "basic#061-d9f747", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:clientInfo does not change the response of the server"}, .note = "Server part. The client never reads serverInfo. Security decisions in handlers belong to the application." },
        .{ .id = "basic#062-f00762", .tests = .{ "src/mcp/server/server_test.zig:subscriptions listen stream", "conformance:server/server-stateless" } },
        .{ .id = "basic#063-5d80d8", .status = .na, .reason = "The SDK does not produce or read trace context keys. The client replaces the params _meta object with its own keys." },
        .{ .id = "basic#064-1c1aaf", .status = .app, .reason = "The host renders icons. The SDK passes icon metadata through and renders nothing." },
        .{ .id = "basic#065-1b3064", .status = .app, .reason = "The host renders icons. The SDK passes icon metadata through and renders nothing." },
        .{ .id = "basic#066-7bedbf", .status = .app, .reason = "The host renders icons. The SDK passes icon metadata through and renders nothing." },
        .{ .id = "basic#067-30920b", .status = .app, .reason = "The host renders icons. The SDK passes icon metadata through and renders nothing." },
        .{ .id = "basic#068-1f9bd0", .status = .app, .reason = "The host consumes icons. The SDK never fetches or decodes icon URIs or bytes." },
        .{ .id = "basic#069-b1629f", .status = .app, .reason = "The host checks the icon URI scheme before a fetch. The SDK never fetches icon URIs." },
        .{ .id = "basic#070-8d84c6", .status = .app, .reason = "The host rejects unsafe icon schemes and redirects. The SDK client passes icon metadata through unchanged." },
        .{ .id = "basic#071-893be4", .status = .app, .reason = "The host controls icon fetches and redirects. The SDK never fetches icon URIs." },
        .{ .id = "basic#072-c4f8d3", .status = .app, .reason = "The host decodes icon images. The SDK never decodes icon bytes." },
        .{ .id = "basic#073-ce40c1", .status = .app, .reason = "The host sets image size limits. The SDK never fetches icons." },
        .{ .id = "basic#074-5ecfe2", .status = .app, .reason = "The host fetches icons without credentials. The SDK never fetches icon URIs." },
        .{ .id = "basic#075-5698de", .status = .app, .reason = "The host compares the icon origin with the server origin. The SDK never fetches icon URIs." },
        .{ .id = "basic#076-2e0da4", .status = .app, .reason = "The host renders icons and handles executable content. The SDK renders nothing." },
        .{ .id = "basic#077-8b74f1", .status = .app, .reason = "The host filters or sanitizes icon files. The SDK never handles icon bytes." },
        .{ .id = "basic#078-8e73cf", .status = .app, .reason = "The host checks MIME types and magic bytes before it renders. The SDK never handles icon bytes." },
        .{ .id = "basic#079-0fb934", .status = .app, .reason = "The host keeps the allowlist of image types. The SDK never handles icon bytes." },
        .{ .id = "basic/patterns/cancellation#001-981e1d", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart"}, .note = "On stdio a fired cancel token makes the client send notifications/cancelled. On HTTP the client closes the stream." },
        .{ .id = "basic/patterns/cancellation#002-e315cd", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled", "src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart" }, .note = "Only the stdio server sends it. The HTTP server ends the stream after the listen result." },
        .{ .id = "basic/patterns/cancellation#003-68c7d9", .status = .gap, .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled"}, .reason = "The normal path is tested. A client cancellation with the reason text server shutdown makes the stdio server send notifications/cancelled for any request." },
        .{ .id = "basic/patterns/cancellation#004-0ab0e3", .status = .gap, .tests = .{"src/mcp/spec_test/patterns_test.zig:http server stops a handler that writes after the client disconnects"}, .reason = "The HTTP server never fires the cancel token on disconnect. A handler sees the disconnect only at its next write, and an idle listen stream stays open." },
        .{ .id = "basic/patterns/cancellation#005-e1786e", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart"}, .note = "At shutdown the server process names only the stream that the client did not cancel." },
        .{ .id = "basic/patterns/cancellation#006-ed6274", .status = .app, .reason = "The caller sets RequestOptions.timeout for each request. The SDK sets no default timeout." },
        .{ .id = "basic/patterns/cancellation#007-6ae573", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart", "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr" }, .note = "A timeout returns error.Timeout. On stdio it also sends notifications/cancelled." },
        .{ .id = "basic/patterns/cancellation#008-6a2cad", .tests = .{ "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr", "src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart" }, .note = "RequestOptions.timeout is set for each request." },
        .{ .id = "basic/patterns/cancellation#009-d579ef", .status = .na, .reason = "Optional behaviour that the SDK does not implement. Progress does not reset the timeout." },
        .{ .id = "basic/patterns/cancellation#010-6c2d1f", .status = .gap, .reason = "The client has no maximum timeout. A request without RequestOptions.timeout waits without limit." },
        .{ .id = "basic/patterns/cancellation#011-182b4a", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart"}, .note = "The client cancels only the id of its own exchange." },
        .{ .id = "basic/patterns/cancellation#012-3d7581", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart"}, .note = "The client sends the notification only while the exchange waits for the response." },
        .{ .id = "basic/patterns/cancellation#013-175e99", .status = .gap, .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled", "src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart" }, .reason = "Listen teardown is tested. A client cancellation with the reason text server shutdown makes the stdio server name a request that is not a listen request." },
        .{ .id = "basic/patterns/cancellation#014-4ed9b5", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations", "src/mcp/server/server_test.zig:client-cancelled listen stream gets no response" } },
        .{ .id = "basic/patterns/cancellation#015-23e438", .tests = .{ "src/mcp/spec_test/patterns_test.zig:a client-cancelled listen stream frees its subscription and gets no response", "src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations" }, .note = "The subscription and the request slot are freed. The testing allocator finds no leak." },
        .{ .id = "basic/patterns/cancellation#016-291f6c", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations", "src/mcp/server/server_test.zig:client-cancelled listen stream gets no response" } },
        .{ .id = "basic/patterns/cancellation#017-ad3fdd", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations"} },
        .{ .id = "basic/patterns/cancellation#018-347ba0", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations"} },
        .{ .id = "basic/patterns/cancellation#019-4ca65a", .status = .app, .reason = "The handler decides. A handler that never calls RequestContext.checkCancel runs to completion." },
        .{ .id = "basic/patterns/cancellation#020-5bebb3", .tests = .{"src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs"}, .note = "The client drops a response whose id is not the id of its request." },
        .{ .id = "basic/patterns/cancellation#021-e99327", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations", "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs" }, .note = "A late cancellation and a late response are both ignored." },
        .{ .id = "basic/patterns/cancellation#022-b6fd44", .status = .gap, .reason = "The SDK keeps the reason in CancelToken.reason but does not log it. No test." },
        .{ .id = "basic/patterns/cancellation#023-ed85f7", .status = .app, .reason = "The host UI shows that a cancellation is in progress." },
        .{ .id = "basic/patterns/cancellation#024-d5a342", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations", "src/mcp/transport/http_test.zig:http ladder and json responses" }, .note = "On HTTP the notification gets 202 and has no effect." },
        .{ .id = "basic/patterns/cancellation#025-ee37db", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations"} },
        .{ .id = "basic/patterns/cancellation#026-a4b7f4", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio server stops a cancelled request and ignores invalid cancellations"}, .note = "Missing params, missing requestId and an object id." },
        .{ .id = "basic/patterns#001-3fbe8c", .tests = .{ "src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled", "src/mcp/spec_test/patterns_test.zig:client rejects server requests and input required results on other methods" }, .note = "No server frame has both a method and an id. The client rejects a server request." },
        .{ .id = "basic/patterns#002-78811a", .tests = .{ "src/mcp/server/server_test.zig:tools list and call", "src/mcp/transport/http_test.zig:http sse response with progress notifications", "conformance:server/tools-call-with-progress" } },
        .{ .id = "basic/patterns/mrtr#001-36268d", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "conformance:server/input-required-result-basic-elicitation", "conformance:server/input-required-result-basic-sampling", "conformance:server/input-required-result-basic-list-roots" } },
        .{ .id = "basic/patterns/mrtr#002-8d5f8f", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs", "conformance:client/request-metadata" }, .note = "The server rejects a request without _meta. The client adds it to every round." },
        .{ .id = "basic/patterns/mrtr#003-076bfd", .tests = .{ "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs", "conformance:client/sep-2322-client-request-state" }, .note = "The client echoes a state that is not JSON without change." },
        .{ .id = "basic/patterns/mrtr#004-776661", .tests = .{ "src/mcp/spec_test/patterns_test.zig:input required results are allowed on tools/call, resources/read and prompts/get", "conformance:server/input-required-result-non-tool-request" } },
        .{ .id = "basic/patterns/mrtr#005-0d27b8", .tests = .{ "conformance:server/input-required-result-unsupported-methods", "src/mcp/spec_test/patterns_test.zig:client rejects server requests and input required results on other methods" }, .note = "Only tool, resource and prompt handlers can return input_required. The client also rejects it on other methods." },
        .{ .id = "basic/patterns/mrtr#006-79b14e", .tests = .{ "src/mcp/spec_test/patterns_test.zig:input required results are allowed on tools/call, resources/read and prompts/get", "src/mcp/server/server_test.zig:multi round-trip request with sealed state" } },
        .{ .id = "basic/patterns/mrtr#007-eb57e3", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/patterns_test.zig:input required results are allowed on tools/call, resources/read and prompts/get" } },
        .{ .id = "basic/patterns/mrtr#008-92a682", .tests = .{"src/mcp/server/mrtr.zig:input required builder"}, .note = "A second request with the same key fails with error.DuplicateKey." },
        .{ .id = "basic/patterns/mrtr#009-1df6c7", .tests = .{ "src/mcp/server/mrtr.zig:input required builder", "src/mcp/spec_test/patterns_test.zig:input requests need the client capability for their kind" }, .note = "InputRequest is a union of the three request kinds." },
        .{ .id = "basic/patterns/mrtr#010-c2e08b", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "conformance:server/input-required-result-request-state" } },
        .{ .id = "basic/patterns/mrtr#011-ed5a86", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/patterns_test.zig:sealed request state is bound to the tool that issued it and expires", "conformance:server/input-required-result-tampered-state" } },
        .{ .id = "basic/patterns/mrtr#012-07c2aa", .tests = .{ "src/mcp/server/request_state.zig:seal and unseal", "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/patterns_test.zig:sealed request state is bound to the tool that issued it and expires", "conformance:server/input-required-result-tampered-state" }, .note = "AES-GCM sealing by default. Tampered, forged and foreign state gets -32602." },
        .{ .id = "basic/patterns/mrtr#013-37a215", .status = .app, .reason = "The server author chooses Server.Options.request_state. The default seals the state." },
        .{ .id = "basic/patterns/mrtr#014-e965bb", .status = .gap, .reason = "The server passes an empty principal to the associated data. The sealed state does not identify the authenticated principal." },
        .{ .id = "basic/patterns/mrtr#015-3c0b5e", .tests = .{ "src/mcp/server/request_state.zig:seal and unseal", "src/mcp/spec_test/patterns_test.zig:sealed request state is bound to the tool that issued it and expires" }, .note = "Limits.request_state_ttl sets the expiry." },
        .{ .id = "basic/patterns/mrtr#016-3d172b", .tests = .{ "src/mcp/server/request_state.zig:seal and unseal", "src/mcp/spec_test/patterns_test.zig:sealed request state is bound to the tool that issued it and expires" }, .note = "The state binds the method and the tool name or URI. It does not bind the arguments." },
        .{ .id = "basic/patterns/mrtr#017-c3efe6", .status = .app, .reason = "The server author enforces single use. The SDK has no store of consumed state." },
        .{ .id = "basic/patterns/mrtr#018-de5c1f", .tests = .{"src/mcp/spec_test/patterns_test.zig:an input required result without input requests or request state is an internal error"} },
        .{ .id = "basic/patterns/mrtr#019-e4a607", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/patterns_test.zig:input requests need the client capability for their kind", "conformance:server/input-required-result-capability-check" }, .note = "The engine answers -32021 instead of an undeclared input request." },
        .{ .id = "basic/patterns/mrtr#020-ef8b4b", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/patterns_test.zig:input requests need the client capability for their kind" } },
        .{ .id = "basic/patterns/mrtr#021-a2e60d", .status = .app, .reason = "The handler decides what a retry needs. The SDK keeps no server-side state between rounds." },
        .{ .id = "basic/patterns/mrtr#022-01e395", .tests = .{"conformance:server/input-required-result-multi-round"} },
        .{ .id = "basic/patterns/mrtr#023-e3881d", .tests = .{ "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs", "src/mcp/client/client_test.zig:multi round-trip requests are driven by the hooks" }, .note = "The hook runs before the retry goes out." },
        .{ .id = "basic/patterns/mrtr#024-68a9f1", .tests = .{"src/mcp/spec_test/patterns_test.zig:client retries at once when the server sent only request state"} },
        .{ .id = "basic/patterns/mrtr#025-0387ee", .tests = .{ "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs", "conformance:client/sep-2322-client-request-state" } },
        .{ .id = "basic/patterns/mrtr#026-c4c4c8", .tests = .{ "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs", "conformance:client/sep-2322-client-request-state" }, .note = "The client echoes a state that is not JSON without change." },
        .{ .id = "basic/patterns/mrtr#027-11edf5", .tests = .{ "src/mcp/spec_test/patterns_test.zig:client omits requestState on the retry when the server sent none", "conformance:client/sep-2322-client-request-state" } },
        .{ .id = "basic/patterns/mrtr#028-cbc1a1", .tests = .{ "src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs", "conformance:client/sep-2322-client-request-state" } },
        .{ .id = "basic/patterns/mrtr#029-a496bd", .tests = .{"conformance:client/sep-2322-client-request-state"}, .note = "Check sep-2322-client-parallel-isolation." },
        .{ .id = "basic/patterns/mrtr#030-7438ff", .tests = .{ "src/mcp/spec_test/patterns_test.zig:input responses are validated and unknown keys are ignored", "conformance:server/input-required-result-validate-input" } },
        .{ .id = "basic/patterns/mrtr#031-2e3e18", .tests = .{ "src/mcp/spec_test/patterns_test.zig:input responses are validated and unknown keys are ignored", "conformance:server/input-required-result-validate-input" }, .note = "A response of the wrong shape gets -32602." },
        .{ .id = "basic/patterns/mrtr#032-7eba24", .tests = .{ "src/mcp/spec_test/patterns_test.zig:input responses are validated and unknown keys are ignored", "conformance:server/input-required-result-ignore-extra-params" } },
        .{ .id = "basic/patterns/mrtr#033-d7b255", .status = .app, .reason = "The handler asks again. RequestContext.elicitResponse returns null for a missing key." },
        .{ .id = "basic/patterns/mrtr#034-348ddb", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "src/mcp/spec_test/patterns_test.zig:sealed request state is bound to the tool that issued it and expires", "conformance:server/input-required-result-tampered-state" } },
        .{ .id = "basic/patterns/progress#001-581e56", .tests = .{ "src/mcp/server/server_test.zig:tools list and call", "src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message", "conformance:server/tools-call-with-progress" } },
        .{ .id = "basic/patterns/progress#002-0588cd", .tests = .{"src/mcp/spec_test/patterns_test.zig:progress needs a progress token of string or integer type"}, .note = "The server rejects other token types with -32602." },
        .{ .id = "basic/patterns/progress#003-4f3336", .tests = .{"src/mcp/spec_test/patterns_test.zig:client retries an input required result with a new id, the exact state and the constructed inputs"}, .note = "The client uses the unique request id as the token." },
        .{ .id = "basic/patterns/progress#004-316a29", .tests = .{ "src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message", "conformance:server/tools-call-with-progress" } },
        .{ .id = "basic/patterns/progress#005-2d6065", .tests = .{ "src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message", "conformance:server/tools-call-with-progress" } },
        .{ .id = "basic/patterns/progress#006-a05257", .tests = .{"src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message"} },
        .{ .id = "basic/patterns/progress#007-602c1f", .tests = .{"src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message"} },
        .{ .id = "basic/patterns/progress#008-264e7a", .status = .app, .reason = "The handler supplies the values. The SDK does not check that they increase." },
        .{ .id = "basic/patterns/progress#009-4a9676", .tests = .{"src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message"} },
        .{ .id = "basic/patterns/progress#010-fe9485", .status = .app, .reason = "The handler writes the message text. The SDK gives the note argument of RequestContext.progress." },
        .{ .id = "basic/patterns/progress#011-e3b94f", .tests = .{"src/mcp/spec_test/patterns_test.zig:progress needs a progress token of string or integer type"}, .note = "Without a token RequestContext.progress sends nothing." },
        .{ .id = "basic/patterns/progress#012-f677a9", .tests = .{ "src/mcp/server/server_test.zig:tools list and call", "src/mcp/transport/http_test.zig:http sse response with progress notifications", "src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message" }, .note = "Progress goes out only while the handler runs, before the response." },
        .{ .id = "basic/patterns/progress#013-6806e8", .status = .app, .reason = "The handler decides whether it calls RequestContext.progress." },
        .{ .id = "basic/patterns/progress#014-920cd5", .status = .app, .reason = "The handler decides the frequency. The SDK caps the count for each request." },
        .{ .id = "basic/patterns/progress#015-90a1c4", .tests = .{"src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message"} },
        .{ .id = "basic/patterns/progress#016-f704ba", .status = .gap, .reason = "The server keeps the token for each request and the stdio client routes progress by token. No test with concurrent requests." },
        .{ .id = "basic/patterns/progress#017-c4d3c9", .status = .gap, .tests = .{"src/mcp/spec_test/patterns_test.zig:progress notifications of one request are capped"}, .reason = "The server caps the count for each request, not the rate. The client does not limit incoming notifications." },
        .{ .id = "basic/patterns/progress#018-458723", .tests = .{ "src/mcp/transport/http_test.zig:http sse response with progress notifications", "src/mcp/server/server_test.zig:tools list and call", "src/mcp/spec_test/patterns_test.zig:progress notifications carry the token, the value, an optional total and an optional message" }, .note = "The response is the last frame of the request stream." },
        .{ .id = "basic/patterns/subscriptions#001-31f5dc", .tests = .{ "src/mcp/server/server_test.zig:subscriptions listen stream", "src/mcp/spec_test/patterns_test.zig:a client-cancelled listen stream frees its subscription and gets no response" }, .note = "A prompts change does not reach a tools-only subscription." },
        .{ .id = "basic/patterns/subscriptions#002-ba33b0", .tests = .{ "src/mcp/server/server_test.zig:subscriptions listen stream", "src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled" } },
        .{ .id = "basic/patterns/subscriptions#003-f96346", .status = .na, .reason = "A permission that relaxes the ordering of basic/patterns/subscriptions#002 on stdio. It puts no duty on the SDK." },
        .{ .id = "basic/patterns/subscriptions#004-1a6d46", .status = .app, .reason = "The application compares the filters. It gets the acknowledgement through RequestOptions.on_notification." },
        .{ .id = "basic/patterns/subscriptions#005-5d0dfb", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart"}, .note = "Each concurrent listen stream gets only the acknowledgement with its own subscription id." },
        .{ .id = "basic/patterns/subscriptions#006-32c573", .tests = .{"src/mcp/spec_test/patterns_test.zig:stdio client cancels requests with notifications/cancelled and keeps listen streams apart"} },
        .{ .id = "basic/patterns/subscriptions#007-0c5b5f", .tests = .{ "src/mcp/server/server_test.zig:subscriptions listen stream", "src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled" } },
        .{ .id = "basic/patterns/subscriptions#008-fd9c08", .tests = .{ "src/mcp/server/server_test.zig:subscriptions listen stream", "src/mcp/spec_test/patterns_test.zig:stdio server ends a listen stream with a result and then notifications/cancelled" } },
        .{ .id = "basic/patterns/subscriptions#009-0d786c", .status = .app, .reason = "The application decides to reconnect. Client.listen returns the result on a graceful end and an error on a drop." },
        .{ .id = "basic/patterns/subscriptions#010-5451d2", .status = .app, .reason = "The application calls Client.listen again after a reconnect. RequestOptions.retry set to force re-issues it." },
        .{ .id = "basic/transports#001-41e2a7", .tests = .{ "src/mcp/spec_test/transports_test.zig:stdio server writes one valid JSON-RPC message per line and never a request", "src/mcp/spec_test/transports_test.zig:streamable http server answers notifications with 202 and rejects bodies it cannot accept", "src/mcp/util/line_framer.zig:framer rejects invalid UTF-8" }, .note = "Input that is not UTF-8 is a parse error on stdio and HTTP. Every output line is valid UTF-8." },
        .{ .id = "basic/transports#002-3b4ee2", .tests = .{ "src/mcp/client/client_test.zig:stdio client drives the example server process", "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr", "src/grpc/grpc_test.zig:grpc: discover, tools, progress, header mirroring, mrtr and errors" }, .note = "Requests reach the server and responses and progress notifications reach the client on stdio, HTTP and gRPC." },
        .{ .id = "basic/transports#003-02b9f4", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr", "src/grpc/grpc_test.zig:grpc: discover, tools, progress, header mirroring, mrtr and errors" }, .note = "HTTP headers and gRPC metadata mirror body fields." },
        .{ .id = "basic/transports#004-8207a0", .tests = .{ "src/grpc/grpc_test.zig:grpc: discover, tools, progress, header mirroring, mrtr and errors", "src/grpc/grpc_test.zig:grpc: a listen stream delivers events until the client cancels" }, .note = "The gRPC transport is the custom transport of the SDK." },
        .{ .id = "basic/transports#005-ca7691", .tests = .{ "src/grpc/grpc_test.zig:grpc: discover, tools, progress, header mirroring, mrtr and errors", "src/grpc/grpc_test.zig:grpc: a listen stream delivers events until the client cancels", "src/grpc/grpc_test.zig:grpc: unknown path, wrong content type and missing metadata" }, .note = "JSON-RPC messages with _meta, progress, MRTR, listen streams and errors travel unchanged over gRPC." },
        .{ .id = "basic/transports#006-8728f0", .status = .na, .reason = "A documentation duty that no test can check. The files proto/README.md and proto/mcp_zig_transport_v1.proto describe the gRPC binding." },
        .{ .id = "basic/transports#007-c2495c", .status = .app, .reason = "The SDK has no custom transport over a raw byte stream. An application that builds one can use mcp.util.line_framer, the stdio framing." },
        .{ .id = "basic/transports/stdio#001-126d73", .tests = .{ "src/mcp/spec_test/transports_test.zig:stdio server writes one valid JSON-RPC message per line and never a request", "src/mcp/spec_test/transports_test.zig:stdio client writes only requests and notifications, one per line, and cancels with a notification" }, .note = "Server output and client output have one message per line. Newlines in text travel escaped." },
        .{ .id = "basic/transports/stdio#002-726d27", .status = .na, .reason = "A permission. The SDK logs with std.log, which writes to stderr and never to stdout." },
        .{ .id = "basic/transports/stdio#003-7a9585", .status = .app, .reason = "The stdio client passes the server stderr to the stderr of the host and never reads it. The host decides what to do with it." },
        .{ .id = "basic/transports/stdio#004-3e92e3", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio server writes one valid JSON-RPC message per line and never a request"} },
        .{ .id = "basic/transports/stdio#005-516513", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio client writes only requests and notifications, one per line, and cancels with a notification"}, .note = "A child process records the stdin of the client. Every line parses as a JSON-RPC message." },
        .{ .id = "basic/transports/stdio#006-df4ce8", .status = .app, .reason = "The SDK has no custom transport over a byte stream. An application that builds one can use mcp.util.line_framer, the stdio framing." },
        .{ .id = "basic/transports/stdio#007-e6b9be", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio client writes only requests and notifications, one per line, and cancels with a notification"} },
        .{ .id = "basic/transports/stdio#008-d83625", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio client routes listen notifications to their request by the subscription id"} },
        .{ .id = "basic/transports/stdio#009-3de50c", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio server writes one valid JSON-RPC message per line and never a request"}, .note = "A tool that needs input returns an InputRequiredResult. No request line appears." },
        .{ .id = "basic/transports/stdio#010-5e8ca7", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio client writes only requests and notifications, one per line, and cancels with a notification"}, .note = "Checks a cancelled request and a request that timed out." },
        .{ .id = "basic/transports/stdio#011-316c14", .status = .gap, .reason = "Partial. A handler that stops sends nothing. The stdio server still writes the response of a handler that ignores the cancellation.", .tests = .{ "src/mcp/spec_test/transports_test.zig:stdio server sends nothing more for a request that the client cancelled", "src/mcp/server/server_test.zig:client-cancelled listen stream gets no response" } },
        .{ .id = "basic/transports/stdio#012-4d070c", .tests = .{ "src/mcp/spec_test/transports_test.zig:stdio client writes only requests and notifications, one per line, and cancels with a notification", "src/mcp/spec_test/transports_test.zig:stdio client close lets the server exit at the end of its input" }, .note = "The child exits before the grace period because close ends its input." },
        .{ .id = "basic/transports/stdio#013-4c28c9", .tests = .{ "src/mcp/spec_test/transports_test.zig:stdio client close lets the server exit at the end of its input", "src/mcp/spec_test/transports_test.zig:stdio client terminates a server that does not exit after its input closed" } },
        .{ .id = "basic/transports/stdio#014-7ded80", .tests = .{"src/mcp/spec_test/transports_test.zig:stdio client terminates a server that does not exit after its input closed"}, .note = "The client ends the process tree after Limits.shutdown_grace." },
        .{ .id = "basic/transports/stdio#015-7d145c", .tests = .{ "src/mcp/spec_test/transports_test.zig:stdio client close lets the server exit at the end of its input", "src/mcp/spec_test/transports_test.zig:stdio server writes one valid JSON-RPC message per line and never a request" }, .note = "The example server process exits before the grace period. The run function returns at the end of its input." },
        .{ .id = "basic/transports/stdio#016-b44a7b", .status = .na, .reason = "A permission that the SDK does not use. The function stdio.serve returns only at the end of its input." },
        .{ .id = "basic/transports/stdio#017-591564", .tests = .{"src/mcp/client/client_test.zig:stdio client restarts a crashed server and the client re-issues the request"}, .note = "Restarts are on with SpawnOptions.max_restarts." },
        .{ .id = "basic/transports/stdio#018-eefc59", .status = .na, .reason = "Applies to clients that also support a legacy version with the initialize handshake. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/transports/stdio#019-7043e3", .status = .na, .reason = "Applies to the fallback to the legacy initialize handshake. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/transports/stdio#020-bbcc9a", .status = .app, .reason = "The SDK client does not probe by itself. The application calls Client.discover before its other requests." },
        .{ .id = "basic/transports/streamable-http#001-d22fc3", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "src/mcp/transport/http_client_test.zig:http client: a wrong path is an http status without a message", "src/mcp/spec_test/transports_test.zig:streamable http server answers legacy traffic without sessions" }, .note = "POST works on the one endpoint path. Other paths are 404 and other methods are 405." },
        .{ .id = "basic/transports/streamable-http#002-dd4452", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "src/mcp/spec_test/transports_test.zig:streamable http server rejects a foreign Origin with 403 and an error that has no id", "conformance:server/dns-rebinding-protection" } },
        .{ .id = "basic/transports/streamable-http#003-e2a913", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "src/mcp/spec_test/transports_test.zig:streamable http server rejects a foreign Origin with 403 and an error that has no id" } },
        .{ .id = "basic/transports/streamable-http#004-136bcf", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server rejects a foreign Origin with 403 and an error that has no id"}, .note = "The 403 body is a JSON-RPC error with a null id." },
        .{ .id = "basic/transports/streamable-http#005-bbd3e5", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server rejects a foreign Origin with 403 and an error that has no id"}, .note = "The http.Options.address default is 127.0.0.1." },
        .{ .id = "basic/transports/streamable-http#006-af1533", .status = .app, .reason = "The server author enables bearer token checks with http.Options.auth. The SDK gives the resource server in mcp.auth." },
        .{ .id = "basic/transports/streamable-http#007-94434b", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers"}, .note = "Every request is a POST to the endpoint path on its own connection." },
        .{ .id = "basic/transports/streamable-http#008-50086e", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers"} },
        .{ .id = "basic/transports/streamable-http#009-6aa4f4", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers"} },
        .{ .id = "basic/transports/streamable-http#010-32ff8c", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "conformance:client/request-metadata", "conformance:client/http-standard-headers" } },
        .{ .id = "basic/transports/streamable-http#011-039bbc", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "src/mcp/spec_test/transports_test.zig:streamable http server answers notifications with 202 and rejects bodies it cannot accept" }, .note = "The client sends one request per body. The server rejects a batch and a response." },
        .{ .id = "basic/transports/streamable-http#012-c300e2", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers"}, .note = "Every body is a request, also the MRTR retry." },
        .{ .id = "basic/transports/streamable-http#013-15b7ae", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server answers notifications with 202 and rejects bodies it cannot accept", "src/mcp/transport/http_test.zig:http ladder and json responses" } },
        .{ .id = "basic/transports/streamable-http#014-910572", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server answers notifications with 202 and rejects bodies it cannot accept", "src/mcp/spec_test/transports_test.zig:streamable http server rejects a foreign Origin with 403 and an error that has no id" }, .note = "A malformed notification is 400 and a notification with a foreign Origin is 403." },
        .{ .id = "basic/transports/streamable-http#015-136bcf", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server answers notifications with 202 and rejects bodies it cannot accept"}, .note = "The 400 body is a JSON-RPC error with a null id." },
        .{ .id = "basic/transports/streamable-http#016-745335", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server answers with JSON or with an SSE stream that the response ends"} },
        .{ .id = "basic/transports/streamable-http#017-a24561", .tests = .{"src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr"}, .note = "The client reads a JSON discover result and an SSE stream with progress." },
        .{ .id = "basic/transports/streamable-http#018-bf57aa", .tests = .{ "src/mcp/transport/http_test.zig:http sse response with progress notifications", "src/mcp/spec_test/transports_test.zig:streamable http server answers with JSON or with an SSE stream that the response ends" } },
        .{ .id = "basic/transports/streamable-http#019-2f0a7c", .tests = .{ "src/mcp/transport/http_test.zig:http sse response with progress notifications", "src/mcp/spec_test/transports_test.zig:streamable http server answers with JSON or with an SSE stream that the response ends" }, .note = "The progress token of each notification is the token of the request." },
        .{ .id = "basic/transports/streamable-http#020-d8f377", .tests = .{ "conformance:server/server-stateless", "src/mcp/spec_test/transports_test.zig:streamable http server answers with JSON or with an SSE stream that the response ends" }, .note = "Check sep-2575-http-server-no-independent-requests-on-stream." },
        .{ .id = "basic/transports/streamable-http#021-c45fd7", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server answers with JSON or with an SSE stream that the response ends", "src/mcp/transport/http_test.zig:http sse response with progress notifications" }, .note = "The stream ends after the response." },
        .{ .id = "basic/transports/streamable-http#022-34d5ee", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server answers with JSON or with an SSE stream that the response ends"} },
        .{ .id = "basic/transports/streamable-http#023-ef6066", .status = .gap, .reason = "Partial. The server sees a closed stream only when it writes to it. A handler that only polls checkCancel is not cancelled.", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server treats a closed SSE stream as the cancellation of the request"} },
        .{ .id = "basic/transports/streamable-http#024-840ea9", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server treats a closed SSE stream as the cancellation of the request", "src/mcp/server/server_test.zig:client-cancelled listen stream gets no response" }, .note = "The handler stops and the engine sends no response after the cancellation." },
        .{ .id = "basic/transports/streamable-http#025-c7b1aa", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "conformance:client/request-metadata", "src/mcp/transport/http_test.zig:http ladder and json responses" }, .note = "The client sends the header. The server rejects a request without it." },
        .{ .id = "basic/transports/streamable-http#026-164df3", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "conformance:client/request-metadata", "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" } },
        .{ .id = "basic/transports/streamable-http#027-43fe2e", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" } },
        .{ .id = "basic/transports/streamable-http#028-202b5e", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" } },
        .{ .id = "basic/transports/streamable-http#029-f1b691", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" } },
        .{ .id = "basic/transports/streamable-http#030-0254c1", .status = .na, .reason = "Applies to servers that support clients of versions before 2025-06-18. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/transports/streamable-http#031-c8df24", .tests = .{"src/mcp/transport/http_test.zig:http ladder and json responses"}, .note = "A request without the header gets 400 and -32020." },
        .{ .id = "basic/transports/streamable-http#032-e9b585", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server requires Mcp-Method and Mcp-Name and compares them with the body", "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "conformance:client/http-standard-headers" } },
        .{ .id = "basic/transports/streamable-http#033-fd9723", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding"}, .note = "A resource URI with non-ASCII characters goes in the sentinel form." },
        .{ .id = "basic/transports/streamable-http#034-31a0b0", .tests = .{ "src/mcp/transport/http_test.zig:http ladder and json responses", "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them" }, .note = "Tools derive x-mcp-header from the header field option of json_schema." },
        .{ .id = "basic/transports/streamable-http#035-88a625", .tests = .{ "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr", "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-custom-headers" } },
        .{ .id = "basic/transports/streamable-http#036-f12d51", .tests = .{ "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr", "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-custom-headers" } },
        .{ .id = "basic/transports/streamable-http#037-3620cf", .tests = .{ "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "basic/transports/streamable-http#038-7a25a1", .tests = .{ "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "conformance:client/http-invalid-tool-headers" }, .note = "Checks a space, a colon and a non-ASCII letter." },
        .{ .id = "basic/transports/streamable-http#039-918204", .tests = .{ "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "conformance:client/http-invalid-tool-headers" }, .note = "Checks a tab, a carriage return and a line feed." },
        .{ .id = "basic/transports/streamable-http#040-320806", .tests = .{ "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "src/mcp/transport/envelope.zig:verify headers against body", "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "conformance:client/http-invalid-tool-headers" }, .note = "The client drops such a tool and the server refuses to register it." },
        .{ .id = "basic/transports/streamable-http#041-fdcfc9", .tests = .{ "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "src/mcp/transport/envelope.zig:verify headers against body", "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "conformance:client/http-invalid-tool-headers" }, .note = "Object, array, null and number types are refused." },
        .{ .id = "basic/transports/streamable-http#042-60184f", .status = .gap, .reason = "Missing. Neither the client nor the server checks that a mirrored integer value is within the safe range of JavaScript." },
        .{ .id = "basic/transports/streamable-http#043-a31f64", .status = .gap, .reason = "Partial. The SDK reads x-mcp-header only on top-level properties. It does not mirror or validate annotations on nested object properties." },
        .{ .id = "basic/transports/streamable-http#044-245311", .status = .gap, .reason = "Missing. The SDK ignores an x-mcp-header under items, a composition keyword, a conditional keyword or $ref. The client keeps such a tool." },
        .{ .id = "basic/transports/streamable-http#045-a33f54", .tests = .{ "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-invalid-tool-headers" }, .note = "Annotations on top-level properties. Annotations in other places are a gap, see streamable-http#044." },
        .{ .id = "basic/transports/streamable-http#046-998b88", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "src/mcp/spec_test/transports_test.zig:client header map removes tools whose x-mcp-header annotations are invalid", "conformance:client/http-invalid-tool-headers" }, .note = "Valid tools stay in the list." },
        .{ .id = "basic/transports/streamable-http#047-a49250", .status = .gap, .reason = "Missing. The client removes the tool without a log message." },
        .{ .id = "basic/transports/streamable-http#048-780a5a", .status = .na, .reason = "A permission. The stdio client ignores x-mcp-header annotations." },
        .{ .id = "basic/transports/streamable-http#049-c17076", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "src/mcp/transport/envelope.zig:sentinel encoding", "conformance:client/http-custom-headers" } },
        .{ .id = "basic/transports/streamable-http#050-f69c51", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "src/mcp/transport/envelope.zig:sentinel encoding", "conformance:client/http-custom-headers" }, .note = "Checks non-ASCII text, spaces at the ends and a line feed." },
        .{ .id = "basic/transports/streamable-http#051-5055c9", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them" }, .note = "The client writes lower-case markers. The server treats upper-case markers as a plain value." },
        .{ .id = "basic/transports/streamable-http#052-a9c927", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/transport/envelope.zig:sentinel encoding" } },
        .{ .id = "basic/transports/streamable-http#053-5ed8ff", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them"}, .note = "Checks Mcp-Name and Mcp-Param-Region in the sentinel form." },
        .{ .id = "basic/transports/streamable-http#054-9c6bd4", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "src/mcp/transport/envelope.zig:sentinel encoding" } },
        .{ .id = "basic/transports/streamable-http#055-bbab2c", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-standard-headers" } },
        .{ .id = "basic/transports/streamable-http#056-c8c22b", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers", "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-standard-headers" } },
        .{ .id = "basic/transports/streamable-http#057-ee18af", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-custom-headers" }, .note = "Top-level properties only. Nested property paths are a gap, see streamable-http#043." },
        .{ .id = "basic/transports/streamable-http#058-f2d64c", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-custom-headers" } },
        .{ .id = "basic/transports/streamable-http#059-bcbd77", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr" } },
        .{ .id = "basic/transports/streamable-http#060-bcae14", .status = .gap, .reason = "Missing. The client gives the -32020 error to the caller. It does not call tools/list and retry." },
        .{ .id = "basic/transports/streamable-http#061-cc05d4", .status = .na, .reason = "Applies to intermediaries. The SDK has no intermediary component." },
        .{ .id = "basic/transports/streamable-http#062-15d3eb", .status = .gap, .reason = "Bug. The server accepts raw non-ASCII bytes and control characters in Mcp-Param and Mcp-Name values when they equal the body value." },
        .{ .id = "basic/transports/streamable-http#063-d06efd", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body", "src/mcp/transport/http_test.zig:http ladder and json responses", "src/mcp/transport/envelope.zig:verify headers against body" } },
        .{ .id = "basic/transports/streamable-http#064-243588", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body" } },
        .{ .id = "basic/transports/streamable-http#065-91d4e6", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-custom-headers" } },
        .{ .id = "basic/transports/streamable-http#066-6bb4df", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body", "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/transport/http_test.zig:http ladder and json responses" } },
        .{ .id = "basic/transports/streamable-http#067-338f54", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding", "conformance:client/http-custom-headers" } },
        .{ .id = "basic/transports/streamable-http#068-701c57", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body", "src/mcp/transport/envelope.zig:verify headers against body" } },
        .{ .id = "basic/transports/streamable-http#069-4d622c", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http client mirrors x-mcp-header parameters with the value encoding"} },
        .{ .id = "basic/transports/streamable-http#070-d7b90d", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body"} },
        .{ .id = "basic/transports/streamable-http#071-d4e1bf", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body", "src/mcp/transport/http_test.zig:http ladder and json responses" } },
        .{ .id = "basic/transports/streamable-http#072-71317f", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server matches header names without regard to case", "src/mcp/spec_test/transports_test.zig:streamable http client sends every message as a new POST with Accept and the metadata headers" }, .note = "The server reads mixed-case names. The client reads an upper-case CONTENT-TYPE." },
        .{ .id = "basic/transports/streamable-http#073-3b889f", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server requires Mcp-Method and Mcp-Name and compares them with the body", "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/transport/http_test.zig:http ladder and json responses" } },
        .{ .id = "basic/transports/streamable-http#074-5667ff", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/transport/envelope.zig:verify headers against body" }, .note = "The header 7.0 matches the body value 7." },
        .{ .id = "basic/transports/streamable-http#075-a99164", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server requires Mcp-Method and Mcp-Name and compares them with the body", "src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them", "src/mcp/spec_test/transports_test.zig:streamable http server expects Mcp-Param headers only for values in the body" } },
        .{ .id = "basic/transports/streamable-http#076-3bf923", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server decodes base64 header values before it compares them"} },
        .{ .id = "basic/transports/streamable-http#077-f1bda2", .status = .na, .reason = "Applies to intermediaries. The SDK has no intermediary component." },
        .{ .id = "basic/transports/streamable-http#078-92be48", .status = .na, .reason = "Applies to intermediaries that enforce policy on mirrored headers. The SDK has no intermediary component." },
        .{ .id = "basic/transports/streamable-http#079-567c06", .status = .na, .reason = "Applies to intermediaries that enforce policy on mirrored headers. The SDK has no intermediary component." },
        .{ .id = "basic/transports/streamable-http#080-060656", .status = .na, .reason = "Applies to clients that also support a legacy version with the initialize handshake. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/transports/streamable-http#081-efc5ff", .status = .na, .reason = "Applies to the fallback to the legacy initialize handshake. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/transports/streamable-http#082-bd5d2b", .tests = .{ "src/mcp/spec_test/transports_test.zig:streamable http server answers legacy traffic without sessions", "src/mcp/transport/http_test.zig:http ladder and json responses" } },
        .{ .id = "basic/transports/streamable-http#083-9298dd", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server answers legacy traffic without sessions"} },
        .{ .id = "basic/transports/streamable-http#084-20985a", .tests = .{"src/mcp/spec_test/transports_test.zig:streamable http server answers legacy traffic without sessions"} },
        .{ .id = "basic/transports/streamable-http#085-62da9b", .status = .na, .reason = "The SDK does not implement the deprecated HTTP+SSE transport." },
        .{ .id = "basic/versioning#001-95370e", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/protocol/errors.zig:unsupported protocol version error shape", "src/mcp/transport/http_test.zig:http ladder and json responses", "conformance:server/server-stateless" } },
        .{ .id = "basic/versioning#002-ecd784", .tests = .{ "src/mcp/spec_test/base_protocol_test.zig:client retries once when the server lists its version and fails otherwise", "conformance:client/request-metadata" }, .note = "The client speaks one version. It retries once when the server lists it and returns error.Rpc otherwise." },
        .{ .id = "basic/versioning#003-7526dd", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/client/client_test.zig:discover, list and call through the memory link", "conformance:server/server-stateless" } },
        .{ .id = "basic/versioning#004-c10fdb", .tests = .{ "src/mcp/client/client_test.zig:discover, list and call through the memory link", "src/mcp/client/client_test.zig:multi round-trip requests are driven by the hooks" }, .note = "Client.discover is optional. The second test calls tools without discovery." },
        .{ .id = "basic/versioning#005-727c1c", .tests = .{"src/mcp/spec_test/base_protocol_test.zig:extension identifiers follow the _meta key rules with a prefix"}, .note = "Checks the Tasks extension identifier of the SDK. Identifiers that the application declares are not checked." },
        .{ .id = "basic/versioning#006-9d13bf", .tests = .{ "src/mcp/server/server_test.zig:tasks extension: gate, sync fallback and lifecycle", "src/mcp/spec_test/base_protocol_test.zig:client accepts the task result type only for a declared extension" }, .note = "Optional task tools run at once. Required task tools and task methods get -32021." },
        .{ .id = "basic/versioning#007-6202a2", .status = .na, .reason = "Duty of extension authors. The Tasks extension specification documents its fallback." },
        .{ .id = "basic/versioning#008-72bba1", .status = .na, .reason = "Applies to dual-era servers. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/versioning#009-75a842", .status = .na, .reason = "Applies to dual-era clients that detect the server era. The SDK supports 2026-07-28 only." },
        .{ .id = "basic/versioning#010-06f4c4", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/spec_test/base_protocol_test.zig:a legacy initialize request gets the supported versions", "src/mcp/spec_test/base_protocol_test.zig:http server names the supported versions when a legacy client sends initialize" }, .note = "stdio and memory send -32601 with supportedVersions. HTTP sends -32022 with supported." },
        .{ .id = "basic/versioning#011-ae340b", .status = .app, .reason = "The application calls Client.discover first on stdio. The SDK client does not send it on its own." },
        .{ .id = "basic/versioning#012-f3b249", .status = .na, .reason = "Applies to dual-era servers. The SDK supports 2026-07-28 only." },
        .{ .id = "client/elicitation#001-f14bc5", .status = .app, .reason = "The server author decides what a form asks for. The SDK cannot detect sensitive fields in a schema." },
        .{ .id = "client/elicitation#002-b176a1", .status = .app, .reason = "The server author selects URL mode with InputRequired.elicitUrl. The SDK cannot classify the data." },
        .{ .id = "client/elicitation#003-4e24ca", .status = .app, .reason = "The host UI shows which server asks. Each Client serves one server, and Hooks.userdata lets the host identify it." },
        .{ .id = "client/elicitation#004-ab93b2", .status = .app, .reason = "The host UI gives the decline and cancel options. The elicitation hooks return ElicitResult with the accept, decline or cancel action." },
        .{ .id = "client/elicitation#005-fc80f1", .status = .app, .reason = "The host UI lets the user review and change the answers before the elicit_form hook returns." },
        .{ .id = "client/elicitation#006-498df1", .status = .app, .reason = "The host shows the host name and asks for consent in the elicit_url hook. The SDK never opens the URL." },
        .{ .id = "client/elicitation#007-9db435", .tests = .{"src/mcp/spec_test/client_features_test.zig:client declares elicitation, sampling and roots in _meta on every round"}, .note = "Checks the capabilities in every request frame, also the retry round." },
        .{ .id = "client/elicitation#008-1bae12", .tests = .{"src/mcp/spec_test/client_features_test.zig:an empty elicitation capability declares form mode only"}, .note = "An empty elicitation object means form mode, so each declaration names at least one mode." },
        .{ .id = "client/elicitation#009-3914b8", .tests = .{ "src/mcp/spec_test/client_features_test.zig:server sends an elicitation mode only when the client declared it", "src/mcp/spec_test/client_features_test.zig:client refuses a URL elicitation when it declared form mode only", "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "conformance:server/input-required-result-capability-check" }, .note = "The server returns -32021 for an undeclared mode. The client also refuses it." },
        .{ .id = "client/elicitation#010-9b99a7", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "conformance:server/input-required-result-basic-elicitation" } },
        .{ .id = "client/elicitation#011-6855da", .tests = .{"src/mcp/spec_test/client_features_test.zig:elicitation requests without the required parameters do not parse"}, .note = "A form or URL request without message does not parse." },
        .{ .id = "client/elicitation#012-03410c", .tests = .{"src/mcp/server/mrtr.zig:input required builder"}, .note = "The form builder writes no mode field." },
        .{ .id = "client/elicitation#013-4db1a3", .tests = .{ "src/mcp/protocol/types.zig:elicitation form params default mode", "src/mcp/spec_test/client_features_test.zig:client treats an elicitation request without mode as form mode" } },
        .{ .id = "client/elicitation#014-b8a680", .tests = .{"src/mcp/spec_test/client_features_test.zig:elicitation requests without the required parameters do not parse"}, .note = "A form request without requestedSchema and a request with an unknown mode do not parse." },
        .{ .id = "client/elicitation#015-8bf2e6", .status = .app, .reason = "The host UI fills the form fields. The SDK parses the default value of each primitive schema." },
        .{ .id = "client/elicitation#016-fab8c9", .tests = .{"src/mcp/spec_test/client_features_test.zig:elicitation requests without the required parameters do not parse"}, .note = "A URL request without url or message does not parse." },
        .{ .id = "client/elicitation#017-ff2b57", .status = .gap, .reason = "Neither InputRequired.elicitUrl nor the client checks that url is a valid URL. Behaviour is missing." },
        .{ .id = "client/elicitation#018-70482f", .status = .app, .reason = "The host UI gives the retry and cancel controls. The SDK gives RequestOptions.cancel and allow_input_required." },
        .{ .id = "client/elicitation#019-12f395", .status = .app, .reason = "The server author stores and binds state to users. The SDK seals requestState, but see elicitation#028." },
        .{ .id = "client/elicitation#020-a4073e", .status = .app, .reason = "The server author protects its state storage. The SDK seals requestState with a server key." },
        .{ .id = "client/elicitation#021-8cb322", .status = .app, .reason = "The handler identifies the user. The SDK gives RequestContext.principal with the verified token claims." },
        .{ .id = "client/elicitation#022-db9b69", .status = .app, .reason = "The server author uses MCP authorization for its own users. The SDK gives the resource server in auth/resource_server.zig." },
        .{ .id = "client/elicitation#023-38668d", .status = .app, .reason = "The server design keeps third-party credentials out of band. The client refuses URL mode answers that carry content." },
        .{ .id = "client/elicitation#024-6d7d4a", .status = .app, .reason = "The server author must not pass the client token to a third party. The handler code makes all third-party calls." },
        .{ .id = "client/elicitation#025-59c9a4", .status = .app, .reason = "The user authorizes the server in the browser, outside the protocol. The SDK has no part in this flow." },
        .{ .id = "client/elicitation#026-da3b32", .status = .app, .reason = "The server author keeps the third-party credentials. The SDK sends only what the handler returns." },
        .{ .id = "client/elicitation#027-43d41c", .status = .app, .reason = "The handler handles decline, cancel and missing answers. RequestContext.elicitResponse gives the action, or null when no answer came." },
        .{ .id = "client/elicitation#028-302fe6", .status = .gap, .reason = "Sealed requestState binds the method and target but not the user. Server.zig passes an empty principal to request_state.aad. No test." },
        .{ .id = "client/elicitation#029-2d0c6c", .status = .app, .reason = "The host UI shows which server asks. Each Client serves one server, and Hooks.userdata lets the host identify it." },
        .{ .id = "client/elicitation#030-ec4f08", .status = .app, .reason = "The host adds approval controls in the elicitation hooks." },
        .{ .id = "client/elicitation#031-a08004", .status = .app, .reason = "The host lets the user decline. The hooks return the decline action." },
        .{ .id = "client/elicitation#032-4cd204", .status = .app, .reason = "The host UI shows the message and the requested schema that the hooks receive." },
        .{ .id = "client/elicitation#033-4fed5b", .status = .app, .reason = "The server author builds the URL. The SDK sends the URL that the handler gives." },
        .{ .id = "client/elicitation#034-2cf25e", .status = .app, .reason = "The server author builds the URL. The SDK sends the URL that the handler gives." },
        .{ .id = "client/elicitation#035-7d04ab", .status = .app, .reason = "The server author writes the form text. The SDK does not examine it." },
        .{ .id = "client/elicitation#036-927b91", .status = .app, .reason = "The server author selects the URL scheme. The SDK does not check it." },
        .{ .id = "client/elicitation#037-f7ff6b", .status = .app, .reason = "The host handles the URL in the elicit_url hook. The SDK does not open or fetch the URL." },
        .{ .id = "client/elicitation#038-671fc5", .status = .app, .reason = "The SDK never fetches the URL. The host must not fetch it in the elicit_url hook." },
        .{ .id = "client/elicitation#039-898f14", .status = .app, .reason = "The host asks for consent in the elicit_url hook. The SDK never opens the URL." },
        .{ .id = "client/elicitation#040-1b6c2f", .status = .app, .reason = "The host UI shows the full URL that the elicit_url hook receives." },
        .{ .id = "client/elicitation#041-6ac848", .status = .app, .reason = "The host selects a secure browser view. The SDK does not open URLs." },
        .{ .id = "client/elicitation#042-5934f2", .status = .app, .reason = "The host UI highlights the domain." },
        .{ .id = "client/elicitation#043-654dee", .status = .app, .reason = "The host UI shows the warnings for suspicious URLs." },
        .{ .id = "client/elicitation#044-82c380", .status = .app, .reason = "The host UI decides how to render the text of the request." },
        .{ .id = "client/elicitation#045-9c7f68", .status = .app, .reason = "The handler uses RequestContext.principal from the verified token, not an identity that the client supplies." },
        .{ .id = "client/elicitation#046-a68e26", .status = .app, .reason = "The server author follows the security best practices. The SDK gives the resource server and RequestContext.principal." },
        .{ .id = "client/elicitation#047-6cd76a", .status = .app, .reason = "The server author decides what a form asks for. The SDK cannot detect sensitive fields in a schema." },
        .{ .id = "client/elicitation#048-a08fcb", .status = .gap, .reason = "The client does not validate the elicit_form hook answer against requestedSchema. Behaviour is missing." },
        .{ .id = "client/elicitation#049-557a99", .status = .app, .reason = "The handler validates the answer. The server keeps no schema between rounds, and the SDK gives mcp.schema.validator." },
        .{ .id = "client/elicitation#050-a75c09", .status = .app, .reason = "The server author checks the user at the URL page. The SDK does not serve that page." },
        .{ .id = "client/elicitation#051-51ff15", .status = .app, .reason = "The server author checks that the same user completes the flow. The SDK does not serve that page." },
        .{ .id = "client/elicitation#052-6183b2", .status = .app, .reason = "The server author makes the identity check resistant to URL changes. The SDK does not serve that page." },
        .{ .id = "client/roots#001-5acd21", .status = .app, .reason = "The application decides whether to use roots. The server keeps roots off by default in Server.Options.mrtr.roots." },
        .{ .id = "client/roots#002-626c7b", .tests = .{"src/mcp/spec_test/client_features_test.zig:client declares elicitation, sampling and roots in _meta on every round"}, .note = "Checks the capabilities in every request frame, also the retry round." },
        .{ .id = "client/roots#003-144c5a", .tests = .{"src/mcp/spec_test/client_features_test.zig:client sends only file URIs as roots"}, .note = "The client fails the request when the list_roots hook returns another scheme." },
        .{ .id = "client/roots#004-fc9b29", .status = .app, .reason = "The host decides which roots the list_roots hook returns." },
        .{ .id = "client/roots#005-9e33d1", .status = .app, .reason = "The host validates the roots that its list_roots hook returns. The SDK checks only the file scheme." },
        .{ .id = "client/roots#006-8dccb7", .status = .app, .reason = "The host applies access control in the list_roots hook." },
        .{ .id = "client/roots#007-bb0a21", .status = .app, .reason = "The host monitors its roots. The list_roots hook runs on each request." },
        .{ .id = "client/roots#008-5630f5", .status = .app, .reason = "The handler handles roots that become unavailable." },
        .{ .id = "client/roots#009-ae0646", .status = .app, .reason = "The handler keeps its operations inside the roots." },
        .{ .id = "client/roots#010-3e1198", .status = .app, .reason = "The handler validates paths against the roots from RequestContext.rootsResponse." },
        .{ .id = "client/roots#011-4b7cdd", .status = .app, .reason = "The host asks the user for consent before the list_roots hook returns." },
        .{ .id = "client/roots#012-92ab26", .status = .app, .reason = "The host UI manages the roots." },
        .{ .id = "client/roots#013-6b1f94", .status = .app, .reason = "The host checks each root before the list_roots hook returns it." },
        .{ .id = "client/roots#014-417796", .status = .app, .reason = "The host monitors its roots. The list_roots hook runs on each request." },
        .{ .id = "client/roots#015-705908", .tests = .{"src/mcp/spec_test/client_features_test.zig:server asks for roots only when the client declared the roots capability"}, .note = "The server returns -32021 instead of a roots/list request." },
        .{ .id = "client/roots#016-67b45b", .status = .app, .reason = "The handler keeps its operations inside the roots." },
        .{ .id = "client/roots#017-9ce8bb", .status = .app, .reason = "The handler caches the roots that RequestContext.rootsResponse gives." },
        .{ .id = "client/sampling#001-df2beb", .status = .app, .reason = "The application decides whether to use sampling. The server keeps sampling off by default in Server.Options.mrtr.sampling." },
        .{ .id = "client/sampling#002-c1c0b6", .status = .app, .reason = "The host keeps a human in the loop in the sample hook." },
        .{ .id = "client/sampling#003-3aa87f", .status = .app, .reason = "The host UI shows the request that the sample hook receives." },
        .{ .id = "client/sampling#004-d651eb", .status = .app, .reason = "The host UI lets the user edit the prompt in the sample hook." },
        .{ .id = "client/sampling#005-c00878", .status = .app, .reason = "The host UI shows the response before the sample hook returns." },
        .{ .id = "client/sampling#006-f1c927", .tests = .{"src/mcp/spec_test/client_features_test.zig:server sends tool-enabled sampling only to clients that declared sampling.tools"}, .note = "A client declares ClientCapabilities.Sampling.tools to get tool-enabled requests." },
        .{ .id = "client/sampling#007-037778", .tests = .{"src/mcp/spec_test/client_features_test.zig:server sends tool-enabled sampling only to clients that declared sampling.tools"}, .note = "The server returns -32021 with sampling.tools in requiredCapabilities." },
        .{ .id = "client/sampling#008-b07e35", .tests = .{"src/mcp/spec_test/client_features_test.zig:client declares elicitation, sampling and roots in _meta on every round"}, .note = "Checks the capabilities in every request frame, also the retry round." },
        .{ .id = "client/sampling#009-45983f", .status = .gap, .reason = "The server does not check includeContext against the sampling.context capability. Behaviour is missing." },
        .{ .id = "client/sampling#010-26228a", .status = .gap, .reason = "The SDK does not check that a user message with tool results holds only tool results. Behaviour is missing." },
        .{ .id = "client/sampling#011-05cb78", .status = .gap, .reason = "The SDK does not check that each tool use has a matching tool result in the next user message. Behaviour is missing." },
        .{ .id = "client/sampling#012-e137d5", .status = .app, .reason = "The model behind the sample hook follows toolChoice. The SDK gives CreateMessageRequestParams.toolChoice to the hook." },
        .{ .id = "client/sampling#013-d32f50", .status = .app, .reason = "The model behind the sample hook follows toolChoice. The SDK gives CreateMessageRequestParams.toolChoice to the hook." },
        .{ .id = "client/sampling#014-f68fea", .status = .na, .reason = "An optional extension outside the core specification. The SDK does not implement it." },
        .{ .id = "client/sampling#015-574369", .tests = .{"src/mcp/spec_test/client_features_test.zig:sampling messages need a user or assistant role and content"} },
        .{ .id = "client/sampling#016-931bff", .status = .app, .reason = "The sample hook decides what it keeps. The SDK keeps no messages between requests." },
        .{ .id = "client/sampling#017-89c697", .status = .app, .reason = "The sample hook maps model hints to models." },
        .{ .id = "client/sampling#018-b7be44", .status = .app, .reason = "The sample hook decides how to use the field." },
        .{ .id = "client/sampling#019-b7be44", .status = .app, .reason = "The sample hook decides how to use the field." },
        .{ .id = "client/sampling#020-f972b7", .status = .app, .reason = "The model call in the sample hook respects maxTokens. The SDK gives CreateMessageRequestParams.maxTokens to the hook." },
        .{ .id = "client/sampling#021-73e346", .status = .app, .reason = "The sample hook decides how to use these fields." },
        .{ .id = "client/sampling#022-6cb06f", .tests = .{"src/mcp/spec_test/client_features_test.zig:sampling results accept the standard and custom stop reasons"} },
        .{ .id = "client/sampling#023-3de7cc", .tests = .{"src/mcp/spec_test/client_features_test.zig:sampling results accept the standard and custom stop reasons"} },
        .{ .id = "client/sampling#024-7fed84", .tests = .{"src/mcp/spec_test/client_features_test.zig:sampling results accept the standard and custom stop reasons"} },
        .{ .id = "client/sampling#025-660d1e", .tests = .{"src/mcp/spec_test/client_features_test.zig:sampling results accept the standard and custom stop reasons"} },
        .{ .id = "client/sampling#026-ec4f08", .status = .app, .reason = "The host adds approval controls in the sample hook." },
        .{ .id = "client/sampling#027-e17277", .tests = .{ "src/mcp/spec_test/client_features_test.zig:server rejects a sampling response with an invalid message", "src/mcp/spec_test/client_features_test.zig:sampling messages need a user or assistant role and content" }, .note = "Both sides parse the messages into typed values and refuse invalid ones." },
        .{ .id = "client/sampling#028-0e6756", .status = .app, .reason = "The sample hook uses the model preferences. The SDK gives CreateMessageRequestParams.modelPreferences." },
        .{ .id = "client/sampling#029-8d15be", .status = .app, .reason = "The host limits the rate of sampling in the sample hook." },
        .{ .id = "client/sampling#030-74a388", .status = .app, .reason = "The host and the handler handle sensitive data in the sample hook and in the tool code." },
        .{ .id = "client/sampling#031-e67ba5", .status = .app, .reason = "The handler builds the next sampling round. The SDK does not check the tool result pairing, see sampling#011." },
        .{ .id = "client/sampling#032-85d56b", .tests = .{"src/mcp/spec_test/client_features_test.zig:client stops a multi round-trip request after the round limit"}, .note = "Client side: Limits.mrtr_max_rounds_client stops the rounds. The server handler sets its own limit." },
        .{ .id = "deprecated#001-ab9060", .status = .app, .reason = "The application decides whether to turn on deprecated features. Sampling, roots and logging are off by default." },
        .{ .id = "index#001-0e5f58", .status = .app, .reason = "The host builds consent and authorization flows. The SDK gives hooks and the authorization modules." },
        .{ .id = "index#002-e049ca", .status = .app, .reason = "The implementor documents security implications of the application." },
        .{ .id = "index#003-f2c003", .status = .app, .reason = "The application sets access control policy. The SDK gives RequestContext.principal for handler checks." },
        .{ .id = "index#004-f32eea", .status = .app, .reason = "The integrator follows security best practices in the application." },
        .{ .id = "index#005-986d60", .status = .app, .reason = "The application designer considers privacy in feature design." },
        .{ .id = "server/discover#001-845b6a", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/client/client_test.zig:discover, list and call through the memory link", "conformance:server/server-stateless" } },
        .{ .id = "server/discover#002-d459eb", .status = .na, .reason = "Applies to dual-era clients. The SDK client supports 2026-07-28 only." },
        .{ .id = "server/discover#003-443d19", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "src/mcp/spec_test/base_protocol_test.zig:every result of the server names the server in _meta", "conformance:server/server-stateless" } },
        .{ .id = "server/discover#004-677481", .status = .app, .reason = "The SDK client never reads serverInfo. The application decides how it shows or uses it." },
        .{ .id = "server/prompts#001-8d5f8f", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:client/request-metadata", "conformance:server/server-stateless" }, .note = "Restates the basic page rule. The client always adds _meta and the server rejects requests without it." },
        .{ .id = "server/prompts#002-c14cee", .tests = .{ "src/mcp/spec_test/server_features_test.zig:registering tools, prompts and resources declares their capabilities in discover", "conformance:server/server-stateless" }, .note = "addPrompt declares the prompts capability." },
        .{ .id = "server/prompts#003-9d2c1d", .tests = .{ "src/mcp/server/server_test.zig:resources, templates, prompts, completion", "src/mcp/spec_test/server_features_test.zig:list changes reach listen streams that asked for them and lists show only available items", "conformance:server/prompts-list" }, .note = "Disabled prompts are not in the list." },
        .{ .id = "server/prompts#004-7814e0", .tests = .{"src/mcp/spec_test/server_features_test.zig:list results are the same on every connection, in the same order, after other requests"} },
        .{ .id = "server/prompts#005-f34a6d", .status = .na, .reason = "Optional. The SDK has no per-request filter for prompts/list. The list comes from the shared registry." },
        .{ .id = "server/prompts#006-70deba", .tests = .{ "src/mcp/spec_test/server_features_test.zig:prompts/get validates arguments, reports handler failures and supports input required", "conformance:server/input-required-result-non-tool-request" } },
        .{ .id = "server/prompts#007-2d0a76", .tests = .{ "src/mcp/spec_test/server_features_test.zig:list changes reach listen streams that asked for them and lists show only available items", "conformance:server/server-stateless" }, .note = "setPromptEnabled publishes notifications/prompts/list_changed." },
        .{ .id = "server/prompts#008-23ff5d", .status = .app, .reason = "The prompt handler encodes the image data. ImageContent makes mimeType a required field, but the SDK does not check the encoding." },
        .{ .id = "server/prompts#009-6c8704", .status = .app, .reason = "The prompt handler encodes the audio data. AudioContent makes mimeType a required field, but the SDK does not check the encoding." },
        .{ .id = "server/prompts#010-4f46b1", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool and prompt results carry resource links and embedded resources"} },
        .{ .id = "server/prompts#011-ee3e7e", .status = .app, .reason = "The prompt handler builds the embedded resource. The uri field is required by the type, but the SDK does not check its syntax." },
        .{ .id = "server/prompts#012-9fa38b", .status = .app, .reason = "The prompt handler sets the MIME type. The mimeType field of resource contents is optional in the SDK types." },
        .{ .id = "server/prompts#013-757c8a", .status = .app, .reason = "The prompt handler supplies text or base64 blob data. ResourceContents is a union of text and blob, but the SDK does not encode the blob." },
        .{ .id = "server/prompts#014-7b0f4a", .tests = .{ "src/mcp/server/server_test.zig:resources, templates, prompts, completion", "src/mcp/spec_test/server_features_test.zig:prompts/get validates arguments, reports handler failures and supports input required" } },
        .{ .id = "server/prompts#015-07665b", .tests = .{ "src/mcp/server/server_test.zig:resources, templates, prompts, completion", "src/mcp/spec_test/server_features_test.zig:prompts/get validates arguments, reports handler failures and supports input required" } },
        .{ .id = "server/prompts#016-27fb2c", .tests = .{"src/mcp/spec_test/server_features_test.zig:prompts/get validates arguments, reports handler failures and supports input required"}, .note = "A handler failure becomes -32603." },
        .{ .id = "server/prompts#017-e3aff1", .tests = .{ "src/mcp/spec_test/server_features_test.zig:prompts/get validates arguments, reports handler failures and supports input required", "src/mcp/server/server_test.zig:resources, templates, prompts, completion" }, .note = "Required arguments and string values are checked before the handler runs." },
        .{ .id = "server/prompts#018-bf4e30", .tests = .{"src/mcp/spec_test/server_features_test.zig:the client pages through a long prompt list with the cursor"}, .note = "listPrompts takes the cursor. The application runs the loop." },
        .{ .id = "server/prompts#019-db9f90", .tests = .{ "src/mcp/spec_test/server_features_test.zig:registering tools, prompts and resources declares their capabilities in discover", "src/mcp/server/server_test.zig:tools list and call", "src/mcp/server/server_test.zig:multi round-trip request with sealed state" }, .note = "The server gates methods and input requests on capabilities. The client does not check server capabilities before a call." },
        .{ .id = "server/prompts#020-be271a", .status = .app, .reason = "The handler and the host check prompt content for injection. The SDK checks only required arguments and string values." },
        .{ .id = "server/resources#001-8d5f8f", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:client/request-metadata", "conformance:server/server-stateless" }, .note = "Restates the basic page rule. The client always adds _meta and the server rejects requests without it." },
        .{ .id = "server/resources#002-c7a64a", .tests = .{"src/mcp/spec_test/server_features_test.zig:registering tools, prompts and resources declares their capabilities in discover"}, .note = "addResource and addResourceTemplate declare the resources capability." },
        .{ .id = "server/resources#003-62f3bd", .tests = .{ "src/mcp/server/server_test.zig:resources, templates, prompts, completion", "src/mcp/spec_test/server_features_test.zig:list results are the same on every connection, in the same order, after other requests", "conformance:server/resources-list" } },
        .{ .id = "server/resources#004-7814e0", .tests = .{"src/mcp/spec_test/server_features_test.zig:list results are the same on every connection, in the same order, after other requests"} },
        .{ .id = "server/resources#005-5d9637", .status = .app, .reason = "The SDK filters nothing by authorization. A template list hook receives RequestContext, and principal() gives the caller." },
        .{ .id = "server/resources#006-296107", .tests = .{"src/mcp/spec_test/server_features_test.zig:resources/read returns several contents, never empty contents, and reports failures"} },
        .{ .id = "server/resources#007-9fc894",.tests = .{"src/mcp/spec_test/server_features_test.zig:resources/read returns several contents, never empty contents, and reports failures"} },
        .{ .id = "server/resources#008-327812", .tests = .{"src/mcp/spec_test/server_features_test.zig:list changes reach listen streams that asked for them and lists show only available items"}, .note = "The application calls notifyResourcesListChanged. The SDK has no automatic trigger for resources." },
        .{ .id = "server/resources#009-2e22fd", .status = .app, .reason = "The server author chooses the URI scheme of each resource." },
        .{ .id = "server/resources#010-9ef5d9", .status = .app, .reason = "The server author chooses the URI scheme of each resource." },
        .{ .id = "server/resources#011-42708a", .status = .app, .reason = "The server author sets the MIME type in ResourceDef.mime_type and in the contents." },
        .{ .id = "server/resources#012-dc2c9c", .status = .app, .reason = "The server author defines custom schemes. The SDK does not check URI syntax at registration." },
        .{ .id = "server/resources#013-81c064", .tests = .{ "src/mcp/server/server_test.zig:resources, templates, prompts, completion", "src/mcp/spec_test/server_features_test.zig:resources/read returns several contents, never empty contents, and reports failures", "conformance:server/sep-2164-resource-not-found" } },
        .{ .id = "server/resources#014-e78a06", .tests = .{"src/mcp/spec_test/server_features_test.zig:resources/read returns several contents, never empty contents, and reports failures"}, .note = "A handler failure becomes -32603." },
        .{ .id = "server/resources#015-7a765a", .status = .na, .reason = "Backwards compatibility with earlier protocol versions. The client talks to 2026-07-28 servers only and gives any code in Diagnostics.rpc_error." },
        .{ .id = "server/resources#016-22698d", .tests = .{ "src/mcp/spec_test/server_features_test.zig:resources/read returns several contents, never empty contents, and reports failures", "conformance:server/sep-2164-resource-not-found" }, .note = "Empty contents from a handler become -32602 with data.uri." },
        .{ .id = "server/resources#017-aa1e73", .status = .app, .reason = "The SDK routes only exact URIs and template matches, and gives -32602 for others. The handler validates template variables." },
        .{ .id = "server/resources#018-079368", .status = .app, .reason = "Access control policy belongs to the handler. RequestContext.principal() gives the authorization principal on Streamable HTTP." },
        .{ .id = "server/resources#019-50110d", .status = .app, .reason = "The handler base64-encodes blob data. The SDK sends the blob string as it is." },
        .{ .id = "server/resources#020-9016d3", .status = .app, .reason = "Permission checks belong to the handler. RequestContext.principal() gives the authorization principal on Streamable HTTP." },
        .{ .id = "server/resources#021-fe3997", .status = .app, .reason = "The SDK serves no files. The handler sanitizes paths. Simple template variables never contain a slash, but reserved variables can." },
        .{ .id = "server/tools#001-8d5f8f", .tests = .{ "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:client/request-metadata", "conformance:server/server-stateless" }, .note = "Restates the basic page rule. The client always adds _meta and the server rejects requests without it." },
        .{ .id = "server/tools#002-8b045f", .status = .app, .reason = "The host keeps a human in the loop and can deny a call before it sends tools/call." },
        .{ .id = "server/tools#003-9d480b", .status = .app, .reason = "The host UI shows the tools. The SDK gives listTools." },
        .{ .id = "server/tools#004-1099aa", .status = .app, .reason = "The host UI shows the tool invocations." },
        .{ .id = "server/tools#005-59067d", .status = .app, .reason = "The host shows the confirmation prompts before it calls callTool." },
        .{ .id = "server/tools#006-ccd549", .tests = .{ "src/mcp/spec_test/server_features_test.zig:registering tools, prompts and resources declares their capabilities in discover", "src/mcp/server/server_test.zig:discover and ladder errors", "conformance:server/server-stateless" }, .note = "addTool and addToolJson declare the tools capability." },
        .{ .id = "server/tools#007-53daa4", .tests = .{ "src/mcp/server/server_test.zig:tools list and call", "src/mcp/spec_test/server_features_test.zig:list changes reach listen streams that asked for them and lists show only available items", "conformance:server/tools-list" }, .note = "Disabled tools are not in the list." },
        .{ .id = "server/tools#008-7814e0", .tests = .{"src/mcp/spec_test/server_features_test.zig:list results are the same on every connection, in the same order, after other requests"} },
        .{ .id = "server/tools#009-4e813f", .status = .na, .reason = "Optional. The SDK has no per-request filter for tools/list. The list comes from the shared registry." },
        .{ .id = "server/tools#010-965d8c", .tests = .{"src/mcp/spec_test/server_features_test.zig:list results are the same on every connection, in the same order, after other requests"}, .note = "Tools come in registration order." },
        .{ .id = "server/tools#011-0889f6", .tests = .{ "src/mcp/server/server_test.zig:multi round-trip request with sealed state", "conformance:server/input-required-result-basic-elicitation" } },
        .{ .id = "server/tools#012-93f9a1", .tests = .{ "src/mcp/spec_test/server_features_test.zig:the client retries an input required request with a new JSON-RPC id", "conformance:client/sep-2322-client-request-state" }, .note = "A client obligation. The client takes a new id for each round." },
        .{ .id = "server/tools#013-7ecc3c", .tests = .{ "src/mcp/spec_test/server_features_test.zig:list changes reach listen streams that asked for them and lists show only available items", "src/mcp/server/server_test.zig:subscriptions listen stream", "conformance:server/server-stateless" }, .note = "setToolEnabled publishes notifications/tools/list_changed." },
        .{ .id = "server/tools#014-8fd95f", .tests = .{ "src/mcp/spec_test/server_features_test.zig:a tool input schema must be a valid JSON Schema object", "src/mcp/server/server_test.zig:tools list and call" }, .note = "Registration rejects null, non-object and invalid schemas." },
        .{ .id = "server/tools#015-666d90", .tests = .{ "src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr", "conformance:client/http-custom-headers" } },
        .{ .id = "server/tools#016-e22f18", .status = .app, .reason = "The host decides which servers it trusts. The SDK passes tool annotations through and never acts on them." },
        .{ .id = "server/tools#017-c37d16", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool names follow the length, character, case and uniqueness rules"} },
        .{ .id = "server/tools#018-e56323", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool names follow the length, character, case and uniqueness rules"} },
        .{ .id = "server/tools#019-49087d", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool names follow the length, character, case and uniqueness rules"} },
        .{ .id = "server/tools#020-dc746c", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool names follow the length, character, case and uniqueness rules"} },
        .{ .id = "server/tools#021-460355", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool names follow the length, character, case and uniqueness rules"} },
        .{ .id = "server/tools#022-408b67", .status = .app, .reason = "The SDK client connects to one server. A host that aggregates several servers disambiguates the tool names." },
        .{ .id = "server/tools#023-bf3840", .status = .app, .reason = "A host that aggregates several servers chooses the disambiguation key. The SDK does not aggregate." },
        .{ .id = "server/tools#024-3620cf", .tests = .{ "src/mcp/spec_test/server_features_test.zig:x-mcp-header annotations that break the constraints are rejected at registration", "src/mcp/spec_test/server_features_test.zig:the client drops tools with invalid x-mcp-header annotations from tools/list", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "server/tools#025-7a25a1", .tests = .{ "src/mcp/spec_test/server_features_test.zig:x-mcp-header annotations that break the constraints are rejected at registration", "src/mcp/spec_test/server_features_test.zig:the client drops tools with invalid x-mcp-header annotations from tools/list", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "server/tools#026-918204", .tests = .{ "src/mcp/spec_test/server_features_test.zig:x-mcp-header annotations that break the constraints are rejected at registration", "src/mcp/spec_test/server_features_test.zig:the client drops tools with invalid x-mcp-header annotations from tools/list", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "server/tools#027-320806", .tests = .{ "src/mcp/spec_test/server_features_test.zig:x-mcp-header annotations that break the constraints are rejected at registration", "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "src/mcp/transport/envelope.zig:verify headers against body", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "server/tools#028-fdcfc9", .tests = .{ "src/mcp/spec_test/server_features_test.zig:x-mcp-header annotations that break the constraints are rejected at registration", "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "src/mcp/transport/envelope.zig:verify headers against body", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "server/tools#029-2edb6d", .status = .gap, .reason = "Missing. No code checks that integer values stay within the IEEE754 safe range. encodeParam writes any i64 into the header." },
        .{ .id = "server/tools#030-109915", .status = .gap, .reason = "Partial. schemaHeadersValid looks only at the root properties. It accepts annotations under items, anyOf, oneOf or nested properties without a check." },
        .{ .id = "server/tools#031-a33f54", .status = .gap, .reason = "Partial. The HTTP and gRPC clients reject the first five constraints. They do not detect annotations that are not statically reachable, see server/tools#030.", .tests = .{ "src/mcp/spec_test/server_features_test.zig:the client drops tools with invalid x-mcp-header annotations from tools/list", "conformance:client/http-invalid-tool-headers" } },
        .{ .id = "server/tools#032-998b88", .tests = .{ "src/mcp/spec_test/server_features_test.zig:the client drops tools with invalid x-mcp-header annotations from tools/list", "conformance:client/http-invalid-tool-headers" }, .note = "tool_headers.Map.learn removes the invalid tools from the tools/list frame." },
        .{ .id = "server/tools#033-a49250", .status = .gap, .reason = "Missing. tool_headers.Map.learn removes the invalid tool without a log message." },
        .{ .id = "server/tools#034-780a5a", .status = .na, .reason = "A permission, not an obligation. The stdio client ignores x-mcp-header annotations." },
        .{ .id = "server/tools#035-eb1c73", .status = .app, .reason = "The server author chooses which parameters carry an x-mcp-header annotation." },
        .{ .id = "server/tools#036-d5067d", .tests = .{"src/mcp/spec_test/server_features_test.zig:tool and prompt results carry resource links and embedded resources"} },
        .{ .id = "server/tools#037-e08aba", .tests = .{ "src/mcp/spec_test/server_features_test.zig:tool and prompt results carry resource links and embedded resources", "conformance:server/tools-call-embedded-resource" } },
        .{ .id = "server/tools#038-e618bd", .status = .app, .reason = "The server author registers resources. The SDK does not link embedded resources to the resources capability." },
        .{ .id = "server/tools#039-e21b19", .tests = .{"src/mcp/spec_test/server_features_test.zig:structured content is mirrored into a text block and must match the output schema"}, .note = "Options.structured_text_mirror adds the text block by default." },
        .{ .id = "server/tools#040-462392", .tests = .{ "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "src/mcp/spec_test/server_features_test.zig:structured content is mirrored into a text block and must match the output schema" }, .note = "A result that breaks the output schema becomes -32603." },
        .{ .id = "server/tools#041-c5f77f", .status = .gap, .reason = "Missing. The client does not validate structuredContent. Diagnostics.structured_content_invalid exists, but no code sets it." },
        .{ .id = "server/tools#042-b0f617", .status = .app, .reason = "The host decides what reaches the model. The client gives protocol errors as error.Rpc with Diagnostics.rpc_error." },
        .{ .id = "server/tools#043-6f4cc2", .status = .app, .reason = "The host passes the result to the model. The client returns tool execution errors as a CallToolResult with isError." },
        .{ .id = "server/tools#044-bf895c", .tests = .{ "src/mcp/server/server_test.zig:tool schemas validate arguments and structured output", "src/mcp/server/server_test.zig:tools list and call" }, .note = "Arguments are validated against inputSchema before the handler runs." },
        .{ .id = "server/tools#045-51ccd6", .status = .app, .reason = "Access control policy belongs to the handler. The SDK gives RequestContext.principal() and ToolDef.requires_client." },
        .{ .id = "server/tools#046-88a982", .status = .app, .reason = "Rate limit policy belongs to the server application. The SDK only caps concurrent requests with Limits.max_in_flight_requests." },
        .{ .id = "server/tools#047-5dc584", .status = .app, .reason = "The tool handler sanitizes its output. The SDK sends the result as the handler gives it." },
        .{ .id = "server/tools#048-8da3c4", .status = .app, .reason = "The host prompts the user before it calls callTool." },
        .{ .id = "server/tools#049-080acb", .status = .app, .reason = "The host shows the arguments before it calls callTool." },
        .{ .id = "server/tools#050-8395be", .status = .app, .reason = "The host decides what reaches the model. The client only checks that the result parses as CallToolResult." },
        .{ .id = "server/tools#051-b69c23", .tests = .{ "conformance:client/json-schema-ref-no-deref", "src/mcp/schema/validator.zig:logic, conditionals and references", "src/mcp/schema/validator.zig:compile rejects unsupported and remote schemas" }, .note = "The client never dereferences a schema. The server validator resolves local references and rejects remote ones." },
        .{ .id = "server/tools#052-ceeb29", .tests = .{"src/mcp/transport/http_client_test.zig:http client: json, sse, header mirroring and mrtr"}, .note = "RequestOptions.timeout ends a slow tool call with error.Timeout." },
        .{ .id = "server/tools#053-5664fd", .status = .app, .reason = "The host logs tool usage for audit." },
        .{ .id = "server/utilities/caching#001-b94cbb", .tests = .{"src/mcp/server/server_test.zig:discover and ladder errors"}, .note = "Checks ttlMs and cacheScope on the server/discover result." },
        .{ .id = "server/utilities/caching#002-60f18b", .tests = .{ "conformance:server/caching", "src/mcp/server/server_test.zig:tools list and call" } },
        .{ .id = "server/utilities/caching#003-351011", .tests = .{"conformance:server/caching"} },
        .{ .id = "server/utilities/caching#004-5c7182", .tests = .{"conformance:server/caching"} },
        .{ .id = "server/utilities/caching#005-a9ffe0", .tests = .{"conformance:server/caching"} },
        .{ .id = "server/utilities/caching#006-1e7dc0", .tests = .{ "conformance:server/caching", "src/mcp/server/server_test.zig:resources, templates, prompts, completion" } },
        .{ .id = "server/utilities/caching#007-f6ca89", .tests = .{ "src/mcp/spec_test/utilities_test.zig:client cache hits only for the same method and parameters", "src/mcp/client/cache.zig:keys, lifetime and invalidation" } },
        .{ .id = "server/utilities/caching#008-40027d", .status = .gap, .tests = .{"src/mcp/spec_test/utilities_test.zig:client does not cache results of multi round-trip retries"}, .reason = "Retries that the client drives are not cached. A caller request that carries only requestState is cached, which is a bug." },
        .{ .id = "server/utilities/caching#009-7de2c1", .tests = .{"src/mcp/client/client_test.zig:the result cache serves reads with a lifetime until invalidated"}, .note = "The client keeps a result with an integer ttlMs fresh for that time." },
        .{ .id = "server/utilities/caching#010-79445f", .tests = .{"src/mcp/client/client_test.zig:the result cache serves reads with a lifetime until invalidated"} },
        .{ .id = "server/utilities/caching#011-98d047", .tests = .{ "src/mcp/client/cache.zig:keys, lifetime and invalidation", "src/mcp/spec_test/utilities_test.zig:client treats a zero, absent or negative ttl as immediately stale" } },
        .{ .id = "server/utilities/caching#012-f7e3a3", .tests = .{"src/mcp/spec_test/utilities_test.zig:client treats a zero, absent or negative ttl as immediately stale"} },
        .{ .id = "server/utilities/caching#013-fb6583", .tests = .{"src/mcp/client/client_test.zig:the result cache serves reads with a lifetime until invalidated"} },
        .{ .id = "server/utilities/caching#014-13ee1f", .tests = .{"src/mcp/spec_test/utilities_test.zig:client treats a zero, absent or negative ttl as immediately stale"} },
        .{ .id = "server/utilities/caching#015-62d6b1", .tests = .{"src/mcp/spec_test/utilities_test.zig:client treats a zero, absent or negative ttl as immediately stale"} },
        .{ .id = "server/utilities/caching#016-bd96fb", .tests = .{ "src/mcp/spec_test/utilities_test.zig:server sends negative ttl hints as zero", "conformance:server/caching" } },
        .{ .id = "server/utilities/caching#017-66632f", .status = .app, .reason = "The application changes its data at any time. The SDK does not freeze data during the TTL." },
        .{ .id = "server/utilities/caching#018-4f05f9", .tests = .{"src/mcp/spec_test/utilities_test.zig:client fetches an expired page again with its cursor"} },
        .{ .id = "server/utilities/caching#019-cfa756", .status = .app, .reason = "The SDK cache never fetches in the background. Polling is a choice of the application." },
        .{ .id = "server/utilities/caching#020-7e57a4", .status = .app, .reason = "The SDK does not poll on TTL. An application that polls must add jitter and backoff." },
        .{ .id = "server/utilities/caching#021-2594e2", .tests = .{"src/mcp/client/client_test.zig:the result cache serves reads with a lifetime until invalidated"}, .note = "The refresh mode and Client.invalidateCache fetch again before the TTL expires." },
        .{ .id = "server/utilities/caching#022-61dfca", .status = .na, .reason = "Optional feature that the SDK does not implement. The client cache drops an expired entry and never serves it." },
        .{ .id = "server/utilities/caching#023-66854e", .status = .na, .reason = "The SDK has no shared gateway or caching proxy. The client cache belongs to one client instance." },
        .{ .id = "server/utilities/caching#024-98bdd4", .tests = .{ "src/mcp/client/client_test.zig:the result cache serves reads with a lifetime until invalidated", "src/mcp/spec_test/utilities_test.zig:client caches are not shared between client instances" }, .note = "The same client serves a private read from its cache." },
        .{ .id = "server/utilities/caching#025-7775a2", .status = .gap, .tests = .{"src/mcp/spec_test/utilities_test.zig:client caches are not shared between client instances"}, .reason = "Each client instance has its own cache. The cache ignores cacheScope and keeps private entries after connect() or a token change." },
        .{ .id = "server/utilities/caching#026-5828bf", .tests = .{"src/mcp/spec_test/utilities_test.zig:server sends ttl hints with and without listChanged"} },
        .{ .id = "server/utilities/caching#027-225167", .tests = .{"src/mcp/spec_test/utilities_test.zig:server sends ttl hints with and without listChanged"} },
        .{ .id = "server/utilities/caching#028-235957", .status = .na, .reason = "Optional feature that the SDK does not offer. The server stamps one lists hint on every page." },
        .{ .id = "server/utilities/caching#029-abea8f", .tests = .{"src/mcp/spec_test/utilities_test.zig:client fetches an expired page again with its cursor"} },
        .{ .id = "server/utilities/caching#030-1cc448", .status = .app, .reason = "The application decides when it needs a snapshot. The SDK gives a list call with a null cursor and the refresh cache mode." },
        .{ .id = "server/utilities/caching#031-269b9d", .status = .gap, .reason = "Missing. The client keeps cached pages after an invalid cursor error. The application can call Client.invalidateCache." },
        .{ .id = "server/utilities/caching#032-54a671", .tests = .{"src/mcp/spec_test/utilities_test.zig:server applies the same cache scope and ttl to every page of a list"} },
        .{ .id = "server/utilities/caching#033-429390", .tests = .{"src/mcp/spec_test/utilities_test.zig:server applies the same cache scope and ttl to every page of a list"} },
        .{ .id = "server/utilities/caching#034-d81c3b", .status = .app, .reason = "The server author chooses the scope with Server.Options.cache. The SDK default scope is private." },
        .{ .id = "server/utilities/caching#035-bf5a32", .status = .app, .reason = "The handler enforces access control for each primitive. The SDK gives RequestContext.principal." },
        .{ .id = "server/utilities/completion#001-8d5f8f", .status = .na, .reason = "Restates the _meta rule of basic/index.mdx." },
        .{ .id = "server/utilities/completion#002-45f246", .tests = .{"src/mcp/spec_test/utilities_test.zig:completion needs the completions capability"} },
        .{ .id = "server/utilities/completion#003-0eacda", .tests = .{"src/mcp/spec_test/utilities_test.zig:completion needs the completions capability"} },
        .{ .id = "server/utilities/completion#004-7b0f4a", .status = .gap, .reason = "Missing. The server gives an unknown prompt name to the completion handler. The handler can reject it with RequestContext.invalidParams." },
        .{ .id = "server/utilities/completion#005-07665b", .tests = .{"src/mcp/spec_test/utilities_test.zig:completion rejects malformed parameters with invalid params"}, .note = "A missing ref or argument gives -32602." },
        .{ .id = "server/utilities/completion#006-27fb2c", .tests = .{"src/mcp/spec_test/utilities_test.zig:completion handler failure is an internal error"} },
        .{ .id = "server/utilities/completion#007-d25c15", .status = .app, .reason = "The completion handler orders the values." },
        .{ .id = "server/utilities/completion#008-b9c1b3", .status = .app, .reason = "The completion handler does the matching." },
        .{ .id = "server/utilities/completion#009-b4fc19", .status = .app, .reason = "Rate limit policy belongs to the application. The SDK only limits requests in flight with Limits.max_in_flight_requests." },
        .{ .id = "server/utilities/completion#010-875e58", .tests = .{"src/mcp/spec_test/utilities_test.zig:completion rejects malformed parameters with invalid params"}, .note = "The server checks the shape of the parameters. The handler checks the values." },
        .{ .id = "server/utilities/completion#011-57baa8", .status = .app, .reason = "The host UI debounces the requests." },
        .{ .id = "server/utilities/completion#012-a0a598", .status = .app, .reason = "The application caches completion results. The client cache keeps only cacheable methods." },
        .{ .id = "server/utilities/completion#013-12f248", .status = .app, .reason = "The host handles partial results. The SDK parses total and hasMore as optional fields." },
        .{ .id = "server/utilities/completion#014-6f9406", .tests = .{"src/mcp/spec_test/utilities_test.zig:completion rejects malformed parameters with invalid params"}, .note = "The server checks the shape of the parameters. The handler checks the values." },
        .{ .id = "server/utilities/completion#015-00084c", .status = .app, .reason = "Rate limit policy belongs to the application. The SDK only limits requests in flight." },
        .{ .id = "server/utilities/completion#016-4271ec", .status = .app, .reason = "The completion handler controls which suggestions it returns. The SDK gives RequestContext.principal." },
        .{ .id = "server/utilities/completion#017-67353d", .status = .app, .reason = "The completion handler decides what it discloses. The SDK gives RequestContext.principal." },
        .{ .id = "server/utilities/logging#001-734361", .status = .app, .reason = "Logging is off by default. The server author opts in with capabilities.logging and the client with Options.log_level." },
        .{ .id = "server/utilities/logging#002-9b05a3", .tests = .{"src/mcp/spec_test/utilities_test.zig:log messages need the logging capability and a log level in the request"} },
        .{ .id = "server/utilities/logging#003-18f800", .tests = .{"src/mcp/spec_test/utilities_test.zig:log messages need the logging capability and a log level in the request"} },
        .{ .id = "server/utilities/logging#004-7eb04d", .tests = .{"src/mcp/spec_test/utilities_test.zig:log messages need the logging capability and a log level in the request"}, .note = "Checks the level filter and that the messages come before the response." },
        .{ .id = "server/utilities/logging#005-a9e84b", .tests = .{"src/mcp/spec_test/utilities_test.zig:log messages go only to the stream of the request that set the level"} },
        .{ .id = "server/utilities/logging#006-d931a4", .tests = .{"src/mcp/spec_test/utilities_test.zig:an unknown log level in the request is invalid params"} },
        .{ .id = "server/utilities/logging#007-738605", .status = .na, .reason = "The list item names the general internal error code. The SDK has no internal failure that is specific to the log level." },
        .{ .id = "server/utilities/logging#008-d3a04d", .status = .app, .reason = "The handler decides how often it logs. The SDK has no rate limit for log messages." },
        .{ .id = "server/utilities/logging#009-6e494e", .status = .app, .reason = "The handler supplies the data field of RequestContext.log." },
        .{ .id = "server/utilities/logging#010-fd2984", .status = .app, .reason = "The handler supplies the logger name of RequestContext.log." },
        .{ .id = "server/utilities/logging#011-a83f99", .status = .app, .reason = "The handler decides the content of each log message." },
        .{ .id = "server/utilities/logging#012-402c3b", .status = .app, .reason = "The host shows the messages. The SDK gives RequestOptions.on_log." },
        .{ .id = "server/utilities/logging#013-db29f0", .status = .app, .reason = "The host filters the messages. The SDK gives RequestOptions.on_log." },
        .{ .id = "server/utilities/logging#014-4a1050", .status = .app, .reason = "The host shows the severity. The SDK gives RequestOptions.on_log with the level." },
        .{ .id = "server/utilities/logging#015-87dbf0", .status = .app, .reason = "The host stores the messages. The SDK gives RequestOptions.on_log." },
        .{ .id = "server/utilities/logging#016-77fa11", .status = .app, .reason = "The handler decides the content of each log message." },
        .{ .id = "server/utilities/logging#017-9ed229", .status = .app, .reason = "The handler decides the content of each log message." },
        .{ .id = "server/utilities/logging#018-b69c76", .status = .app, .reason = "The handler decides the content of each log message." },
        .{ .id = "server/utilities/logging#019-f89e4f", .status = .app, .reason = "Rate limit policy belongs to the application. The SDK has no rate limit for log messages." },
        .{ .id = "server/utilities/logging#020-176dc3", .tests = .{ "src/mcp/spec_test/utilities_test.zig:client drops a log notification with an invalid level", "src/mcp/spec_test/utilities_test.zig:an unknown log level in the request is invalid params" } },
        .{ .id = "server/utilities/logging#021-db3887", .status = .app, .reason = "The host controls who can read the log messages." },
        .{ .id = "server/utilities/logging#022-ace848", .status = .app, .reason = "The server author and the host monitor the content of the log messages." },
        .{ .id = "server/utilities/pagination#001-8d5f8f", .status = .na, .reason = "Restates the _meta rule of basic/index.mdx." },
        .{ .id = "server/utilities/pagination#002-6573d8", .tests = .{"src/mcp/spec_test/utilities_test.zig:client pages through a server page size it does not know"} },
        .{ .id = "server/utilities/pagination#003-1eb1c6", .tests = .{"src/mcp/spec_test/utilities_test.zig:server cursors are stable"} },
        .{ .id = "server/utilities/pagination#004-a4292e", .tests = .{"src/mcp/server/server_test.zig:pagination"}, .note = "A malformed cursor gives -32602." },
        .{ .id = "server/utilities/pagination#005-b9d94a", .status = .app, .reason = "The application loops until nextCursor is null. The SDK sets nextCursor to null when the field is absent." },
        .{ .id = "server/utilities/pagination#006-6984c6", .tests = .{ "src/mcp/spec_test/utilities_test.zig:client pages through a server page size it does not know", "src/mcp/client/client_test.zig:discover, list and call through the memory link" } },
        .{ .id = "server/utilities/pagination#007-7c12e4", .tests = .{"src/mcp/spec_test/utilities_test.zig:client passes cursors back unchanged, also an empty cursor"} },
        .{ .id = "server/utilities/pagination#008-a38857", .tests = .{"src/mcp/spec_test/utilities_test.zig:client passes cursors back unchanged, also an empty cursor"} },
        .{ .id = "server/utilities/pagination#009-6de9eb", .tests = .{"src/mcp/spec_test/utilities_test.zig:client passes cursors back unchanged, also an empty cursor"} },
        .{ .id = "server/utilities/pagination#010-09ea0f", .tests = .{"src/mcp/server/server_test.zig:pagination"} },
    },
}
