        .{ .id = "basic/authorization/security-considerations#004-191fec", .tests = .{ "src/mcp/spec_test/authorization_discovery_test.zig:http server rejects tokens for another audience or without an audience before the handler runs", "src/mcp/auth/resource_server.zig:challenges and decisions", "src/mcp/auth/jwt.zig:hs256 round trip and claims" }, .note = "The audience check needs JwtVerifier options.audience. Null skips it." },
        .{ .id = "basic/authorization/security-considerations#005-3ed2ae", .status = .app, .reason = "The client keeps tokens and secrets in memory and zeroes them on release. Persistent storage is the application." },
