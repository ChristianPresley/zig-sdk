        .{ .id = "basic/authorization#053-20b979", .tests = .{"src/mcp/spec_test/authorization_test.zig:oauth client registers the refresh_token grant and does not require a refresh token"}, .note = "The token response has no refresh token and the flow succeeds." },
        .{ .id = "basic/authorization#054-68e0a1", .status = .app, .reason = "The server author sets the scopes of ResourceServer. The SDK does not add offline_access." },
