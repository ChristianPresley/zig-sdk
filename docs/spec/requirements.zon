            .page = "server/prompts",
            .line = 13,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Every request MUST include the required `_meta` fields; see `_meta`.",
        },
        .{
            .id = "server/prompts#002-c14cee",
            .page = "server/prompts",
            .line = 41,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that support prompts MUST declare the `prompts` capability in their `DiscoverResult`:",
        },
        .{
            .id = "server/prompts#003-9d2c1d",
            .page = "server/prompts",
            .line = 57,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that declare the `prompts` capability MUST respond to `prompts/list` requests with the set of prompts currently available to the requesting client.",
        },
        .{
            .id = "server/prompts#004-7814e0",
            .page = "server/prompts",
            .line = 57,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must_not,
            .keywords = .{"MAY", "MUST NOT"},
            .party = .server,
            .text = "This set MAY be empty and MAY change over time (see List Changed Notification), but MUST NOT vary per-connection or as a side effect of other requests on the connection.",
        },
        .{
            .id = "server/prompts#005-f34a6d",
            .page = "server/prompts",
            .line = 57,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The set MAY vary by the authorization presented on the request \xe2\x80\x94 for example, returning only the prompts the caller's granted scopes permit \xe2\x80\x94 since credentials are per-request input, not connection state.",
        },
        .{
            .id = "server/prompts#006-70deba",
            .page = "server/prompts",
            .line = 165,
            .section = "Getting a Prompt",
            .anchor = "getting-a-prompt",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY also respond to `prompts/get` with an `InputRequiredResult` to indicate that additional input is needed before the prompt can be resolved.",
        },
        .{
            .id = "server/prompts#007-2d0a76",
            .page = "server/prompts",
            .line = 169,
            .section = "List Changed Notification",
            .anchor = "list-changed-notification",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When the list of available prompts changes, servers that declared the `listChanged` capability SHOULD send a notification to clients that have opened a `subscriptions/listen` stream with `promptsListChanged: true`:",
        },
        .{
