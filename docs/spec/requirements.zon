        },
        .{
            .id = "server/resources#009-2e22fd",
            .page = "server/resources",
            .line = 375,
            .section = "https://",
            .anchor = "https",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD use this scheme only when the client is able to fetch and load the resource directly from the web on its own\xe2\x80\x94that is, it doesn\xe2\x80\x99t need to read the resource via the MCP server.",
        },
        .{
            .id = "server/resources#010-9ef5d9",
            .page = "server/resources",
            .line = 379,
            .section = "https://",
            .anchor = "https",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "For other use cases, servers SHOULD prefer to use another URI scheme, or define a custom one, even if the server will itself be downloading resource contents over the internet.",
        },
        .{
            .id = "server/resources#011-42708a",
            .page = "server/resources",
            .line = 388,
            .section = "file://",
            .anchor = "file",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "MCP servers MAY identify file:// resources with an XDG MIME type, like `inode/directory`, to represent non-regular files (such as directories) that don\xe2\x80\x99t otherwise have a standard MIME type.",
        },
        .{
            .id = "server/resources#012-dc2c9c",
            .page = "server/resources",
            .line = 399,
            .section = "Custom URI Schemes",
            .anchor = "custom-uri-schemes",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Custom URI schemes MUST be in accordance with RFC3986, taking the above guidance in to account.",
        },
        .{
            .id = "server/resources#013-81c064",
            .page = "server/resources",
            .line = 404,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the requested resource does not exist, servers MUST return a JSON-RPC error with code `-32602` (Invalid Params).",
        },
        .{
            .id = "server/resources#014-e78a06",
            .page = "server/resources",
            .line = 404,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return `-32603` for internal errors.",
        },
        .{
            .id = "server/resources#015-7a765a",
            .page = "server/resources",
            .line = 407,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "For backwards compatibility, clients SHOULD also accept `-32002` as a resource not found error, as earlier protocol versions used this code.",
        },
        .{
            .id = "server/resources#016-22698d",
            .page = "server/resources",
            .line = 410,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT return an empty `contents` array for a non-existent resource.",
        },
        .{
            .id = "server/resources#017-aa1e73",
            .page = "server/resources",
            .line = 430,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST validate all resource URIs",
        },
        .{
            .id = "server/resources#018-079368",
            .page = "server/resources",
            .line = 431,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Access controls SHOULD be implemented for sensitive resources",
        },
        .{
            .id = "server/resources#019-50110d",
            .page = "server/resources",
            .line = 432,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Binary data MUST be properly encoded",
        },
        .{
            .id = "server/resources#020-9016d3",
            .page = "server/resources",
            .line = 433,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Resource permissions SHOULD be checked before operations",
        },
        .{
            .id = "server/resources#021-fe3997",
            .page = "server/resources",
            .line = 434,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST sanitize file paths to prevent directory traversal attacks when serving `file://` resources",
        },
        .{
            .id = "server/tools#001-8d5f8f",
            .page = "server/tools",
            .line = 13,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Every request MUST include the required `_meta` fields; see `_meta`.",
        },
        .{
            .id = "server/tools#002-8b045f",
            .page = "server/tools",
            .line = 33,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "For trust & safety and security, there SHOULD always be a human in the loop with the ability to deny tool invocations.",
        },
        .{
            .id = "server/tools#003-9d480b",
            .page = "server/tools",
            .line = 38,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Applications SHOULD: Provide UI that makes clear which tools are being exposed to the AI model",
        },
        .{
            .id = "server/tools#004-1099aa",
            .page = "server/tools",
            .line = 39,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Applications SHOULD: Insert clear visual indicators when tools are invoked",
        },
        .{
            .id = "server/tools#005-59067d",
            .page = "server/tools",
            .line = 40,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Applications SHOULD: Present confirmation prompts to the user for operations, to ensure a human is in the loop",
        },
        .{
            .id = "server/tools#006-ccd549",
            .page = "server/tools",
            .line = 47,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that support tools MUST declare the `tools` capability:",
        },
        .{
            .id = "server/tools#007-53daa4",
            .page = "server/tools",
            .line = 62,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that declare the `tools` capability MUST respond to `tools/list` requests with the set of tools currently available to the requesting client.",
        },
        .{
            .id = "server/tools#008-7814e0",
            .page = "server/tools",
            .line = 62,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must_not,
            .keywords = .{"MAY", "MUST NOT"},
            .party = .server,
            .text = "This set MAY be empty and MAY change over time (see List Changed Notification), but MUST NOT vary per-connection or as a side effect of other requests on the connection.",
        },
        .{
            .id = "server/tools#009-4e813f",
            .page = "server/tools",
            .line = 62,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The set MAY vary by the authorization presented on the request \xe2\x80\x94 for example, returning only the tools the caller's granted scopes permit \xe2\x80\x94 since credentials are per-request input, not connection state.",
        },
        .{
            .id = "server/tools#010-965d8c",
            .page = "server/tools",
            .line = 71,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return tools in a deterministic order (i.e., the same ordering across requests when the underlying set of tools has not changed).",
        },
        .{
            .id = "server/tools#011-0889f6",
            .page = "server/tools",
            .line = 176,
            .section = "Input Required Tool Results",
            .anchor = "input-required-tool-results",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY respond to `tools/call` with an `InputRequiredResult` to indicate that additional input is needed before the tool call can be completed.",
        },
        .{
            .id = "server/tools#012-93f9a1",
            .page = "server/tools",
            .line = 234,
            .section = "Input Required Tool Results",
            .anchor = "input-required-tool-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Note that the JSON-RPC `id` MUST be different between the initial request and the retry.",
        },
        .{
            .id = "server/tools#013-7ecc3c",
            .page = "server/tools",
            .line = 238,
            .section = "List Changed Notification",
            .anchor = "list-changed-notification",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When the list of available tools changes, servers that declared the `listChanged` capability SHOULD send a notification to clients that have opened a `subscriptions/listen` stream with `toolsListChanged: true`:",
        },
        .{
            .id = "server/tools#014-8fd95f",
            .page = "server/tools",
            .line = 293,
            .section = "Tool",
            .anchor = "tool",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "A tool definition includes: MUST be a valid JSON Schema object (not `null`)",
        },
        .{
            .id = "server/tools#015-666d90",
            .page = "server/tools",
            .line = 297,
            .section = "Tool",
            .anchor = "tool",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Properties MAY include an `x-mcp-header` annotation to expose parameter values as HTTP headers",
        },
        .{
            .id = "server/tools#016-e22f18",
            .page = "server/tools",
            .line = 305,
            .section = "Tool",
            .anchor = "tool",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For trust & safety and security, clients MUST consider tool annotations to be untrusted unless they come from trusted servers.",
        },
        .{
            .id = "server/tools#017-c37d16",
            .page = "server/tools",
            .line = 311,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Tool names SHOULD be between 1 and 128 characters in length (inclusive).",
        },
        .{
            .id = "server/tools#018-e56323",
            .page = "server/tools",
            .line = 312,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Tool names SHOULD be considered case-sensitive.",
        },
        .{
            .id = "server/tools#019-49087d",
            .page = "server/tools",
            .line = 313,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "The following SHOULD be the only allowed characters: uppercase and lowercase ASCII letters (A-Z, a-z), digits (0-9), underscore (_), hyphen (-), and dot (.)",
        },
        .{
            .id = "server/tools#020-dc746c",
            .page = "server/tools",
            .line = 315,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .server,
            .text = "Tool names SHOULD NOT contain spaces, commas, or other special characters.",
        },
        .{
            .id = "server/tools#021-460355",
            .page = "server/tools",
            .line = 316,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Tool names SHOULD be unique within a server.",
        },
        .{
            .id = "server/tools#022-408b67",
            .page = "server/tools",
            .line = 324,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should,
            .keywords = .{"MAY", "SHOULD"},
            .party = .client,
            .text = "Clients or proxies that aggregate tools from multiple servers MAY encounter naming collisions (for example, two servers each exposing a `search` tool) and SHOULD implement a disambiguation strategy such as prefixing tool names with a server identifier.",
        },
        .{
            .id = "server/tools#023-bf3840",
            .page = "server/tools",
            .line = 329,
            .section = "Tool Names",
            .anchor = "tool-names",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .server,
            .text = "The server `name` (from `serverInfo`) is not guaranteed to be unique across servers and SHOULD NOT be relied upon for disambiguation.",
        },
        .{
            .id = "server/tools#024-3620cf",
            .page = "server/tools",
            .line = 348,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Constraints on `x-mcp-header` values: MUST NOT be empty",
        },
        .{
            .id = "server/tools#025-7a25a1",
            .page = "server/tools",
            .line = 349,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Constraints on `x-mcp-header` values: MUST match HTTP field-name token syntax (`1*tchar`, RFC 9110 Section 5.1)",
        },
        .{
            .id = "server/tools#026-918204",
            .page = "server/tools",
            .line = 350,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Constraints on `x-mcp-header` values: MUST NOT contain control characters, including carriage return (CR, `\\r`) or line feed (LF, `\\n`)",
        },
        .{
            .id = "server/tools#027-320806",
            .page = "server/tools",
            .line = 352,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Constraints on `x-mcp-header` values: MUST be case-insensitively unique among all `x-mcp-header` values in the `inputSchema`",
        },
        .{
            .id = "server/tools#028-fdcfc9",
            .page = "server/tools",
            .line = 354,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Constraints on `x-mcp-header` values: MUST only be applied to parameters with primitive types (integer, string, boolean).",
        },
        .{
            .id = "server/tools#029-2edb6d",
            .page = "server/tools",
            .line = 354,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Integer values MUST be within the safe range for integers represented using IEEE754 double-precision floating point numbers (\xe2\x88\x922^53+1 to 2^53\xe2\x88\x921)",
        },
        .{
            .id = "server/tools#030-109915",
            .page = "server/tools",
            .line = 357,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Constraints on `x-mcp-header` values: MUST only be applied to properties that are statically reachable from the schema root, as defined in Custom Headers from Tool Parameters, which also defines how header values are extracted from call arguments",
        },
        .{
            .id = "server/tools#031-a33f54",
            .page = "server/tools",
            .line = 362,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients using the Streamable HTTP transport MUST reject tool definitions where any `x-mcp-header` value violates these constraints.",
        },
        .{
            .id = "server/tools#032-998b88",
            .page = "server/tools",
            .line = 362,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Rejection means the client MUST exclude the invalid tool from the result of `tools/list`.",
        },
        .{
            .id = "server/tools#033-a49250",
            .page = "server/tools",
            .line = 362,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD log a warning when rejecting a tool definition, including the tool name and the reason for rejection.",
        },
        .{
            .id = "server/tools#034-780a5a",
            .page = "server/tools",
            .line = 362,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients using other transports (e.g., stdio) MAY ignore `x-mcp-header` annotations entirely.",
        },
        .{
            .id = "server/tools#035-eb1c73",
            .page = "server/tools",
            .line = 399,
            .section = "x-mcp-header",
            .anchor = "x-mcp-header",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .server,
            .text = "Server developers SHOULD NOT mark sensitive parameters (passwords, API keys, tokens, PII) with `x-mcp-header`, as header values are visible to network intermediaries.",
        },
        .{
            .id = "server/tools#036-d5067d",
            .page = "server/tools",
            .line = 453,
            .section = "Resource Links",
            .anchor = "resource-links",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "A tool MAY return links to Resources, to provide additional context or data.",
        },
        .{
            .id = "server/tools#037-e08aba",
            .page = "server/tools",
            .line = 475,
            .section = "Embedded Resources",
            .anchor = "embedded-resources",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Resources MAY be embedded to provide additional context or data using a suitable URI scheme.",
        },
        .{
            .id = "server/tools#038-e618bd",
            .page = "server/tools",
            .line = 475,
            .section = "Embedded Resources",
            .anchor = "embedded-resources",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers that use embedded resources SHOULD implement the `resources` capability:",
        },
        .{
            .id = "server/tools#039-e21b19",
            .page = "server/tools",
            .line = 500,
            .section = "Structured Content",
            .anchor = "structured-content",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "For backwards compatibility, a tool that returns structured content SHOULD also return the serialized JSON in a TextContent block.",
        },
        .{
            .id = "server/tools#040-462392",
            .page = "server/tools",
            .line = 514,
            .section = "Output Schema",
            .anchor = "output-schema",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST provide structured results that conform to this schema.",
        },
        .{
            .id = "server/tools#041-c5f77f",
            .page = "server/tools",
            .line = 515,
            .section = "Output Schema",
            .anchor = "output-schema",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD validate structured results against this schema.",
        },
        .{
            .id = "server/tools#042-b0f617",
            .page = "server/tools",
            .line = 784,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY provide protocol errors to language models, though these are less likely to result in successful recovery.",
        },
        .{
            .id = "server/tools#043-6f4cc2",
            .page = "server/tools",
            .line = 784,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD provide tool execution errors to language models to enable self-correction.",
        },
        .{
            .id = "server/tools#044-bf895c",
            .page = "server/tools",
            .line = 790,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST: Validate all tool inputs",
        },
        .{
            .id = "server/tools#045-51ccd6",
            .page = "server/tools",
            .line = 791,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST: Implement proper access controls",
        },
        .{
            .id = "server/tools#046-88a982",
            .page = "server/tools",
            .line = 792,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST: Rate limit tool invocations",
        },
        .{
            .id = "server/tools#047-5dc584",
            .page = "server/tools",
            .line = 793,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST: Sanitize tool outputs",
        },
        .{
            .id = "server/tools#048-8da3c4",
            .page = "server/tools",
            .line = 796,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Prompt for user confirmation on sensitive operations",
        },
        .{
            .id = "server/tools#049-080acb",
            .page = "server/tools",
            .line = 797,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Show tool inputs to the user before calling the server, to avoid malicious or accidental data exfiltration",
        },
        .{
            .id = "server/tools#050-8395be",
            .page = "server/tools",
            .line = 799,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Validate tool results before passing to LLM",
        },
        .{
            .id = "server/tools#051-b69c23",
            .page = "server/tools",
            .line = 800,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Follow the `$ref` resolution requirements when validating tool inputs and outputs against `inputSchema` and `outputSchema`",
        },
        .{
            .id = "server/tools#052-ceeb29",
            .page = "server/tools",
            .line = 802,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Implement timeouts for tool calls",
        },
        .{
            .id = "server/tools#053-5664fd",
            .page = "server/tools",
            .line = 803,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Log tool usage for audit purposes",
        },
        .{
            .id = "server/utilities/caching#001-b94cbb",
            .page = "server/utilities/caching",
            .line = 16,
            .section = "Cacheable Results",
            .anchor = "cacheable-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include caching hints on results with `resultType: \"complete\"` returned by the following operations: `server/discover`",
        },
        .{
            .id = "server/utilities/caching#002-60f18b",
            .page = "server/utilities/caching",
            .line = 17,
            .section = "Cacheable Results",
            .anchor = "cacheable-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include caching hints on results with `resultType: \"complete\"` returned by the following operations: `tools/list`",
        },
        .{
            .id = "server/utilities/caching#003-351011",
            .page = "server/utilities/caching",
            .line = 18,
            .section = "Cacheable Results",
            .anchor = "cacheable-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include caching hints on results with `resultType: \"complete\"` returned by the following operations: `prompts/list`",
        },
        .{
            .id = "server/utilities/caching#004-5c7182",
            .page = "server/utilities/caching",
            .line = 19,
            .section = "Cacheable Results",
            .anchor = "cacheable-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include caching hints on results with `resultType: \"complete\"` returned by the following operations: `resources/list`",
        },
        .{
            .id = "server/utilities/caching#005-a9ffe0",
            .page = "server/utilities/caching",
            .line = 20,
            .section = "Cacheable Results",
            .anchor = "cacheable-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include caching hints on results with `resultType: \"complete\"` returned by the following operations: `resources/templates/list`",
        },
        .{
            .id = "server/utilities/caching#006-1e7dc0",
            .page = "server/utilities/caching",
            .line = 21,
            .section = "Cacheable Results",
            .anchor = "cacheable-results",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include caching hints on results with `resultType: \"complete\"` returned by the following operations: `resources/read`",
        },
        .{
            .id = "server/utilities/caching#007-f6ca89",
            .page = "server/utilities/caching",
            .line = 29,
            .section = "Cache Key",
            .anchor = "cache-key",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "Clients MUST NOT serve a cached response for a request whose method or parameters differ from the request that produced it.",
        },
        .{
            .id = "server/utilities/caching#008-40027d",
            .page = "server/utilities/caching",
            .line = 34,
            .section = "Cache Key",
            .anchor = "cache-key",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Results produced by retrying a request through the multi round-trip requests mechanism&mdash;that is, requests carrying `inputResponses` or `requestState`&mdash;MUST NOT be cached, as they depend on inputs that are not part of the cache key.",
        },
        .{
            .id = "server/utilities/caching#009-7de2c1",
            .page = "server/utilities/caching",
            .line = 43,
            .section = "Cacheable Model",
            .anchor = "cacheable-model",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "The Time-to-live (TTL) Field ,`ttlMs`, is an integer value in milliseconds specifying how long the client MAY consider the result fresh.",
        },
        .{
            .id = "server/utilities/caching#010-79445f",
            .page = "server/utilities/caching",
            .line = 48,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "The `ttlMs` field is a hint from the server indicating how long, in milliseconds, the client MAY consider the result fresh.",
        },
        .{
            .id = "server/utilities/caching#011-98d047",
            .page = "server/utilities/caching",
            .line = 52,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "If `ttlMs` is `0`, the response SHOULD be considered immediately stale.",
        },
        .{
            .id = "server/utilities/caching#012-f7e3a3",
            .page = "server/utilities/caching",
            .line = 52,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "The client MAY re-fetch every time the result is needed.",
        },
        .{
            .id = "server/utilities/caching#013-fb6583",
            .page = "server/utilities/caching",
            .line = 54,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If `ttlMs` is positive, the client SHOULD consider the result fresh for that many milliseconds after receiving the response.",
        },
        .{
            .id = "server/utilities/caching#014-13ee1f",
            .page = "server/utilities/caching",
            .line = 56,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If `ttlMs` is absent, clients SHOULD assume a default of `0` (immediately stale) and rely on their own caching heuristics or notifications.",
        },
        .{
            .id = "server/utilities/caching#015-62d6b1",
            .page = "server/utilities/caching",
            .line = 58,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If `ttlMs` is negative, clients SHOULD ignore it and treat it as `0`.",
        },
        .{
            .id = "server/utilities/caching#016-bd96fb",
            .page = "server/utilities/caching",
            .line = 60,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST provide a `ttlMs` value that is `>= 0`.",
        },
        .{
            .id = "server/utilities/caching#017-66632f",
            .page = "server/utilities/caching",
            .line = 63,
            .section = "Time-to-Live (TTL) Field",
            .anchor = "time-to-live-ttl-field",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY change the underlying data before the TTL expires.",
        },
        .{
            .id = "server/utilities/caching#018-4f05f9",
            .page = "server/utilities/caching",
            .line = 78,
            .section = "Freshness Calculation",
            .anchor = "freshness-calculation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Once the TTL expires, the response is stale and the client SHOULD re-fetch on next access.",
        },
        .{
            .id = "server/utilities/caching#019-cfa756",
            .page = "server/utilities/caching",
            .line = 81,
            .section = "Freshness Calculation",
            .anchor = "freshness-calculation",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .client,
            .text = "Clients SHOULD NOT treat TTL as a polling interval that triggers automatic background refetches.",
        },
        .{
            .id = "server/utilities/caching#020-7e57a4",
            .page = "server/utilities/caching",
            .line = 81,
            .section = "Freshness Calculation",
            .anchor = "freshness-calculation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations that do choose to poll MUST apply jitter and backoff.",
        },
        .{
            .id = "server/utilities/caching#021-2594e2",
            .page = "server/utilities/caching",
            .line = 86,
            .section = "Freshness Calculation",
            .anchor = "freshness-calculation",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY re-fetch before the TTL expires if they have reason to believe the data has changed (e.g., receiving an unexpected error on a tool call indicating the method was not found or the parameters were invalid).",
        },
        .{
            .id = "server/utilities/caching#022-61dfca",
            .page = "server/utilities/caching",
            .line = 90,
            .section = "Freshness Calculation",
            .anchor = "freshness-calculation",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY serve stale responses if errors occur during re-fetching (e.g., network issues, server downtime).",
        },
        .{
            .id = "server/utilities/caching#023-66854e",
            .page = "server/utilities/caching",
            .line = 100,
            .section = "Cache Scope Field",
            .anchor = "cache-scope-field",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "`\"public\"`: Any client, shared gateway, or caching proxy MAY store and serve the cached response to any user.",
        },
        .{
            .id = "server/utilities/caching#024-98bdd4",
            .page = "server/utilities/caching",
            .line = 101,
            .section = "Cache Scope Field",
            .anchor = "cache-scope-field",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "`\"private\"`: Cached responses MAY be reused for the same authorization context.",
        },
        .{
            .id = "server/utilities/caching#025-7775a2",
            .page = "server/utilities/caching",
            .line = 101,
            .section = "Cache Scope Field",
            .anchor = "cache-scope-field",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "`\"private\"`: Caches MUST NOT be shared across authorization contexts (e.g. a different access token requires a different cache).",
        },
        .{
            .id = "server/utilities/caching#026-5828bf",
            .page = "server/utilities/caching",
            .line = 114,
            .section = "Interaction with Notifications",
            .anchor = "interaction-with-notifications",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "A server MAY provide `ttlMs` without advertising `listChanged: true` in its capabilities.",
        },
        .{
            .id = "server/utilities/caching#027-225167",
            .page = "server/utilities/caching",
            .line = 116,
            .section = "Interaction with Notifications",
            .anchor = "interaction-with-notifications",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "A server MAY advertise `listChanged: true` and provide `ttlMs`.",
        },
        .{
            .id = "server/utilities/caching#028-235957",
            .page = "server/utilities/caching",
            .line = 155,
            .section = "Interaction with Pagination",
            .anchor = "interaction-with-pagination",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY return different `ttlMs` values on different pages (e.g., a longer TTL for early pages of a stable list, a shorter TTL for the final page).",
        },
        .{
            .id = "server/utilities/caching#029-abea8f",
            .page = "server/utilities/caching",
            .line = 157,
            .section = "Interaction with Pagination",
            .anchor = "interaction-with-pagination",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "When a cached page expires, the client SHOULD re-fetch that page using its cursor.",
        },
        .{
            .id = "server/utilities/caching#030-1cc448",
            .page = "server/utilities/caching",
            .line = 160,
            .section = "Interaction with Pagination",
            .anchor = "interaction-with-pagination",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients that require a consistent snapshot of the full list SHOULD re-fetch from the beginning (without a cursor).",
        },
        .{
            .id = "server/utilities/caching#031-269b9d",
            .page = "server/utilities/caching",
            .line = 162,
            .section = "Interaction with Pagination",
            .anchor = "interaction-with-pagination",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If a cursor becomes invalid (e.g., the server returns an error for a previously valid cursor), the client SHOULD discard all cached pages and re-fetch from the beginning.",
        },
        .{
            .id = "server/utilities/caching#032-54a671",
            .page = "server/utilities/caching",
            .line = 166,
            .section = "Interaction with Pagination",
            .anchor = "interaction-with-pagination",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST apply the same `cacheScope` to all response pages for a given list request.",
        },
        .{
            .id = "server/utilities/caching#033-429390",
            .page = "server/utilities/caching",
            .line = 166,
            .section = "Interaction with Pagination",
            .anchor = "interaction-with-pagination",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "For example, if the first page of a `tools/list` response has `cacheScope: \"private\"`, all subsequent pages for that request MUST also be `\"private\"`.",
        },
        .{
            .id = "server/utilities/caching#034-d81c3b",
            .page = "server/utilities/caching",
            .line = 173,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST be aware that responses with a `\"public\"` `cacheScope` may be shared between callers even if the Result is coming from an authenticated endpoint.",
        },
        .{
            .id = "server/utilities/caching#035-bf5a32",
            .page = "server/utilities/caching",
            .line = 178,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST", "MUST NOT"},
            .party = .server,
            .text = "Server implementors: MUST apply appropriate per-primitive access controls, and MUST NOT rely on `cacheScope` alone to prevent unauthorized access to primitives.",
        },
        .{
            .id = "server/utilities/completion#001-8d5f8f",
            .page = "server/utilities/completion",
            .line = 13,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Every request MUST include the required `_meta` fields; see `_meta`.",
        },
        .{
            .id = "server/utilities/completion#002-45f246",
            .page = "server/utilities/completion",
            .line = 35,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that support completions MUST declare the `completions` capability:",
        },
        .{
            .id = "server/utilities/completion#003-0eacda",
            .page = "server/utilities/completion",
            .line = 189,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return standard JSON-RPC errors for common failure cases: Method not found: `-32601` (Capability not supported)",
        },
        .{
            .id = "server/utilities/completion#004-7b0f4a",
            .page = "server/utilities/completion",
            .line = 190,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return standard JSON-RPC errors for common failure cases: Invalid prompt name: `-32602` (Invalid params)",
        },
        .{
            .id = "server/utilities/completion#005-07665b",
            .page = "server/utilities/completion",
            .line = 191,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return standard JSON-RPC errors for common failure cases: Missing required arguments: `-32602` (Invalid params)",
        },
        .{
            .id = "server/utilities/completion#006-27fb2c",
            .page = "server/utilities/completion",
            .line = 192,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return standard JSON-RPC errors for common failure cases: Internal errors: `-32603` (Internal error)",
        },
        .{
            .id = "server/utilities/completion#007-d25c15",
            .page = "server/utilities/completion",
            .line = 197,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Return suggestions sorted by relevance",
        },
        .{
            .id = "server/utilities/completion#008-b9c1b3",
            .page = "server/utilities/completion",
            .line = 198,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Implement fuzzy matching where appropriate",
        },
        .{
            .id = "server/utilities/completion#009-b4fc19",
            .page = "server/utilities/completion",
            .line = 199,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Rate limit completion requests",
        },
        .{
            .id = "server/utilities/completion#010-875e58",
            .page = "server/utilities/completion",
            .line = 200,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Validate all inputs",
        },
        .{
            .id = "server/utilities/completion#011-57baa8",
            .page = "server/utilities/completion",
            .line = 203,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Debounce rapid completion requests",
        },
        .{
            .id = "server/utilities/completion#012-a0a598",
            .page = "server/utilities/completion",
            .line = 204,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Cache completion results where appropriate",
        },
        .{
            .id = "server/utilities/completion#013-12f248",
            .page = "server/utilities/completion",
            .line = 205,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Handle missing or partial results gracefully",
        },
        .{
            .id = "server/utilities/completion#014-6f9406",
            .page = "server/utilities/completion",
            .line = 211,
            .section = "Security",
            .anchor = "security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations MUST: Validate all completion inputs",
        },
        .{
            .id = "server/utilities/completion#015-00084c",
            .page = "server/utilities/completion",
            .line = 212,
            .section = "Security",
            .anchor = "security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations MUST: Implement appropriate rate limiting",
        },
        .{
            .id = "server/utilities/completion#016-4271ec",
            .page = "server/utilities/completion",
            .line = 213,
            .section = "Security",
            .anchor = "security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations MUST: Control access to sensitive suggestions",
        },
        .{
            .id = "server/utilities/completion#017-67353d",
            .page = "server/utilities/completion",
            .line = 214,
            .section = "Security",
            .anchor = "security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations MUST: Prevent completion-based information disclosure",
        },
        .{
            .id = "server/utilities/logging#001-734361",
            .page = "server/utilities/logging",
            .line = 8,
            .section = "",
            .anchor = "",
            .level = .should_not,
            .keywords = .{"SHOULD NOT", "SHOULD"},
            .party = .both,
            .text = "New implementations SHOULD NOT adopt it; existing implementations SHOULD migrate to logging to `stderr` for stdio transports, or to OpenTelemetry for structured observability.",
        },
        .{
            .id = "server/utilities/logging#002-9b05a3",
            .page = "server/utilities/logging",
            .line = 32,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that emit log message notifications MUST declare the `logging` capability:",
        },
        .{
            .id = "server/utilities/logging#003-18f800",
            .page = "server/utilities/logging",
            .line = 62,
            .section = "Per-request log level",
            .anchor = "per-request-log-level",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The server MUST NOT emit `notifications/message` for a request that does not include this field.",
        },
        .{
            .id = "server/utilities/logging#004-7eb04d",
            .page = "server/utilities/logging",
            .line = 66,
            .section = "Per-request log level",
            .anchor = "per-request-log-level",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "When the field is present, the server MAY send `notifications/message` notifications at or above the requested level on the response stream of that request, before the final response.",
        },
        .{
            .id = "server/utilities/logging#005-a9e84b",
            .page = "server/utilities/logging",
            .line = 66,
            .section = "Per-request log level",
            .anchor = "per-request-log-level",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "`notifications/message` is request-scoped: the server MUST NOT deliver it on a `subscriptions/listen` stream or on any stream other than the one carrying the response to the request that set the log level.",
        },
        .{
            .id = "server/utilities/logging#006-d931a4",
            .page = "server/utilities/logging",
            .line = 104,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "If the `io.modelcontextprotocol/logLevel` value carried in a request's `_meta` is not a recognized log level, the server SHOULD reject that request with a standard JSON-RPC error: Invalid log level: `-32602` (Invalid params)",
        },
        .{
            .id = "server/utilities/logging#007-738605",
            .page = "server/utilities/logging",
            .line = 105,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "If the `io.modelcontextprotocol/logLevel` value carried in a request's `_meta` is not a recognized log level, the server SHOULD reject that request with a standard JSON-RPC error: Internal errors: `-32603` (Internal error)",
        },
        .{
            .id = "server/utilities/logging#008-d3a04d",
            .page = "server/utilities/logging",
            .line = 110,
            .section = "Implementation Considerations",
            .anchor = "implementation-considerations",
            .level = .should,
