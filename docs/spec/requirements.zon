            .line = 276,
            .section = "Resource Links",
            .anchor = "resource-links",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Prompt messages MAY include links to Resources, to provide additional context or data without embedding the resource contents directly.",
        },
