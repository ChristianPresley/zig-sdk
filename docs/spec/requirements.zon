            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that declare the `resources` capability MUST respond to `resources/list` requests with the set of resources currently available to the requesting client.",
        },
        .{
            .id = "server/resources#004-7814e0",
            .page = "server/resources",
            .line = 74,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must_not,
            .keywords = .{"MAY", "MUST NOT"},
            .party = .server,
            .text = "This set MAY be empty and MAY change over time (see List Changed Notification), but MUST NOT vary per-connection or as a side effect of other requests on the connection.",
        },
        .{
