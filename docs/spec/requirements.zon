    .requirements = .{
        .{
            .id = "basic/authorization/authorization-server-discovery#001-3cb045",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 13,
            .section = "Authorization Server Location",
            .anchor = "authorization-server-location",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST implement the OAuth 2.0 Protected Resource Metadata (RFC9728) specification to indicate the locations of authorization servers.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#002-fdbecb",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 13,
            .section = "Authorization Server Location",
            .anchor = "authorization-server-location",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "The Protected Resource Metadata document returned by the MCP server MUST include the `authorization_servers` field containing at least one authorization server.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#003-bec089",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 27,
            .section = "Authorization Server Location",
            .anchor = "authorization-server-location",
            .level = .must,
            .keywords = .{"MUST", "MUST NOT"},
            .party = .client,
            .text = "Clients MUST maintain separate registration state (client credentials, tokens) per authorization server and MUST NOT assume that credentials valid for one authorization server will be accepted by another.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#004-e296db",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 41,
            .section = "Protected Resource Metadata Discovery Requirements",
            .anchor = "protected-resource-metadata-discovery-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST implement one of the following discovery mechanisms to provide authorization server location information to MCP clients: WWW-Authenticate Header: Include the resource metadata URL in the `WWW-Authenticate` HTTP header under `resource_metadata` when returning `401 Unauthorized` responses, as described in RFC9728 Section 5.1.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#005-07b364",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 43,
            .section = "Protected Resource Metadata Discovery Requirements",
            .anchor = "protected-resource-metadata-discovery-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST implement one of the following discovery mechanisms to provide authorization server location information to MCP clients: Well-Known URI: Serve metadata at a well-known URI as specified in RFC9728.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#006-7b3f9c",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 47,
            .section = "Protected Resource Metadata Discovery Requirements",
            .anchor = "protected-resource-metadata-discovery-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST support both discovery mechanisms and use the resource metadata URL from the parsed `WWW-Authenticate` headers when present; otherwise, they MUST fall back to constructing and requesting the well-known URIs in the order listed above.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#007-306b0f",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 49,
            .section = "Protected Resource Metadata Discovery Requirements",
            .anchor = "protected-resource-metadata-discovery-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST be able to parse `WWW-Authenticate` headers and respond appropriately to `HTTP 401 Unauthorized` responses from the MCP server.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#008-7a2391",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 63,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "To handle different issuer URL formats and ensure interoperability with both OAuth 2.0 Authorization Server Metadata and OpenID Connect Discovery 1.0 specifications, MCP clients MUST attempt multiple well-known endpoints when discovering authorization server metadata.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#009-0199fa",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 79,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For issuer URLs with path components (e.g., `https://auth.example.com/tenant1`), clients MUST try endpoints in the following priority order: OAuth 2.0 Authorization Server Metadata with path insertion: `https://auth.example.com/.well-known/oauth-authorization-server/tenant1`",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#010-2f643d",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 81,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For issuer URLs with path components (e.g., `https://auth.example.com/tenant1`), clients MUST try endpoints in the following priority order: OpenID Connect Discovery 1.0 with path insertion: `https://auth.example.com/.well-known/openid-configuration/tenant1`",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#011-139a23",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 83,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For issuer URLs with path components (e.g., `https://auth.example.com/tenant1`), clients MUST try endpoints in the following priority order: OpenID Connect Discovery 1.0 path appending: `https://auth.example.com/tenant1/.well-known/openid-configuration`",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#012-45aa38",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 89,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For issuer URLs without path components (e.g., `https://auth.example.com`), clients MUST try: OAuth 2.0 Authorization Server Metadata: `https://auth.example.com/.well-known/oauth-authorization-server`",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#013-ce9c0e",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 91,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For issuer URLs without path components (e.g., `https://auth.example.com`), clients MUST try: OpenID Connect Discovery 1.0: `https://auth.example.com/.well-known/openid-configuration`",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#014-25f4f1",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 94,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "After retrieving a metadata document, MCP clients MUST validate it as required by RFC8414 Section 3.3 or OpenID Connect Discovery Section 4.3: the `issuer` value in the document MUST be identical to the issuer identifier used to construct the well-known URL.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#015-87796f",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 94,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "If they differ, the client MUST NOT use the metadata.",
        },
        .{
            .id = "basic/authorization/authorization-server-discovery#016-519ccd",
            .page = "basic/authorization/authorization-server-discovery",
            .line = 94,
            .section = "Authorization Server Metadata Discovery",
            .anchor = "authorization-server-metadata-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "For example, a document fetched from `https://attacker.example/.well-known/oauth-authorization-server` that contains `\"issuer\": \"https://honest.example\"` MUST be rejected.",
        },
        .{
            .id = "basic/authorization/client-registration#001-ddabcf",
            .page = "basic/authorization/client-registration",
            .line = 15,
            .section = "",
            .anchor = "",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients supporting all options SHOULD use the following priority order: Use pre-registered client information for the server if the client has it available",
        },
        .{
            .id = "basic/authorization/client-registration#002-f566f8",
            .page = "basic/authorization/client-registration",
            .line = 16,
            .section = "",
            .anchor = "",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients supporting all options SHOULD use the following priority order: Use Client ID Metadata Documents if the Authorization Server indicates that it supports them (via `client_id_metadata_document_supported` in OAuth Authorization Server Metadata)",
        },
        .{
            .id = "basic/authorization/client-registration#003-19e9a0",
            .page = "basic/authorization/client-registration",
            .line = 17,
            .section = "",
            .anchor = "",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients supporting all options SHOULD use the following priority order: Use Dynamic Client Registration as a fallback if the Authorization Server supports it (via `registration_endpoint` in OAuth Authorization Server Metadata)",
        },
        .{
            .id = "basic/authorization/client-registration#004-914195",
            .page = "basic/authorization/client-registration",
            .line = 18,
            .section = "",
            .anchor = "",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients supporting all options SHOULD use the following priority order: Prompt the user to enter the client information if no other option is available",
        },
        .{
            .id = "basic/authorization/client-registration#005-e2964f",
            .page = "basic/authorization/client-registration",
            .line = 22,
            .section = "Client ID Metadata Documents",
            .anchor = "client-id-metadata-documents",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "MCP clients and authorization servers SHOULD support OAuth Client ID Metadata Documents as specified in OAuth Client ID Metadata Document for client registration.",
        },
        .{
            .id = "basic/authorization/client-registration#006-c0308c",
            .page = "basic/authorization/client-registration",
            .line = 32,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "MCP implementations supporting Client ID Metadata Documents MUST follow the requirements specified in OAuth Client ID Metadata Document.",
        },
        .{
            .id = "basic/authorization/client-registration#007-274d15",
            .page = "basic/authorization/client-registration",
            .line = 38,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST host their metadata document at an HTTPS URL following RFC requirements",
        },
        .{
            .id = "basic/authorization/client-registration#008-807408",
            .page = "basic/authorization/client-registration",
            .line = 39,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The `client_id` URL MUST use the \"https\" scheme and contain a path component, e.g. `https://example.com/client.json`",
        },
        .{
            .id = "basic/authorization/client-registration#009-a80226",
            .page = "basic/authorization/client-registration",
            .line = 40,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The metadata document MUST include at least the following properties: `client_id`, `client_name`, `redirect_uris`",
        },
        .{
            .id = "basic/authorization/client-registration#010-16562a",
            .page = "basic/authorization/client-registration",
            .line = 41,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST ensure the `client_id` value in the metadata matches the document URL exactly",
        },
        .{
            .id = "basic/authorization/client-registration#011-6739be",
            .page = "basic/authorization/client-registration",
            .line = 42,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY use `private_key_jwt` for client authentication (e.g., for requests to the token endpoint) with appropriate JWKS configuration as described in Section 6.2 of Client ID Metadata Document",
        },
        .{
            .id = "basic/authorization/client-registration#012-8c6382",
            .page = "basic/authorization/client-registration",
            .line = 46,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "For Authorization Servers: SHOULD fetch metadata documents when encountering URL-formatted client_ids",
        },
        .{
            .id = "basic/authorization/client-registration#013-b65a58",
            .page = "basic/authorization/client-registration",
            .line = 47,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "For Authorization Servers: MUST validate that the fetched document's `client_id` matches the URL exactly",
        },
        .{
            .id = "basic/authorization/client-registration#014-2f4c4c",
            .page = "basic/authorization/client-registration",
            .line = 48,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "For Authorization Servers: SHOULD cache metadata respecting HTTP cache headers",
        },
        .{
            .id = "basic/authorization/client-registration#015-13abde",
            .page = "basic/authorization/client-registration",
            .line = 49,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "For Authorization Servers: MUST validate redirect URIs presented in an authorization request against those in the metadata document",
        },
        .{
            .id = "basic/authorization/client-registration#016-9f5d63",
            .page = "basic/authorization/client-registration",
            .line = 50,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "For Authorization Servers: MUST validate the document structure is valid JSON and contains required fields",
        },
        .{
            .id = "basic/authorization/client-registration#017-aadfbc",
            .page = "basic/authorization/client-registration",
            .line = 51,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "For Authorization Servers: SHOULD follow the security considerations in Section 6 of Client ID Metadata Document and in Client ID Metadata Document Security",
        },
        .{
            .id = "basic/authorization/client-registration#018-b6692e",
            .page = "basic/authorization/client-registration",
            .line = 124,
            .section = "Advertising CIMD Support",
            .anchor = "advertising-cimd-support",
            .level = .should,
            .keywords = .{"SHOULD", "MAY"},
            .party = .client,
            .text = "MCP clients SHOULD check for this capability and MAY fall back to Dynamic Client Registration or pre-registration if unavailable.",
        },
        .{
            .id = "basic/authorization/client-registration#019-e73da8",
            .page = "basic/authorization/client-registration",
            .line = 130,
            .section = "Pre-registration",
            .anchor = "pre-registration",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "MCP clients SHOULD support an option for static client credentials such as those supplied by a pre-registration flow.",
        },
        .{
            .id = "basic/authorization/client-registration#020-716332",
            .page = "basic/authorization/client-registration",
            .line = 147,
            .section = "Dynamic Client Registration",
            .anchor = "dynamic-client-registration",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "MCP clients and authorization servers MAY support the OAuth 2.0 Dynamic Client Registration Protocol RFC7591 to allow MCP clients to obtain OAuth client IDs without user interaction.",
        },
        .{
            .id = "basic/authorization/client-registration#021-abc98d",
            .page = "basic/authorization/client-registration",
            .line = 160,
            .section = "Application Type and Redirect URI Constraints",
            .anchor = "application-type-and-redirect-uri-constraints",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST specify an appropriate `application_type` during Dynamic Client Registration.",
        },
        .{
            .id = "basic/authorization/client-registration#022-077c8a",
            .page = "basic/authorization/client-registration",
            .line = 165,
            .section = "Application Type and Redirect URI Constraints",
            .anchor = "application-type-and-redirect-uri-constraints",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Native applications (desktop applications, mobile apps, CLI tools, and locally-hosted web applications accessed via `localhost`) SHOULD use `application_type: \"native\"`",
        },
        .{
            .id = "basic/authorization/client-registration#023-a0dc65",
            .page = "basic/authorization/client-registration",
            .line = 168,
            .section = "Application Type and Redirect URI Constraints",
            .anchor = "application-type-and-redirect-uri-constraints",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Web applications (remote browser-based applications served from a non-local host) SHOULD use `application_type: \"web\"`",
        },
        .{
            .id = "basic/authorization/client-registration#024-83ff62",
            .page = "basic/authorization/client-registration",
            .line = 172,
            .section = "Application Type and Redirect URI Constraints",
            .anchor = "application-type-and-redirect-uri-constraints",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST be prepared to handle registration failures due to redirect URI constraints when authorization servers implement OIDC.",
        },
        .{
            .id = "basic/authorization/client-registration#025-823ee2",
            .page = "basic/authorization/client-registration",
            .line = 172,
            .section = "Application Type and Redirect URI Constraints",
            .anchor = "application-type-and-redirect-uri-constraints",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "When a registration request is rejected, clients SHOULD surface a meaningful error to the user or developer.",
        },
        .{
            .id = "basic/authorization/client-registration#026-1bbfbc",
            .page = "basic/authorization/client-registration",
            .line = 172,
            .section = "Application Type and Redirect URI Constraints",
            .anchor = "application-type-and-redirect-uri-constraints",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY retry registration with an adjusted `application_type` or with redirect URIs that conform to the authorization server's requirements for the given application type.",
        },
        .{
            .id = "basic/authorization/client-registration#027-242409",
            .page = "basic/authorization/client-registration",
            .line = 183,
            .section = "Authorization Server Binding",
            .anchor = "authorization-server-binding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients that use pre-registered credentials, or persist client credentials obtained via Dynamic Client Registration, MUST associate those credentials with the specific authorization server that issued them, keyed by the authorization server's `issuer` identifier.",
        },
        .{
            .id = "basic/authorization/client-registration#028-e7ba6f",
            .page = "basic/authorization/client-registration",
            .line = 183,
            .section = "Authorization Server Binding",
            .anchor = "authorization-server-binding",
            .level = .must_not,
            .keywords = .{"MUST NOT", "MUST"},
            .party = .client,
            .text = "When the authorization server changes (detected via updated protected resource metadata), clients MUST NOT reuse client credentials from a different authorization server and MUST re-register with the new authorization server.",
        },
        .{
            .id = "basic/authorization/client-registration#029-776f2c",
            .page = "basic/authorization/client-registration",
            .line = 193,
            .section = "Authorization Server Binding",
            .anchor = "authorization-server-binding",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If the authorization server indicated by protected resource metadata no longer matches the one the credentials were registered with, clients SHOULD surface an error rather than silently attempting to use mismatched credentials.",
        },
        .{
            .id = "basic/authorization#001-33415a",
            .page = "basic/authorization",
            .line = 18,
            .section = "Protocol Requirements",
            .anchor = "protocol-requirements",
            .level = .may,
            .keywords = .{"OPTIONAL"},
            .party = .both,
            .text = "Authorization is OPTIONAL for MCP implementations.",
        },
        .{
            .id = "basic/authorization#002-55e7ce",
            .page = "basic/authorization",
            .line = 20,
            .section = "Protocol Requirements",
            .anchor = "protocol-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Implementations using an HTTP-based transport SHOULD conform to this specification.",
        },
        .{
            .id = "basic/authorization#003-52eaed",
            .page = "basic/authorization",
            .line = 21,
            .section = "Protocol Requirements",
            .anchor = "protocol-requirements",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .both,
            .text = "Implementations using an STDIO transport SHOULD NOT follow this specification, and instead retrieve credentials from the environment.",
        },
        .{
            .id = "basic/authorization#004-a5409e",
            .page = "basic/authorization",
            .line = 23,
            .section = "Protocol Requirements",
            .anchor = "protocol-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations using alternative transports MUST follow established security best practices for their protocol.",
        },
        .{
            .id = "basic/authorization#005-be0180",
            .page = "basic/authorization",
            .line = 62,
            .section = "Overview",
            .anchor = "overview",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "Authorization servers MUST implement OAuth 2.1 with appropriate security measures for both confidential and public clients.",
        },
        .{
            .id = "basic/authorization#006-103d81",
            .page = "basic/authorization",
            .line = 65,
            .section = "Overview",
            .anchor = "overview",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Authorization servers and MCP clients SHOULD support OAuth Client ID Metadata Documents (draft-ietf-oauth-client-id-metadata-document-00).",
        },
        .{
            .id = "basic/authorization#007-63de29",
            .page = "basic/authorization",
            .line = 68,
            .section = "Overview",
            .anchor = "overview",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Authorization servers and MCP clients MAY support the OAuth 2.0 Dynamic Client Registration Protocol (RFC7591).",
        },
        .{
            .id = "basic/authorization#008-15cf12",
            .page = "basic/authorization",
            .line = 73,
            .section = "Overview",
            .anchor = "overview",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST implement OAuth 2.0 Protected Resource Metadata (RFC9728).",
        },
        .{
            .id = "basic/authorization#009-4d66f7",
            .page = "basic/authorization",
            .line = 73,
            .section = "Overview",
            .anchor = "overview",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST use OAuth 2.0 Protected Resource Metadata for authorization server discovery.",
        },
        .{
            .id = "basic/authorization#010-38796e",
            .page = "basic/authorization",
            .line = 77,
            .section = "Overview",
            .anchor = "overview",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "MCP authorization servers MUST provide at least one of the following discovery mechanisms: OAuth 2.0 Authorization Server Metadata (RFC8414)",
        },
        .{
            .id = "basic/authorization#011-0ec528",
            .page = "basic/authorization",
            .line = 78,
            .section = "Overview",
            .anchor = "overview",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "MCP authorization servers MUST provide at least one of the following discovery mechanisms: OpenID Connect Discovery 1.0",
        },
        .{
            .id = "basic/authorization#012-0e707a",
            .page = "basic/authorization",
            .line = 80,
            .section = "Overview",
            .anchor = "overview",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST support both discovery mechanisms to obtain the information required to interact with the authorization server.",
        },
        .{
            .id = "basic/authorization#013-fadf86",
            .page = "basic/authorization",
            .line = 84,
            .section = "Authorization Server Discovery",
            .anchor = "authorization-server-discovery",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations MUST follow the normative discovery requirements defined in Authorization Server Discovery.",
        },
        .{
            .id = "basic/authorization#014-e66bad",
            .page = "basic/authorization",
            .line = 92,
            .section = "Client Registration",
            .anchor = "client-registration",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Before initiating the authorization flow, MCP clients MUST obtain a client ID through one of three registration mechanisms: Client ID Metadata Documents, pre-registration, or Dynamic Client Registration, following the requirements and selection priority defined in Client Registration.",
        },
        .{
            .id = "basic/authorization#015-c238df",
            .page = "basic/authorization",
            .line = 99,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "MCP servers SHOULD include a `scope` parameter in the `WWW-Authenticate` header as defined in RFC 6750 Section 3 to indicate the scopes required for accessing the resource.",
        },
        .{
            .id = "basic/authorization#016-c10fcb",
            .page = "basic/authorization",
            .line = 105,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The scopes included in the `WWW-Authenticate` challenge MAY match `scopes_supported`, be a subset or superset of it, or an alternative collection that is neither a strict subset nor superset.",
        },
        .{
            .id = "basic/authorization#017-6b4a26",
            .page = "basic/authorization",
            .line = 105,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "Clients MUST NOT assume any particular set relationship between the challenged scope set and `scopes_supported`.",
        },
        .{
            .id = "basic/authorization#018-d28691",
            .page = "basic/authorization",
            .line = 105,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST treat the scopes provided in the challenge as authoritative for the current operation.",
        },
        .{
            .id = "basic/authorization#019-caf8b2",
            .page = "basic/authorization",
            .line = 105,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "When re-authorizing, clients SHOULD include these scopes alongside any previously granted scopes to avoid losing permissions needed for other operations (see Step-Up Authorization Flow).",
        },
        .{
            .id = "basic/authorization#020-1659de",
            .page = "basic/authorization",
            .line = 105,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD strive for consistency in how they construct scope sets but they are not required to surface every dynamically issued scope through `scopes_supported`.",
        },
        .{
            .id = "basic/authorization#021-8a1d74",
            .page = "basic/authorization",
            .line = 124,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "When implementing authorization flows, MCP clients SHOULD follow the principle of least privilege by requesting only the scopes necessary for their intended operations.",
        },
        .{
            .id = "basic/authorization#022-bdced4",
            .page = "basic/authorization",
            .line = 128,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "During the initial authorization handshake, MCP clients SHOULD follow this priority order for scope selection: Use `scope` parameter from the initial `WWW-Authenticate` header in the 401 response, if provided",
        },
        .{
            .id = "basic/authorization#023-e52488",
            .page = "basic/authorization",
            .line = 129,
            .section = "Scope Selection Strategy",
            .anchor = "scope-selection-strategy",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "During the initial authorization handshake, MCP clients SHOULD follow this priority order for scope selection: If `scope` is not available, use all scopes defined in `scopes_supported` from the Protected Resource Metadata document, omitting the `scope` parameter if `scopes_supported` is undefined.",
        },
        .{
            .id = "basic/authorization#024-697778",
            .page = "basic/authorization",
            .line = 192,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Before redirecting the user-agent, the client MUST record the `issuer` value from the selected authorization server's validated metadata document (see Authorization Server Metadata Discovery) and associate it with the same per-request record used to store the PKCE code verifier (and the `state` value, if used).",
        },
        .{
            .id = "basic/authorization#025-40fa10",
            .page = "basic/authorization",
            .line = 194,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "MCP authorization servers SHOULD include the `iss` parameter in authorization responses, including error responses, as defined in RFC9207 Section 2.",
        },
        .{
            .id = "basic/authorization#026-248374",
            .page = "basic/authorization",
            .line = 194,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "Authorization servers that include the `iss` parameter MUST advertise this by setting `authorization_response_iss_parameter_supported` to `true` in their metadata (RFC9207 Section 2.3).",
        },
        .{
            .id = "basic/authorization#027-0870de",
            .page = "basic/authorization",
            .line = 196,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "On receiving the authorization response, MCP clients MUST apply the validation in RFC9207 Section 2.4 before transmitting the authorization code to any token endpoint:",
        },
        .{
            .id = "basic/authorization#028-b7b835",
            .page = "basic/authorization",
            .line = 209,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .must,
            .keywords = .{"SHOULD", "MUST"},
            .party = .authorization_server,
            .text = "A future revision of this specification is expected to upgrade authorization server inclusion of `iss` from SHOULD to MUST.",
        },
        .{
            .id = "basic/authorization#029-7a1e7a",
            .page = "basic/authorization",
            .line = 211,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "After decoding the `iss` value from the `application/x-www-form-urlencoded` response per RFC 9207 Section 2.4, clients MUST NOT apply scheme or host case folding, default-port elision, trailing-slash, or percent-encoding normalization (RFC 3986 Sections 6.2.2-6.2.3) before comparison.",
        },
        .{
            .id = "basic/authorization#030-e50055",
            .page = "basic/authorization",
            .line = 213,
            .section = "Authorization Response Validation",
            .anchor = "authorization-response-validation",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "This validation applies equally to error responses - on mismatch the client MUST NOT act on or display `error`, `error_description`, or `error_uri`.",
        },
        .{
            .id = "basic/authorization#031-45decc",
            .page = "basic/authorization",
            .line = 217,
            .section = "Resource Parameter Implementation",
            .anchor = "resource-parameter-implementation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST implement Resource Indicators for OAuth 2.0 as defined in RFC 8707 to explicitly specify the target resource for which the token is being requested.",
        },
        .{
            .id = "basic/authorization#032-c48b81",
            .page = "basic/authorization",
            .line = 220,
            .section = "Resource Parameter Implementation",
            .anchor = "resource-parameter-implementation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The `resource` parameter: MUST be included in both authorization requests and token requests.",
        },
        .{
            .id = "basic/authorization#033-48a3a4",
            .page = "basic/authorization",
            .line = 221,
            .section = "Resource Parameter Implementation",
            .anchor = "resource-parameter-implementation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The `resource` parameter: MUST identify the MCP server that the client intends to use the token with.",
        },
        .{
            .id = "basic/authorization#034-2f75d9",
            .page = "basic/authorization",
            .line = 222,
            .section = "Resource Parameter Implementation",
            .anchor = "resource-parameter-implementation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The `resource` parameter: MUST use the canonical URI of the MCP server as defined in RFC 8707 Section 2.",
        },
        .{
            .id = "basic/authorization#035-d35bce",
            .page = "basic/authorization",
            .line = 230,
            .section = "Canonical Server URI",
            .anchor = "canonical-server-uri",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "MCP clients SHOULD provide the most specific URI that they can for the MCP server they intend to access, following the guidance in RFC 8707.",
        },
        .{
            .id = "basic/authorization#036-d4a300",
            .page = "basic/authorization",
            .line = 230,
            .section = "Canonical Server URI",
            .anchor = "canonical-server-uri",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "While the canonical form uses lowercase scheme and host components, implementations SHOULD accept uppercase scheme and host components for robustness and interoperability.",
        },
        .{
            .id = "basic/authorization#037-85aada",
            .page = "basic/authorization",
            .line = 244,
            .section = "Canonical Server URI",
            .anchor = "canonical-server-uri",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Note: While both `https://mcp.example.com/` (with trailing slash) and `https://mcp.example.com` (without trailing slash) are technically valid absolute URIs according to RFC 3986, implementations SHOULD consistently use the form without the trailing slash for better interoperability unless the trailing slash is semantically significant for the specific resource.",
        },
        .{
            .id = "basic/authorization#038-97c806",
            .page = "basic/authorization",
            .line = 252,
            .section = "Canonical Server URI",
            .anchor = "canonical-server-uri",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST send this parameter regardless of whether authorization servers support it.",
        },
        .{
            .id = "basic/authorization#039-ba16b4",
            .page = "basic/authorization",
            .line = 258,
            .section = "Token Requirements",
            .anchor = "token-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Access token handling when making requests to MCP servers MUST conform to the requirements defined in OAuth 2.1 Section 5 \"Resource Requests\".",
        },
        .{
            .id = "basic/authorization#040-579236",
            .page = "basic/authorization",
            .line = 262,
            .section = "Token Requirements",
            .anchor = "token-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP client MUST use the Authorization request header field defined in OAuth 2.1 Section 5.1.1:",
        },
        .{
            .id = "basic/authorization#041-93a522",
            .page = "basic/authorization",
            .line = 269,
            .section = "Token Requirements",
            .anchor = "token-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Note that authorization MUST be included in every HTTP request from client to server.",
        },
        .{
            .id = "basic/authorization#042-5545d0",
            .page = "basic/authorization",
            .line = 271,
            .section = "Token Requirements",
            .anchor = "token-requirements",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Access tokens MUST NOT be included in the URI query string",
        },
        .{
            .id = "basic/authorization#043-ddbb48",
            .page = "basic/authorization",
            .line = 283,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers, acting in their role as an OAuth 2.1 resource server, MUST validate access tokens as described in OAuth 2.1 Section 5.2.",
        },
        .{
            .id = "basic/authorization#044-ffdbb4",
            .page = "basic/authorization",
            .line = 283,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST validate that access tokens were issued specifically for them as the intended audience, according to RFC 8707 Section 2.",
        },
        .{
            .id = "basic/authorization#045-b31c92",
            .page = "basic/authorization",
            .line = 283,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If validation fails, servers MUST respond according to OAuth 2.1 Section 5.3 error handling requirements.",
        },
        .{
            .id = "basic/authorization#046-4558ad",
            .page = "basic/authorization",
            .line = 283,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Invalid or expired tokens MUST receive a HTTP 401 response.",
        },
        .{
            .id = "basic/authorization#047-f243c9",
            .page = "basic/authorization",
            .line = 292,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "MCP clients MUST NOT send tokens to the MCP server other than ones issued by the MCP server's authorization server.",
        },
        .{
            .id = "basic/authorization#048-772a89",
            .page = "basic/authorization",
            .line = 294,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST only accept tokens that are valid for use with their own resources.",
        },
        .{
            .id = "basic/authorization#049-6cd185",
            .page = "basic/authorization",
            .line = 297,
            .section = "Token Handling",
            .anchor = "token-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "MCP servers MUST NOT accept or transit any other tokens.",
        },
        .{
            .id = "basic/authorization#050-ff46d9",
            .page = "basic/authorization",
            .line = 306,
            .section = "Refresh Tokens",
            .anchor = "refresh-tokens",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP Clients that desire refresh tokens: MUST keep refresh tokens confidential in transit and storage as specified in OAuth 2.1 Section 4.3",
        },
        .{
            .id = "basic/authorization#051-758e10",
            .page = "basic/authorization",
            .line = 307,
            .section = "Refresh Tokens",
            .anchor = "refresh-tokens",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "MCP Clients that desire refresh tokens: SHOULD include `refresh_token` in their `grant_types` client metadata",
        },
        .{
            .id = "basic/authorization#052-744765",
            .page = "basic/authorization",
            .line = 308,
            .section = "Refresh Tokens",
            .anchor = "refresh-tokens",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "MCP Clients that desire refresh tokens: MAY add `offline_access` to the `scope` parameter of the authorization and token requests when the Authorization Server metadata contains it in `scopes_supported`",
        },
        .{
            .id = "basic/authorization#053-20b979",
            .page = "basic/authorization",
            .line = 309,
            .section = "Refresh Tokens",
            .anchor = "refresh-tokens",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "MCP Clients that desire refresh tokens: MUST NOT assume refresh tokens will be issued; the AS retains discretion",
        },
        .{
            .id = "basic/authorization#054-68e0a1",
            .page = "basic/authorization",
            .line = 311,
            .section = "Refresh Tokens",
            .anchor = "refresh-tokens",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .server,
            .text = "MCP Servers (Protected Resources) SHOULD NOT include `offline_access` in `WWW-Authenticate` scope or Protected Resource Metadata `scopes_supported`, as refresh tokens are not a resource requirement.",
        },
        .{
            .id = "basic/authorization#055-f19141",
            .page = "basic/authorization",
            .line = 317,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST return appropriate HTTP status codes for authorization errors:",
        },
        .{
            .id = "basic/authorization#056-0ae4ff",
            .page = "basic/authorization",
            .line = 337,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When a client makes a request with an access token with insufficient scope during runtime operations, the server SHOULD respond with: `HTTP 403 Forbidden` status code (per RFC 6750 Section 3.1)",
        },
        .{
            .id = "basic/authorization#057-3eefdc",
            .page = "basic/authorization",
            .line = 339,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When a client makes a request with an access token with insufficient scope during runtime operations, the server SHOULD respond with: `WWW-Authenticate` header with the `Bearer` scheme and additional parameters: `error=\"insufficient_scope\"` - indicating the specific type of authorization failure",
        },
        .{
            .id = "basic/authorization#058-491e49",
            .page = "basic/authorization",
            .line = 340,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When a client makes a request with an access token with insufficient scope during runtime operations, the server SHOULD respond with: `WWW-Authenticate` header with the `Bearer` scheme and additional parameters: `scope=\"required_scope1 required_scope2\"` - specifying the minimum scopes needed for the operation",
        },
        .{
            .id = "basic/authorization#059-5afcb7",
            .page = "basic/authorization",
            .line = 341,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When a client makes a request with an access token with insufficient scope during runtime operations, the server SHOULD respond with: `WWW-Authenticate` header with the `Bearer` scheme and additional parameters: `resource_metadata` - the URI of the Protected Resource Metadata document (for consistency with 401 responses)",
        },
        .{
            .id = "basic/authorization#060-109ee2",
            .page = "basic/authorization",
            .line = 342,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When a client makes a request with an access token with insufficient scope during runtime operations, the server SHOULD respond with: `WWW-Authenticate` header with the `Bearer` scheme and additional parameters: `error_description` (optional) - human-readable description of the error",
        },
        .{
            .id = "basic/authorization#061-a1dfff",
            .page = "basic/authorization",
            .line = 344,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Server Scope Management: When responding with insufficient scope errors, servers SHOULD include the scopes needed to satisfy the current operation in the `scope` parameter, consistent with RFC 6750 Section 3.1.",
        },
        .{
            .id = "basic/authorization#062-f9d06f",
            .page = "basic/authorization",
            .line = 352,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Whatever scope-inclusion strategy a server adopts, servers SHOULD include all scopes required for the current operation in a single challenge.",
        },
        .{
            .id = "basic/authorization#063-c4be26",
            .page = "basic/authorization",
            .line = 361,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD be consistent in their scope inclusion strategy to provide predictable behavior for clients.",
        },
        .{
            .id = "basic/authorization#064-0a42b7",
            .page = "basic/authorization",
            .line = 363,
            .section = "Runtime Insufficient Scope Errors",
            .anchor = "runtime-insufficient-scope-errors",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD consider the user experience impact when determining which scopes to include in the response, as misconfigured scopes may require frequent user interaction.",
        },
        .{
            .id = "basic/authorization#065-471dbe",
            .page = "basic/authorization",
            .line = 381,
            .section = "Step-Up Authorization Flow",
            .anchor = "step-up-authorization-flow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD respond to these errors by requesting a new access token with an increased set of scopes via a step-up authorization flow or handle the errors in other, appropriate ways.",
        },
        .{
            .id = "basic/authorization#066-a0a2e8",
            .page = "basic/authorization",
            .line = 381,
            .section = "Step-Up Authorization Flow",
            .anchor = "step-up-authorization-flow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients acting on behalf of a user SHOULD attempt the step-up authorization flow.",
        },
        .{
            .id = "basic/authorization#067-373514",
            .page = "basic/authorization",
            .line = 381,
            .section = "Step-Up Authorization Flow",
            .anchor = "step-up-authorization-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients acting on their own behalf (`client_credentials` clients) MAY attempt the step-up authorization flow or abort the request immediately.",
        },
        .{
            .id = "basic/authorization#068-34de97",
            .page = "basic/authorization",
            .line = 389,
            .section = "Step-Up Authorization Flow",
            .anchor = "step-up-authorization-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY also consult the Scope Selection Strategy for initial scope selection guidance.",
        },
        .{
            .id = "basic/authorization#069-de4a80",
            .page = "basic/authorization",
            .line = 401,
            .section = "Step-Up Authorization Flow",
            .anchor = "step-up-authorization-flow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD implement retry limits and SHOULD track scope upgrade attempts to avoid repeated failures for the same resource and operation combination.",
        },
        .{
            .id = "basic/authorization#070-f15f19",
            .page = "basic/authorization",
            .line = 404,
            .section = "Step-Up Authorization Flow",
            .anchor = "step-up-authorization-flow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST account for scope hierarchies, where a broader scope implies narrower ones, when deciding whether a token is sufficient for an operation.",
        },
        .{
            .id = "basic/authorization#071-8c6654",
            .page = "basic/authorization",
            .line = 409,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations of this specification MUST follow the normative security requirements in Security Considerations, covering token audience binding and validation, token theft, communication security, authorization code protection, mix-up and confused deputy attacks, open redirection, and Client ID Metadata Document security.",
        },
        .{
            .id = "basic/authorization/security-considerations#001-5f2fb6",
            .page = "basic/authorization/security-considerations",
            .line = 8,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "This document outlines security requirements that implementers MUST consider when building MCP clients and servers.",
        },
        .{
            .id = "basic/authorization/security-considerations#002-0742a8",
            .page = "basic/authorization/security-considerations",
            .line = 11,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Additionally, implementors MUST follow OAuth 2.1 security best practices as outlined in OAuth 2.1 Section 7.",
        },
        .{
            .id = "basic/authorization/security-considerations#003-b326d5",
            .page = "basic/authorization/security-considerations",
            .line = 19,
            .section = "Token Audience Binding and Validation",
            .anchor = "token-audience-binding-and-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST include the `resource` parameter in authorization and token requests as specified in the Resource Parameter Implementation section",
        },
        .{
            .id = "basic/authorization/security-considerations#004-191fec",
            .page = "basic/authorization/security-considerations",
            .line = 20,
            .section = "Token Audience Binding and Validation",
            .anchor = "token-audience-binding-and-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST validate that tokens presented to them were specifically issued for their use",
        },
        .{
            .id = "basic/authorization/security-considerations#005-3ed2ae",
            .page = "basic/authorization/security-considerations",
            .line = 30,
            .section = "Token Theft",
            .anchor = "token-theft",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Clients and servers MUST implement secure token storage and follow OAuth best practices, as outlined in OAuth 2.1, Section 7.1.",
        },
        .{
            .id = "basic/authorization/security-considerations#006-8c6ac3",
            .page = "basic/authorization/security-considerations",
            .line = 33,
            .section = "Token Theft",
            .anchor = "token-theft",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "Authorization servers SHOULD issue short-lived access tokens to reduce the impact of leaked tokens.",
        },
        .{
            .id = "basic/authorization/security-considerations#007-367f4a",
            .page = "basic/authorization/security-considerations",
            .line = 33,
            .section = "Token Theft",
            .anchor = "token-theft",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "For public clients, authorization servers MUST rotate refresh tokens as described in OAuth 2.1 Section 4.3.1 \"Token Endpoint Extension\".",
        },
        .{
            .id = "basic/authorization/security-considerations#008-e75675",
            .page = "basic/authorization/security-considerations",
            .line = 38,
            .section = "Communication Security",
            .anchor = "communication-security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementations MUST follow OAuth 2.1 Section 1.5 \"Communication Security\".",
        },
        .{
            .id = "basic/authorization/security-considerations#009-b4ed9a",
            .page = "basic/authorization/security-considerations",
            .line = 42,
            .section = "Communication Security",
            .anchor = "communication-security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "All authorization server endpoints MUST be served over HTTPS.",
        },
        .{
            .id = "basic/authorization/security-considerations#010-f0753f",
            .page = "basic/authorization/security-considerations",
            .line = 43,
            .section = "Communication Security",
            .anchor = "communication-security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "All redirect URIs MUST be either `localhost` or use HTTPS.",
        },
        .{
            .id = "basic/authorization/security-considerations#011-49ea51",
            .page = "basic/authorization/security-considerations",
            .line = 50,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "To mitigate this, MCP clients MUST implement PKCE according to OAuth 2.1 Section 7.5.2 and MUST verify PKCE support before proceeding with authorization.",
        },
        .{
            .id = "basic/authorization/security-considerations#012-90adc2",
            .page = "basic/authorization/security-considerations",
            .line = 53,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST use the `S256` code challenge method when technically capable, as required by OAuth 2.1 Section 4.1.1.",
        },
        .{
            .id = "basic/authorization/security-considerations#013-30cfcb",
            .page = "basic/authorization/security-considerations",
            .line = 57,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "OAuth 2.0 Authorization Server Metadata: If `code_challenge_methods_supported` is absent, the authorization server does not support PKCE and MCP clients MUST refuse to proceed.",
        },
        .{
            .id = "basic/authorization/security-considerations#014-016305",
            .page = "basic/authorization/security-considerations",
            .line = 59,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Since OAuth 2.1 and PKCE specifications do not define a mechanism for clients to discover PKCE support, MCP clients MUST rely on authorization server metadata to verify this capability: OpenID Connect Discovery 1.0: While the OpenID Provider Metadata does not define `code_challenge_methods_supported`, this field is commonly included by OpenID providers.",
        },
        .{
            .id = "basic/authorization/security-considerations#015-906a38",
            .page = "basic/authorization/security-considerations",
            .line = 59,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST verify the presence of `code_challenge_methods_supported` in the provider metadata response.",
        },
        .{
            .id = "basic/authorization/security-considerations#016-83a513",
            .page = "basic/authorization/security-considerations",
            .line = 59,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "If the field is absent, MCP clients MUST refuse to proceed.",
        },
        .{
            .id = "basic/authorization/security-considerations#017-4a4b0d",
            .page = "basic/authorization/security-considerations",
            .line = 61,
            .section = "Authorization Code Protection",
            .anchor = "authorization-code-protection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "Authorization servers providing OpenID Connect Discovery 1.0 MUST include `code_challenge_methods_supported` in their metadata to ensure MCP compatibility.",
        },
        .{
            .id = "basic/authorization/security-considerations#018-d89a33",
            .page = "basic/authorization/security-considerations",
            .line = 71,
            .section = "Open Redirection",
            .anchor = "open-redirection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST have redirect URIs registered with the authorization server.",
        },
        .{
            .id = "basic/authorization/security-considerations#019-78a2ce",
            .page = "basic/authorization/security-considerations",
            .line = 73,
            .section = "Open Redirection",
            .anchor = "open-redirection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "Authorization servers MUST validate exact redirect URIs against pre-registered values to prevent redirection attacks.",
        },
        .{
            .id = "basic/authorization/security-considerations#020-2a9fab",
            .page = "basic/authorization/security-considerations",
            .line = 75,
            .section = "Open Redirection",
            .anchor = "open-redirection",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "MCP clients SHOULD use and verify state parameters in the authorization code flow and discard any results that do not include or have a mismatch with the original state.",
        },
        .{
            .id = "basic/authorization/security-considerations#021-b7eb1d",
            .page = "basic/authorization/security-considerations",
            .line = 78,
            .section = "Open Redirection",
            .anchor = "open-redirection",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "Authorization servers MUST take precautions to prevent redirecting user agents to untrusted URI's, following suggestions laid out in OAuth 2.1 Section 7.12.2",
        },
        .{
            .id = "basic/authorization/security-considerations#022-43cde5",
            .page = "basic/authorization/security-considerations",
            .line = 80,
            .section = "Open Redirection",
            .anchor = "open-redirection",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "Authorization servers SHOULD only automatically redirect the user agent if it trusts the redirection URI.",
        },
        .{
            .id = "basic/authorization/security-considerations#023-c4e526",
            .page = "basic/authorization/security-considerations",
            .line = 80,
            .section = "Open Redirection",
            .anchor = "open-redirection",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .authorization_server,
            .text = "If the URI is not trusted, the authorization server MAY inform the user and rely on the user to make the correct decision.",
        },
        .{
            .id = "basic/authorization/security-considerations#024-d257bb",
            .page = "basic/authorization/security-considerations",
            .line = 84,
            .section = "Client ID Metadata Document Security",
            .anchor = "client-id-metadata-document-security",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "When implementing Client ID Metadata Documents, authorization servers MUST consider the security implications detailed in OAuth Client ID Metadata Document, Section 6.",
        },
        .{
            .id = "basic/authorization/security-considerations#025-4e9026",
            .page = "basic/authorization/security-considerations",
            .line = 90,
            .section = "Authorization Server Abuse Protection",
            .anchor = "authorization-server-abuse-protection",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "Authorization servers fetching metadata documents SHOULD consider Server-Side Request Forgery (SSRF) risks, as described in OAuth Client ID Metadata Document: Server Side Request Forgery (SSRF) Attacks.",
        },
        .{
            .id = "basic/authorization/security-considerations#026-d51e71",
            .page = "basic/authorization/security-considerations",
            .line = 99,
            .section = "Localhost Redirect URI Risks",
            .anchor = "localhost-redirect-uri-risks",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .authorization_server,
            .text = "Authorization servers: SHOULD display additional warnings for `localhost`-only redirect URIs",
        },
        .{
            .id = "basic/authorization/security-considerations#027-3b7783",
            .page = "basic/authorization/security-considerations",
            .line = 100,
            .section = "Localhost Redirect URI Risks",
            .anchor = "localhost-redirect-uri-risks",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .authorization_server,
            .text = "Authorization servers: MAY require additional attestation mechanisms for enhanced security",
        },
        .{
            .id = "basic/authorization/security-considerations#028-384d81",
            .page = "basic/authorization/security-considerations",
            .line = 101,
            .section = "Localhost Redirect URI Risks",
            .anchor = "localhost-redirect-uri-risks",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .authorization_server,
            .text = "Authorization servers: MUST clearly display the redirect URI hostname during authorization",
        },
        .{
            .id = "basic/authorization/security-considerations#029-6c8d56",
            .page = "basic/authorization/security-considerations",
            .line = 105,
            .section = "Trust Policies",
            .anchor = "trust-policies",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .authorization_server,
            .text = "Authorization servers MAY implement domain-based trust policies for accepting Client ID Metadata Documents, as described in Section 6.4 and Section 6.8 of the Client ID Metadata Document specification.",
        },
        .{
            .id = "basic/authorization/security-considerations#030-6a54dd",
            .page = "basic/authorization/security-considerations",
            .line = 112,
            .section = "Confused Deputy Problem",
            .anchor = "confused-deputy-problem",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP proxy servers using static client IDs MUST obtain user consent for each dynamically registered client before forwarding to third-party authorization servers (which may require additional consent).",
        },
        .{
            .id = "basic/authorization/security-considerations#031-625008",
            .page = "basic/authorization/security-considerations",
            .line = 120,
            .section = "Access Token Privilege Restriction",
            .anchor = "access-token-privilege-restriction",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST validate access tokens before processing the request, ensuring the access token is issued specifically for the MCP server, and take all necessary steps to ensure no data is returned to unauthorized parties.",
        },
        .{
            .id = "basic/authorization/security-considerations#032-b5ded2",
            .page = "basic/authorization/security-considerations",
            .line = 122,
            .section = "Access Token Privilege Restriction",
            .anchor = "access-token-privilege-restriction",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "A MCP server MUST follow the guidelines in OAuth 2.1 - Section 5.2 to validate inbound tokens.",
        },
        .{
            .id = "basic/authorization/security-considerations#033-2b577b",
            .page = "basic/authorization/security-considerations",
            .line = 124,
            .section = "Access Token Privilege Restriction",
            .anchor = "access-token-privilege-restriction",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "MCP servers MUST only accept tokens specifically intended for themselves and MUST reject tokens that do not include them in the audience claim or otherwise verify that they are the intended recipient of the token.",
        },
        .{
            .id = "basic/authorization/security-considerations#034-2a5363",
            .page = "basic/authorization/security-considerations",
            .line = 126,
            .section = "Access Token Privilege Restriction",
            .anchor = "access-token-privilege-restriction",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The MCP server MUST NOT pass through the token it received from the MCP client.",
        },
        .{
            .id = "basic/authorization/security-considerations#035-655246",
            .page = "basic/authorization/security-considerations",
            .line = 128,
            .section = "Access Token Privilege Restriction",
            .anchor = "access-token-privilege-restriction",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST implement and use the `resource` parameter as defined in RFC 8707 - Resource Indicators for OAuth 2.0 to explicitly specify the target resource for which the token is being requested.",
        },
        .{
            .id = "basic#001-a0816e",
            .page = "basic",
            .line = 17,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "All implementations MUST support the base protocol, versioning, and the message patterns.",
        },
        .{
            .id = "basic#002-fcc424",
            .page = "basic",
            .line = 17,
            .section = "",
            .anchor = "",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Other components MAY be implemented based on the specific needs of the application.",
        },
        .{
            .id = "basic#003-9774fb",
            .page = "basic",
            .line = 27,
            .section = "Messages",
            .anchor = "messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "All messages between MCP clients and servers MUST follow the JSON-RPC 2.0 specification.",
        },
        .{
            .id = "basic#004-bdbccc",
            .page = "basic",
            .line = 46,
            .section = "Requests",
            .anchor = "requests",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Requests MUST include a string or integer ID.",
        },
        .{
            .id = "basic#005-69460b",
            .page = "basic",
            .line = 47,
            .section = "Requests",
            .anchor = "requests",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Unlike base JSON-RPC, the ID MUST NOT be `null`.",
        },
        .{
            .id = "basic#006-d3a20c",
            .page = "basic",
            .line = 48,
            .section = "Requests",
            .anchor = "requests",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "The request ID MUST NOT match the ID of any other request the sender has issued and not yet received a response for.",
        },
        .{
            .id = "basic#007-e767e5",
            .page = "basic",
            .line = 70,
            .section = "Result Responses",
            .anchor = "result-responses",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Result responses MUST include the same ID as the request they correspond to.",
        },
        .{
            .id = "basic#008-0c3e2c",
            .page = "basic",
            .line = 71,
            .section = "Result Responses",
            .anchor = "result-responses",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Result responses MUST include a `result` field.",
        },
        .{
            .id = "basic#009-3dada6",
            .page = "basic",
            .line = 72,
            .section = "Result Responses",
            .anchor = "result-responses",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The `result` MAY follow any JSON object structure.",
        },
        .{
            .id = "basic#010-f96ef0",
            .page = "basic",
            .line = 73,
            .section = "Result Responses",
            .anchor = "result-responses",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The `result` MUST include a `resultType` field to indicate the type of the result.",
        },
        .{
            .id = "basic#011-ec6f50",
            .page = "basic",
            .line = 83,
            .section = "ResultType",
            .anchor = "resulttype",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Extensions MAY add additional `ResultType` values.",
        },
        .{
            .id = "basic#012-f2831f",
            .page = "basic",
            .line = 83,
            .section = "ResultType",
            .anchor = "resulttype",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The set of supported `ResultType` values MUST be created from the set defined in the core protocol and include any additional values of supported extensions that are advertised via capabilities.",
        },
        .{
            .id = "basic#013-321463",
            .page = "basic",
            .line = 84,
            .section = "ResultType",
            .anchor = "resulttype",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "A `resultType` of any value unrecognized by the client MUST be considered invalid.",
        },
        .{
            .id = "basic#014-4c9652",
            .page = "basic",
            .line = 85,
            .section = "ResultType",
            .anchor = "resulttype",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "For backward compatibility with servers implementing earlier protocol versions, which do not include `resultType`, clients MUST treat an absent `resultType` as `\"complete\"`.",
        },
        .{
            .id = "basic#015-448dd0",
            .page = "basic",
            .line = 103,
            .section = "Error Responses",
            .anchor = "error-responses",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Error responses MUST include the same ID as the request they correspond to (except in error cases where the ID could not be read due a malformed request).",
        },
        .{
            .id = "basic#016-b9a325",
            .page = "basic",
            .line = 104,
            .section = "Error Responses",
            .anchor = "error-responses",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Error responses MUST include an `error` field with a `code` and `message`.",
        },
        .{
            .id = "basic#017-a2dc63",
            .page = "basic",
            .line = 105,
            .section = "Error Responses",
            .anchor = "error-responses",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Error codes MUST be integers.",
        },
        .{
            .id = "basic#018-312208",
            .page = "basic",
            .line = 106,
            .section = "Error Responses",
            .anchor = "error-responses",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Error responses MAY include a `data` member with additional information of any type, such as nested errors.",
        },
        .{
            .id = "basic#019-b8ef1f",
            .page = "basic",
            .line = 117,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .must_not,
            .keywords = .{"MUST NOT", "SHOULD NOT"},
            .party = .both,
            .text = "New codes MUST NOT be allocated in this sub-range, and new implementations SHOULD NOT use codes from this sub-range at all.",
        },
        .{
            .id = "basic#020-c3e6cc",
            .page = "basic",
            .line = 117,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Apart from `-32002` (see below), receivers MUST NOT assume any specific meaning for these codes.",
        },
        .{
            .id = "basic#021-41c1d6",
            .page = "basic",
            .line = 122,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .must_not,
            .keywords = .{"MUST NOT", "MUST"},
            .party = .both,
            .text = "Implementations MUST NOT emit any code from this sub-range that is not defined by this specification and MUST use defined codes only with their specified meanings.",
        },
        .{
            .id = "basic#022-5fe4ec",
            .page = "basic",
            .line = 140,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Implementations of this protocol version MUST NOT emit these codes: `-32002` \xe2\x80\x94 resource not found (2025-11-25 and earlier; replaced by `-32602`).",
        },
        .{
            .id = "basic#023-96e2d9",
            .page = "basic",
            .line = 140,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD still accept `-32002` from servers implementing earlier versions.",
        },
        .{
            .id = "basic#024-f56c3a",
            .page = "basic",
            .line = 144,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Implementations of this protocol version MUST NOT emit these codes: `-32042` \xe2\x80\x94 URL elicitation required (2025-11-25 only).",
        },
        .{
            .id = "basic#025-18b8d7",
            .page = "basic",
            .line = 153,
            .section = "Error Codes",
            .anchor = "error-codes",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "New error codes for purposes not defined by this specification SHOULD be allocated outside the JSON-RPC reserved range (`-32768` to `-32000`); the remainder of the integer space is available for application-defined errors.",
        },
        .{
            .id = "basic#026-405883",
            .page = "basic",
            .line = 159,
            .section = "Notifications",
            .anchor = "notifications",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "The receiver MUST NOT send a response.",
        },
        .{
            .id = "basic#027-c3b3f8",
            .page = "basic",
            .line = 172,
            .section = "Notifications",
            .anchor = "notifications",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Notifications MUST NOT include an ID.",
        },
        .{
            .id = "basic#028-0705ef",
            .page = "basic",
            .line = 191,
            .section = "Statelessness",
            .anchor = "statelessness",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT rely on prior requests over the same connection to establish context (e.g., capabilities, protocol version, client identity).",
        },
        .{
            .id = "basic#029-e542f6",
            .page = "basic",
            .line = 194,
            .section = "Statelessness",
            .anchor = "statelessness",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD be prepared to handle requests associated with multiple tasks, threads, or conversations.",
        },
        .{
            .id = "basic#030-f10aa0",
            .page = "basic",
            .line = 196,
            .section = "Statelessness",
            .anchor = "statelessness",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .server,
            .text = "Servers SHOULD NOT require that a client reuse the same connection or process to perform related operations.",
        },
        .{
            .id = "basic#031-698d0a",
            .page = "basic",
            .line = 198,
            .section = "Statelessness",
            .anchor = "statelessness",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .client,
            .text = "Clients SHOULD NOT use an individual task, thread, or conversation as the lifetime boundary for the stdio process.",
        },
        .{
            .id = "basic#032-88b3c1",
            .page = "basic",
            .line = 200,
            .section = "Statelessness",
            .anchor = "statelessness",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "State that needs to span multiple requests (e.g., long-running tasks, application-level handles) MUST be referenced by an explicit identifier the client passes on each request.",
        },
        .{
            .id = "basic#033-44fc33",
            .page = "basic",
            .line = 223,
            .section = "Auth",
            .anchor = "auth",
            .level = .should,
            .keywords = .{"SHOULD", "SHOULD NOT"},
            .party = .both,
            .text = "Implementations using an HTTP-based transport SHOULD conform to this specification, whereas implementations using STDIO transport SHOULD NOT follow this specification, and instead retrieve credentials from the environment.",
        },
        .{
            .id = "basic#034-ebf9e8",
            .page = "basic",
            .line = 228,
            .section = "Auth",
            .anchor = "auth",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Additionally, clients and servers MAY negotiate their own custom authentication and authorization strategies.",
        },
        .{
            .id = "basic#035-c2e6b5",
            .page = "basic",
            .line = 256,
            .section = "Schema Dialect",
            .anchor = "schema-dialect",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Explicit dialect: Schemas MAY include a `$schema` field to specify a different dialect",
        },
        .{
            .id = "basic#036-d5aeb2",
            .page = "basic",
            .line = 257,
            .section = "Schema Dialect",
            .anchor = "schema-dialect",
            .level = .must,
            .keywords = .{"MUST", "SHOULD"},
            .party = .both,
            .text = "Supported dialects: Implementations MUST support at least 2020-12 and SHOULD document which additional dialects they support",
        },
        .{
            .id = "basic#037-caaa47",
            .page = "basic",
            .line = 258,
            .section = "Schema Dialect",
            .anchor = "schema-dialect",
            .level = .should,
            .keywords = .{"RECOMMENDED"},
            .party = .both,
            .text = "Recommendation: Implementors are RECOMMENDED to use JSON Schema 2020-12.",
        },
        .{
            .id = "basic#038-396de4",
            .page = "basic",
            .line = 291,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Clients and servers MUST support JSON Schema 2020-12 for schemas without an explicit `$schema` field",
        },
        .{
            .id = "basic#039-eac9c7",
            .page = "basic",
            .line = 292,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Clients and servers MUST validate schemas according to their declared or default dialect.",
        },
        .{
            .id = "basic#040-3672ea",
            .page = "basic",
            .line = 292,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "They MUST handle unsupported dialects gracefully by returning an appropriate error indicating the dialect is not supported.",
        },
        .{
            .id = "basic#041-abc112",
            .page = "basic",
            .line = 293,
            .section = "Implementation Requirements",
            .anchor = "implementation-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Clients and servers SHOULD document which schema dialects they support",
        },
        .{
            .id = "basic#042-b42c05",
            .page = "basic",
            .line = 297,
            .section = "Schema Validation",
            .anchor = "schema-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Schemas MUST be valid according to their declared or default dialect",
        },
        .{
            .id = "basic#043-6d081f",
            .page = "basic",
            .line = 301,
            .section = "`$ref` Resolution",
            .anchor = "ref-resolution",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Implementations MUST NOT automatically dereference `$ref` values that resolve to a network URI.",
        },
        .{
            .id = "basic#044-c9e4e3",
            .page = "basic",
            .line = 304,
            .section = "`$ref` Resolution",
            .anchor = "ref-resolution",
            .level = .must,
            .keywords = .{"MAY", "MUST", "SHOULD"},
            .party = .both,
            .text = "Implementations MAY offer an opt-in mode that fetches non-local `$ref`s but it MUST be disabled by default and SHOULD enforce an allowlist of hosts or at minimum reject loopback, link-local, and private network addresses, apply timeouts and size limits, and log dereferenced URIs.",
        },
        .{
            .id = "basic#045-d4d646",
            .page = "basic",
            .line = 309,
            .section = "`$ref` Resolution",
            .anchor = "ref-resolution",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Schemas that fail to validate due to an unresolved external `$ref` SHOULD be rejected rather than silently treated as permissive.",
        },
        .{
            .id = "basic#046-64ac13",
            .page = "basic",
            .line = 314,
            .section = "Composition-Keyword Resource Use",
            .anchor = "composition-keyword-resource-use",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Implementations SHOULD apply reasonable bounds, such as a maximum schema depth, a cap on the total number of subschemas, or a per-validation time budget, to prevent a malicious schema from acting as a Denial-of-Service vector against the validator.",
        },
        .{
            .id = "basic#047-ec91ba",
            .page = "basic",
            .line = 327,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Certain key names are reserved by MCP for protocol-level metadata, as specified below; implementations MUST NOT make assumptions about values at these keys.",
        },
        .{
            .id = "basic#048-6982ac",
            .page = "basic",
            .line = 334,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "If specified, MUST be a series of labels separated by dots (`.`), followed by a slash (`/`).",
        },
        .{
            .id = "basic#049-c3a0e7",
            .page = "basic",
            .line = 335,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Labels MUST start with a letter and end with a letter or digit; interior characters can be letters, digits, or hyphens (`-`).",
        },
        .{
            .id = "basic#050-2b8069",
            .page = "basic",
            .line = 336,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Implementations SHOULD use reverse DNS notation (e.g., `com.example/` rather than `example.com/`).",
        },
        .{
            .id = "basic#051-ca10c6",
            .page = "basic",
            .line = 343,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Unless empty, MUST begin and end with an alphanumeric character (`[a-z0-9A-Z]`).",
        },
        .{
            .id = "basic#052-fb7b59",
            .page = "basic",
            .line = 344,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Name: MAY contain hyphens (`-`), underscores (`_`), dots (`.`), and alphanumerics in between.",
        },
        .{
            .id = "basic#053-3b953b",
            .page = "basic",
            .line = 367,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Client requests carry the following `io.modelcontextprotocol/*` fields in `_meta`; fields marked as required MUST be included on every request.",
        },
        .{
            .id = "basic#054-289424",
            .page = "basic",
            .line = 380,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "A request missing any required field is malformed; the server MUST reject it with JSON-RPC error code `-32602` (Invalid params).",
        },
        .{
            .id = "basic#055-263eff",
            .page = "basic",
            .line = 380,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "On HTTP, the response status MUST be `400 Bad Request`.",
        },
        .{
            .id = "basic#056-b03baa",
            .page = "basic",
            .line = 384,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD include `io.modelcontextprotocol/clientInfo` on every request unless specifically configured not to do so.",
        },
        .{
            .id = "basic#057-7063c4",
            .page = "basic",
            .line = 387,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "A server MUST NOT rely on capabilities the client has not declared.",
        },
        .{
            .id = "basic#058-24204d",
            .page = "basic",
            .line = 387,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If processing a request requires a capability the client did not include in `io.modelcontextprotocol/clientCapabilities`, the server MUST return a `MissingRequiredClientCapabilityError` (`-32021`) whose `data.requiredCapabilities` lists the missing capabilities.",
        },
        .{
            .id = "basic#059-263eff",
            .page = "basic",
            .line = 387,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "On HTTP, the response status MUST be `400 Bad Request`.",
        },
        .{
            .id = "basic#060-0d96e2",
            .page = "basic",
            .line = 396,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD include the following `io.modelcontextprotocol/*` field in every result's `_meta`, unless specifically configured not to do so, to identify themselves without relying on any prior connection state:",
        },
        .{
            .id = "basic#061-d9f747",
            .page = "basic",
            .line = 405,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .both,
            .text = "Implementations SHOULD NOT use them to change the behavior of the client or server, and SHOULD NOT rely on them for security decisions.",
        },
        .{
            .id = "basic#062-f00762",
            .page = "basic",
            .line = 412,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "On notifications delivered via a [`subscriptions/listen`][subscriptions-listen] stream, the server MUST include `io.modelcontextprotocol/subscriptionId` in `_meta` so the client can correlate the notification with the originating subscription request.",
        },
        .{
            .id = "basic#063-5d80d8",
            .page = "basic",
            .line = 421,
            .section = "`_meta`",
            .anchor = "_meta",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "When present, their values MUST follow W3C Trace Context and W3C Baggage formats respectively.",
        },
        .{
            .id = "basic#064-1c1aaf",
            .page = "basic",
            .line = 465,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients that support rendering icons MUST support at least the following MIME types: `image/png` - PNG images (safe, universal compatibility)",
        },
        .{
            .id = "basic#065-1b3064",
            .page = "basic",
            .line = 466,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients that support rendering icons MUST support at least the following MIME types: `image/jpeg` (and `image/jpg`) - JPEG images (safe, universal compatibility)",
        },
        .{
            .id = "basic#066-7bedbf",
            .page = "basic",
            .line = 470,
            .section = "`icons`",
            .anchor = "icons",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients that support rendering icons SHOULD also support: `image/svg+xml` - SVG images (scalable but requires security precautions as noted below)",
        },
        .{
            .id = "basic#067-30920b",
            .page = "basic",
            .line = 471,
            .section = "`icons`",
            .anchor = "icons",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients that support rendering icons SHOULD also support: `image/webp` - WebP images (modern, efficient format)",
        },
        .{
            .id = "basic#068-1f9bd0",
            .page = "basic",
            .line = 477,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Treat icon metadata and icon bytes as untrusted inputs and defend against network, privacy, and parsing risks.",
        },
        .{
            .id = "basic#069-b1629f",
            .page = "basic",
            .line = 478,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Ensure that the icon URI is either a HTTPS or `data:` URI.",
        },
        .{
            .id = "basic#070-8d84c6",
            .page = "basic",
            .line = 478,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST reject icon URIs that use unsafe schemes and redirects, such as `javascript:`, `file:`, `ftp:`, `ws:`, or local app URI schemes.",
        },
        .{
            .id = "basic#071-893be4",
            .page = "basic",
            .line = 479,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Disallow scheme changes and redirects to hosts on different origins.",
        },
        .{
            .id = "basic#072-c4f8d3",
            .page = "basic",
            .line = 480,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Be resilient against resource exhaustion attacks stemming from oversized images, large dimensions, or excessive frames (e.g., in GIFs).",
        },
        .{
            .id = "basic#073-ce40c1",
            .page = "basic",
            .line = 481,
            .section = "`icons`",
            .anchor = "icons",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Consumers MAY set limits for image and content size.",
        },
        .{
            .id = "basic#074-5ecfe2",
            .page = "basic",
            .line = 482,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Fetch icons without credentials.",
        },
        .{
            .id = "basic#075-5698de",
            .page = "basic",
            .line = 483,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Verify that icon URIs are from the same origin as the server.",
        },
        .{
            .id = "basic#076-2e0da4",
            .page = "basic",
            .line = 484,
            .section = "`icons`",
            .anchor = "icons",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Exercise caution when fetching and rendering icons as the payload MAY contain executable content (e.g., SVG with embedded JavaScript or extended capabilities).",
        },
        .{
            .id = "basic#077-8b74f1",
            .page = "basic",
            .line = 485,
            .section = "`icons`",
            .anchor = "icons",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Consumers MAY choose to disallow specific file types or otherwise sanitize icon files before rendering.",
        },
        .{
            .id = "basic#078-8e73cf",
            .page = "basic",
            .line = 486,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Validate MIME types and file contents before rendering.",
        },
        .{
            .id = "basic#079-0fb934",
            .page = "basic",
            .line = 487,
            .section = "`icons`",
            .anchor = "icons",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Consumers of icon metadata MUST take appropriate security precautions when handling icons to prevent compromise: Maintain a strict allowlist of image types.",
        },
        .{
            .id = "basic/patterns/cancellation#001-981e1d",
            .page = "basic/patterns/cancellation",
            .line = 7,
            .section = "",
            .anchor = "",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "A client SHOULD send a cancellation notification to indicate that a request it previously issued should be terminated.",
        },
        .{
            .id = "basic/patterns/cancellation#002-e315cd",
            .page = "basic/patterns/cancellation",
            .line = 11,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "A server MUST send `notifications/cancelled` referencing a `subscriptions/listen` request ID when it tears down that subscription stream (see [Subscriptions][subscriptions]).",
        },
        .{
            .id = "basic/patterns/cancellation#003-68c7d9",
            .page = "basic/patterns/cancellation",
            .line = 11,
            .section = "",
            .anchor = "",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT send `notifications/cancelled` for any other purpose.",
        },
        .{
            .id = "basic/patterns/cancellation#004-0ab0e3",
            .page = "basic/patterns/cancellation",
            .line = 39,
            .section = "Transport-Specific Cancellation",
            .anchor = "transport-specific-cancellation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "The server MUST treat a client disconnect as cancellation of that request.",
        },
        .{
            .id = "basic/patterns/cancellation#005-e1786e",
            .page = "basic/patterns/cancellation",
            .line = 42,
            .section = "Transport-Specific Cancellation",
            .anchor = "transport-specific-cancellation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The client MUST send a `notifications/cancelled` notification referencing the request ID.",
        },
        .{
            .id = "basic/patterns/cancellation#006-ed6274",
            .page = "basic/patterns/cancellation",
            .line = 47,
            .section = "Timeouts",
            .anchor = "timeouts",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Implementations SHOULD establish timeouts for all sent requests, to prevent hung connections and resource exhaustion.",
        },
        .{
            .id = "basic/patterns/cancellation#007-6ae573",
            .page = "basic/patterns/cancellation",
            .line = 47,
            .section = "Timeouts",
            .anchor = "timeouts",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "When the request has not received a success or error response within the timeout period, the sender SHOULD cancel the request and stop waiting for a response.",
        },
        .{
            .id = "basic/patterns/cancellation#008-6a2cad",
            .page = "basic/patterns/cancellation",
            .line = 57,
            .section = "Timeouts",
            .anchor = "timeouts",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "SDKs and other middleware SHOULD allow these timeouts to be configured on a per-request basis.",
        },
        .{
            .id = "basic/patterns/cancellation#009-d579ef",
            .page = "basic/patterns/cancellation",
            .line = 60,
            .section = "Timeouts",
            .anchor = "timeouts",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Implementations MAY choose to reset the timeout clock when receiving a progress notification corresponding to the request, as this implies that work is actually happening.",
        },
        .{
            .id = "basic/patterns/cancellation#010-6c2d1f",
            .page = "basic/patterns/cancellation",
            .line = 60,
            .section = "Timeouts",
            .anchor = "timeouts",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "However, implementations SHOULD always enforce a maximum timeout, regardless of progress notifications, to limit the impact of a misbehaving client or server.",
        },
        .{
            .id = "basic/patterns/cancellation#011-182b4a",
            .page = "basic/patterns/cancellation",
            .line = 69,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Cancellation notifications MUST only reference requests that: Were previously issued by the client",
        },
        .{
            .id = "basic/patterns/cancellation#012-3d7581",
            .page = "basic/patterns/cancellation",
            .line = 70,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Cancellation notifications MUST only reference requests that: Are believed to still be in-progress",
        },
        .{
            .id = "basic/patterns/cancellation#013-175e99",
            .page = "basic/patterns/cancellation",
            .line = 71,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Server-sent cancellation notifications MUST reference a `subscriptions/listen` request, to terminate that subscription stream",
        },
        .{
            .id = "basic/patterns/cancellation#014-4ed9b5",
            .page = "basic/patterns/cancellation",
            .line = 74,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers receiving cancellation notifications SHOULD: Stop processing the cancelled request",
        },
        .{
            .id = "basic/patterns/cancellation#015-23e438",
            .page = "basic/patterns/cancellation",
            .line = 75,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers receiving cancellation notifications SHOULD: Free associated resources",
        },
        .{
            .id = "basic/patterns/cancellation#016-291f6c",
            .page = "basic/patterns/cancellation",
            .line = 76,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers receiving cancellation notifications SHOULD: Not send a response for the cancelled request",
        },
        .{
            .id = "basic/patterns/cancellation#017-ad3fdd",
            .page = "basic/patterns/cancellation",
            .line = 78,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY ignore cancellation notifications if: The referenced request is unknown",
        },
        .{
            .id = "basic/patterns/cancellation#018-347ba0",
            .page = "basic/patterns/cancellation",
            .line = 79,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY ignore cancellation notifications if: Processing has already completed",
        },
        .{
            .id = "basic/patterns/cancellation#019-4ca65a",
            .page = "basic/patterns/cancellation",
            .line = 80,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY ignore cancellation notifications if: The request cannot be cancelled",
        },
        .{
            .id = "basic/patterns/cancellation#020-5bebb3",
            .page = "basic/patterns/cancellation",
            .line = 81,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "The client SHOULD ignore any response to the cancelled request that arrives afterward",
        },
        .{
            .id = "basic/patterns/cancellation#021-e99327",
            .page = "basic/patterns/cancellation",
            .line = 89,
            .section = "Timing Considerations",
            .anchor = "timing-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Both parties MUST handle these race conditions gracefully:",
        },
        .{
            .id = "basic/patterns/cancellation#022-b6fd44",
            .page = "basic/patterns/cancellation",
            .line = 108,
            .section = "Implementation Notes",
            .anchor = "implementation-notes",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Both parties SHOULD log cancellation reasons for debugging",
        },
        .{
            .id = "basic/patterns/cancellation#023-ed85f7",
            .page = "basic/patterns/cancellation",
            .line = 109,
            .section = "Implementation Notes",
            .anchor = "implementation-notes",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Application UIs SHOULD indicate when cancellation is requested",
        },
        .{
            .id = "basic/patterns/cancellation#024-d5a342",
            .page = "basic/patterns/cancellation",
            .line = 115,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Invalid cancellation notifications SHOULD be ignored: Unknown request IDs",
        },
        .{
            .id = "basic/patterns/cancellation#025-ee37db",
            .page = "basic/patterns/cancellation",
            .line = 116,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Invalid cancellation notifications SHOULD be ignored: Already completed requests",
        },
        .{
            .id = "basic/patterns/cancellation#026-a4b7f4",
            .page = "basic/patterns/cancellation",
            .line = 117,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Invalid cancellation notifications SHOULD be ignored: Malformed notifications",
        },
        .{
            .id = "basic/patterns#001-3fbe8c",
            .page = "basic/patterns",
            .line = 20,
            .section = "",
            .anchor = "",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT initiate JSON-RPC requests, and clients do not send JSON-RPC responses.",
        },
        .{
            .id = "basic/patterns#002-78811a",
            .page = "basic/patterns",
            .line = 25,
            .section = "Request and Response",
            .anchor = "request-and-response",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "While the request is in flight, the server MAY send notifications scoped to it, such as `notifications/progress` and `notifications/message`.",
        },
        .{
            .id = "basic/patterns/mrtr#001-36268d",
            .page = "basic/patterns/mrtr",
            .line = 8,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST send server-to-client requests (such as `roots/list`, `sampling/createMessage`, or `elicitation/create`) using the MRTR pattern.",
        },
        .{
            .id = "basic/patterns/mrtr#002-8d5f8f",
            .page = "basic/patterns/mrtr",
            .line = 17,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Every request MUST include the required `_meta` fields; see `_meta`.",
        },
        .{
            .id = "basic/patterns/mrtr#003-076bfd",
            .page = "basic/patterns/mrtr",
            .line = 130,
            .section = "InputRequiredResult",
            .anchor = "inputrequiredresult",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "Clients MUST NOT inspect, parse, modify, or make any assumptions about its contents.",
        },
        .{
            .id = "basic/patterns/mrtr#004-776661",
            .page = "basic/patterns/mrtr",
            .line = 184,
            .section = "Supported Requests",
            .anchor = "supported-requests",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY send `InputRequiredResult` responses on the following client requests:",
        },
        .{
            .id = "basic/patterns/mrtr#005-0d27b8",
            .page = "basic/patterns/mrtr",
            .line = 192,
            .section = "Supported Requests",
            .anchor = "supported-requests",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT send `InputRequiredResult` responses on any other client requests.",
        },
        .{
            .id = "basic/patterns/mrtr#006-79b14e",
            .page = "basic/patterns/mrtr",
            .line = 226,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY respond to any supported client request with an `InputRequiredResult`.",
        },
        .{
            .id = "basic/patterns/mrtr#007-eb57e3",
            .page = "basic/patterns/mrtr",
            .line = 227,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The `InputRequiredResult` MAY include an `inputRequests` field.",
        },
        .{
            .id = "basic/patterns/mrtr#008-92a682",
            .page = "basic/patterns/mrtr",
            .line = 228,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "`inputRequests` keys are server assigned identifiers and MUST be unique within the scope of the request.",
        },
        .{
            .id = "basic/patterns/mrtr#009-1df6c7",
            .page = "basic/patterns/mrtr",
            .line = 229,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "`inputRequests` values are request objects that MUST be one of `ElicitRequest`, `CreateMessageRequest`, or `ListRootsRequest`",
        },
        .{
            .id = "basic/patterns/mrtr#010-c2e08b",
            .page = "basic/patterns/mrtr",
            .line = 231,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The `InputRequiredResult` MAY include a `requestState` field.",
        },
        .{
            .id = "basic/patterns/mrtr#011-ed5a86",
            .page = "basic/patterns/mrtr",
            .line = 232,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If a client request contains a `requestState` field, servers MUST treat `requestState` as an attacker-controlled input.",
        },
        .{
            .id = "basic/patterns/mrtr#012-07c2aa",
            .page = "basic/patterns/mrtr",
            .line = 232,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If `requestState` influences authorization, resource access, or business logic, servers MUST protect its integrity (e.g. HMAC or AEAD) and MUST reject state that fails verification.",
        },
        .{
            .id = "basic/patterns/mrtr#013-37a215",
            .page = "basic/patterns/mrtr",
            .line = 232,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Integrity protection MAY be omitted only when tampering can cause nothing worse than request failure.",
        },
        .{
            .id = "basic/patterns/mrtr#014-e965bb",
            .page = "basic/patterns/mrtr",
            .line = 235,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "To prevent replay, servers SHOULD include the following inside the integrity-protected `requestState` payload and verify each on receipt: the authenticated principal, rejecting state presented by a different principal.",
        },
        .{
            .id = "basic/patterns/mrtr#015-3c0b5e",
            .page = "basic/patterns/mrtr",
            .line = 236,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "To prevent replay, servers SHOULD include the following inside the integrity-protected `requestState` payload and verify each on receipt: a short expiry (TTL), rejecting state presented after it lapses;",
        },
        .{
            .id = "basic/patterns/mrtr#016-3d172b",
            .page = "basic/patterns/mrtr",
            .line = 237,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "To prevent replay, servers SHOULD include the following inside the integrity-protected `requestState` payload and verify each on receipt: an identifier for the originating request, e.g. the method name and a digest of its salient parameters, rejecting state presented on a request that does not match.",
        },
        .{
            .id = "basic/patterns/mrtr#017-c3efe6",
            .page = "basic/patterns/mrtr",
            .line = 239,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers for which a given `requestState` must be consumed at most once (e.g., one-time redemptions) MUST enforce that invariant server-side.",
        },
        .{
            .id = "basic/patterns/mrtr#018-de5c1f",
            .page = "basic/patterns/mrtr",
            .line = 245,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST include at least one of `inputRequests` or `requestState` in every `InputRequiredResult` response.",
        },
        .{
            .id = "basic/patterns/mrtr#019-e4a607",
            .page = "basic/patterns/mrtr",
            .line = 246,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT send an `inputRequests` that the client has not declared support for in its capabilities.",
        },
        .{
            .id = "basic/patterns/mrtr#020-ef8b4b",
            .page = "basic/patterns/mrtr",
            .line = 246,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "For example, if a client does not declare support for `elicitation`, the server MUST NOT include any `elicitation/create` requests in the `inputRequests` field.",
        },
        .{
            .id = "basic/patterns/mrtr#021-a2e60d",
            .page = "basic/patterns/mrtr",
            .line = 247,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT assume that clients will fulfill the `inputRequests` or retry the original request.",
        },
        .{
            .id = "basic/patterns/mrtr#022-01e395",
            .page = "basic/patterns/mrtr",
            .line = 247,
            .section = "Server Requirements (Basic Workflow)",
            .anchor = "server-requirements-basic-workflow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY choose to return an `InputRequiredResult` on multiple attempts at the same request if they want to repeatedly prompt the user for information until they have what they need to complete the request.",
        },
        .{
            .id = "basic/patterns/mrtr#023-e3881d",
            .page = "basic/patterns/mrtr",
            .line = 251,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "If a client receives an `InputRequiredResult` that contains the `inputRequests` field, the client MUST construct the requested inputs before retrying the original request.",
        },
        .{
            .id = "basic/patterns/mrtr#024-68a9f1",
            .page = "basic/patterns/mrtr",
            .line = 251,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "If the `InputRequiredResult` does not contain the `inputRequests` field, the client MAY retry the original request immediately.",
        },
        .{
            .id = "basic/patterns/mrtr#025-0387ee",
            .page = "basic/patterns/mrtr",
            .line = 254,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "If an `InputRequiredResult` contains the `requestState` field, the client MUST echo back the exact value of that field when retrying the original request.",
        },
        .{
            .id = "basic/patterns/mrtr#026-c4c4c8",
            .page = "basic/patterns/mrtr",
            .line = 254,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "Clients MUST NOT inspect, parse, modify, or make any assumptions about the `requestState` contents.",
        },
        .{
            .id = "basic/patterns/mrtr#027-11edf5",
            .page = "basic/patterns/mrtr",
            .line = 254,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "If the `InputRequiredResult` does not contain a `requestState` field, the client MUST NOT include one in the retry.",
        },
        .{
            .id = "basic/patterns/mrtr#028-cbc1a1",
            .page = "basic/patterns/mrtr",
            .line = 256,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The JSON-RPC `id` MUST be different between the initial request and the retry, as they are independent requests.",
        },
        .{
            .id = "basic/patterns/mrtr#029-a496bd",
            .page = "basic/patterns/mrtr",
            .line = 257,
            .section = "Client Requirements (Basic Workflow)",
            .anchor = "client-requirements-basic-workflow",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "They MUST NOT be used for any other request that the client may be sending in parallel.",
        },
        .{
            .id = "basic/patterns/mrtr#030-7438ff",
            .page = "basic/patterns/mrtr",
            .line = 261,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD validate that the data provided by the client is a valid `InputResponses` object and that the information inside can be correctly parsed.",
        },
        .{
            .id = "basic/patterns/mrtr#031-2e3e18",
            .page = "basic/patterns/mrtr",
            .line = 261,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Protocol errors (malformed JSON, invalid schema, internal server errors) SHOULD return a JSON-RPC error response with an appropriate error code and message.",
        },
        .{
            .id = "basic/patterns/mrtr#032-7eba24",
            .page = "basic/patterns/mrtr",
            .line = 264,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "If additional, unexpected parameters are provided in the `InputResponses` object, the server SHOULD ignore any information it does not recognize or need.",
        },
        .{
            .id = "basic/patterns/mrtr#033-d7b255",
            .page = "basic/patterns/mrtr",
            .line = 266,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "If the client fails to send all the information requested in a previous `InputRequests`, and the missing information is necessary for the server to process the request, the server SHOULD respond with a new `InputRequiredResult` requesting the missing information again, rather than returning an error.",
        },
        .{
            .id = "basic/patterns/mrtr#034-348ddb",
            .page = "basic/patterns/mrtr",
            .line = 271,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST validate request state as described in the server requirements above.",
        },
        .{
            .id = "basic/patterns/progress#001-581e56",
            .page = "basic/patterns/progress",
            .line = 7,
            .section = "",
            .anchor = "",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY send progress notifications to report the status of requests the client has issued.",
        },
        .{
            .id = "basic/patterns/progress#002-0588cd",
            .page = "basic/patterns/progress",
            .line = 16,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Progress tokens MUST be a string or integer value",
        },
        .{
            .id = "basic/patterns/progress#003-4f3336",
            .page = "basic/patterns/progress",
            .line = 17,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Progress tokens can be chosen by the client using any means, but MUST be unique across all active requests.",
        },
        .{
            .id = "basic/patterns/progress#004-316a29",
            .page = "basic/patterns/progress",
            .line = 35,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY then send progress notifications containing: The original progress token",
        },
        .{
            .id = "basic/patterns/progress#005-2d6065",
            .page = "basic/patterns/progress",
            .line = 36,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY then send progress notifications containing: The current progress value so far",
        },
        .{
            .id = "basic/patterns/progress#006-a05257",
            .page = "basic/patterns/progress",
            .line = 37,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY then send progress notifications containing: An optional \"total\" value",
        },
        .{
            .id = "basic/patterns/progress#007-602c1f",
            .page = "basic/patterns/progress",
            .line = 38,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY then send progress notifications containing: An optional \"message\" value",
        },
        .{
            .id = "basic/patterns/progress#008-264e7a",
            .page = "basic/patterns/progress",
            .line = 53,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The `progress` value MUST increase with each notification, even if the total is unknown.",
        },
        .{
            .id = "basic/patterns/progress#009-4a9676",
            .page = "basic/patterns/progress",
            .line = 55,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The `progress` and the `total` values MAY be floating point.",
        },
        .{
            .id = "basic/patterns/progress#010-fe9485",
            .page = "basic/patterns/progress",
            .line = 56,
            .section = "Progress Flow",
            .anchor = "progress-flow",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "The `message` field SHOULD provide relevant human readable progress information.",
        },
        .{
            .id = "basic/patterns/progress#011-e3b94f",
            .page = "basic/patterns/progress",
            .line = 61,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Progress notifications MUST only reference tokens that: Were provided in an active request",
        },
        .{
            .id = "basic/patterns/progress#012-f677a9",
            .page = "basic/patterns/progress",
            .line = 62,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Progress notifications MUST only reference tokens that: Are associated with an in-progress operation",
        },
        .{
            .id = "basic/patterns/progress#013-6806e8",
            .page = "basic/patterns/progress",
            .line = 65,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers receiving a request with a progress token MAY: Choose not to send any progress notifications",
        },
        .{
            .id = "basic/patterns/progress#014-920cd5",
            .page = "basic/patterns/progress",
            .line = 66,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers receiving a request with a progress token MAY: Send notifications at whatever frequency they deem appropriate",
        },
        .{
            .id = "basic/patterns/progress#015-90a1c4",
            .page = "basic/patterns/progress",
            .line = 67,
            .section = "Behavior Requirements",
            .anchor = "behavior-requirements",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers receiving a request with a progress token MAY: Omit the total value if unknown",
        },
        .{
            .id = "basic/patterns/progress#016-f704ba",
            .page = "basic/patterns/progress",
            .line = 88,
            .section = "Implementation Notes",
            .anchor = "implementation-notes",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Clients and servers SHOULD track active progress tokens",
        },
        .{
            .id = "basic/patterns/progress#017-c4d3c9",
            .page = "basic/patterns/progress",
            .line = 89,
            .section = "Implementation Notes",
            .anchor = "implementation-notes",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Both parties SHOULD implement rate limiting to prevent flooding",
        },
        .{
            .id = "basic/patterns/progress#018-458723",
            .page = "basic/patterns/progress",
            .line = 90,
            .section = "Implementation Notes",
            .anchor = "implementation-notes",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Progress notifications MUST stop after completion",
        },
        .{
            .id = "basic/patterns/subscriptions#001-31f5dc",
            .page = "basic/patterns/subscriptions",
            .line = 14,
            .section = "Opening a Stream",
            .anchor = "opening-a-stream",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The server MUST NOT send notification types the client has not explicitly requested.",
        },
        .{
            .id = "basic/patterns/subscriptions#002-ba33b0",
            .page = "basic/patterns/subscriptions",
            .line = 54,
            .section = "Acknowledgment",
            .anchor = "acknowledgment",
            .level = .must,
            .keywords = .{"MUST", "MUST NOT"},
            .party = .server,
            .text = "The server MUST send `notifications/subscriptions/acknowledged` as the first message carrying the subscription's ID in `_meta` under `io.modelcontextprotocol/subscriptionId`, and MUST NOT send any notification on the subscription before it.",
        },
        .{
            .id = "basic/patterns/subscriptions#003-f96346",
            .page = "basic/patterns/subscriptions",
            .line = 54,
            .section = "Acknowledgment",
            .anchor = "acknowledgment",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "On stdio, where every subscription shares one channel, this ordering is defined per subscription ID and not per channel: messages belonging to other subscriptions MAY be interleaved before it.",
        },
        .{
            .id = "basic/patterns/subscriptions#004-1a6d46",
            .page = "basic/patterns/subscriptions",
            .line = 80,
            .section = "Acknowledgment",
            .anchor = "acknowledgment",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "The client SHOULD check the acknowledged filter against what it requested and handle any unsupported types gracefully.",
        },
        .{
            .id = "basic/patterns/subscriptions#005-5d0dfb",
            .page = "basic/patterns/subscriptions",
            .line = 85,
            .section = "Receiving Notifications",
            .anchor = "receiving-notifications",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "On stdio, where all messages share a single channel, clients MUST use this field to correlate notifications with their originating subscription.",
        },
        .{
            .id = "basic/patterns/subscriptions#006-32c573",
            .page = "basic/patterns/subscriptions",
            .line = 109,
            .section = "Multiple Concurrent Subscriptions",
            .anchor = "multiple-concurrent-subscriptions",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "A client MAY have multiple active subscriptions concurrently \xe2\x80\x94 for example, one listening for tools-list changes and another for resource updates.",
        },
        .{
            .id = "basic/patterns/subscriptions#007-0c5b5f",
            .page = "basic/patterns/subscriptions",
            .line = 122,
            .section = "Cancellation",
            .anchor = "cancellation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "The server tears it down (e.g., during shutdown) \xe2\x80\x94 it SHOULD send a successful `subscriptions/listen` response to signal a graceful end (see Graceful Closure), then close the stream.",
        },
        .{
            .id = "basic/patterns/subscriptions#008-fd9c08",
            .page = "basic/patterns/subscriptions",
            .line = 130,
            .section = "Graceful Closure",
            .anchor = "graceful-closure",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When the server ends a subscription on its own initiative (for example, during shutdown), it SHOULD respond to the original `subscriptions/listen` request with a completion result before closing the stream.",
        },
        .{
            .id = "basic/patterns/subscriptions#009-0d786c",
            .page = "basic/patterns/subscriptions",
            .line = 156,
            .section = "Graceful Closure",
            .anchor = "graceful-closure",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "A client that receives this response knows the subscription closed cleanly; a transport that closes without it indicates an unexpected disconnect, which the client MAY treat as a trigger to reconnect.",
        },
        .{
            .id = "basic/patterns/subscriptions#010-5451d2",
            .page = "basic/patterns/subscriptions",
            .line = 160,
            .section = "Graceful Closure",
            .anchor = "graceful-closure",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "On stdio, if the connection is terminated and then re-established, the client MUST re-send `subscriptions/listen` to re-establish its subscriptions \xe2\x80\x94 the server holds no subscription state across reconnections.",
        },
        .{
            .id = "basic/transports#001-41e2a7",
            .page = "basic/transports",
            .line = 29,
            .section = "Messages",
            .anchor = "messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "JSON-RPC messages MUST be UTF-8 encoded.",
        },
        .{
            .id = "basic/transports#002-3b4ee2",
            .page = "basic/transports",
            .line = 32,
            .section = "Messages",
            .anchor = "messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "A binding MUST deliver client-sent requests and notifications to the server, and server-sent responses and notifications to the client.",
        },
        .{
            .id = "basic/transports#003-02b9f4",
            .page = "basic/transports",
            .line = 45,
            .section = "Request Metadata",
            .anchor = "request-metadata",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "A binding MAY additionally mirror selected body fields into envelope metadata.",
        },
        .{
            .id = "basic/transports#004-8207a0",
            .page = "basic/transports",
            .line = 62,
            .section = "Custom Transports",
            .anchor = "custom-transports",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Clients and servers MAY implement additional custom transport mechanisms to suit their specific needs.",
        },
        .{
            .id = "basic/transports#005-ca7691",
            .page = "basic/transports",
            .line = 67,
            .section = "Custom Transports",
            .anchor = "custom-transports",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Implementers who choose to support custom transports MUST preserve the JSON-RPC message format, the message patterns, and the per-request metadata model.",
        },
        .{
            .id = "basic/transports#006-8728f0",
            .page = "basic/transports",
            .line = 67,
            .section = "Custom Transports",
            .anchor = "custom-transports",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Custom transports SHOULD document their connection establishment, message framing, and cancellation patterns to aid interoperability.",
        },
        .{
            .id = "basic/transports#007-c2495c",
            .page = "basic/transports",
            .line = 74,
            .section = "Custom Transports",
            .anchor = "custom-transports",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Custom transports that run over a reliable bidirectional byte stream (e.g., Unix domain sockets or TCP) SHOULD reuse the stdio framing rather than defining a new one: the stdio binding is just newline-delimited JSON-RPC over a byte stream, and only its process-lifecycle rules are specific to standard streams.",
        },
        .{
            .id = "basic/transports/stdio#001-126d73",
            .page = "basic/transports/stdio",
            .line = 13,
            .section = "",
            .anchor = "",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Messages are delimited by newlines, and MUST NOT contain embedded newlines.",
        },
        .{
            .id = "basic/transports/stdio#002-726d27",
            .page = "basic/transports/stdio",
            .line = 14,
            .section = "",
            .anchor = "",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY write UTF-8 strings to `stderr` for any logging purposes including informational, debug, and error messages.",
        },
        .{
            .id = "basic/transports/stdio#003-7a9585",
            .page = "basic/transports/stdio",
            .line = 16,
            .section = "",
            .anchor = "",
            .level = .should_not,
            .keywords = .{"MAY", "SHOULD NOT"},
            .party = .client,
            .text = "The client MAY capture, forward, or ignore the server's `stderr` output and SHOULD NOT assume `stderr` output indicates error conditions.",
        },
        .{
            .id = "basic/transports/stdio#004-3e92e3",
            .page = "basic/transports/stdio",
            .line = 18,
            .section = "",
            .anchor = "",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The server MUST NOT write anything to its `stdout` that is not a valid MCP message.",
        },
        .{
            .id = "basic/transports/stdio#005-516513",
            .page = "basic/transports/stdio",
            .line = 20,
            .section = "",
            .anchor = "",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "The client MUST NOT write anything to the server's `stdin` that is not a valid MCP message.",
        },
        .{
            .id = "basic/transports/stdio#006-df4ce8",
            .page = "basic/transports/stdio",
            .line = 23,
            .section = "",
            .anchor = "",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Custom transports built on such streams SHOULD reuse this framing and the message rules on this page; only the subprocess-specific aspects (launch, `stderr`, shutdown by closing the stream, process restart) need channel-specific equivalents.",
        },
        .{
            .id = "basic/transports/stdio#007-e6b9be",
            .page = "basic/transports/stdio",
            .line = 35,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "The client MUST NOT write JSON-RPC responses.",
        },
        .{
            .id = "basic/transports/stdio#008-d83625",
            .page = "basic/transports/stdio",
            .line = 49,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST correlate these using the `io.modelcontextprotocol/subscriptionId` field in `_meta`; see [`SubscriptionsListenRequest`][subscriptions-listen-request].",
        },
        .{
            .id = "basic/transports/stdio#009-3de50c",
            .page = "basic/transports/stdio",
            .line = 55,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The server MUST NOT write JSON-RPC requests to `stdout`.",
        },
        .{
            .id = "basic/transports/stdio#010-5e8ca7",
            .page = "basic/transports/stdio",
            .line = 78,
            .section = "Cancellation",
            .anchor = "cancellation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "To cancel an in-flight request, the client MUST send a `notifications/cancelled` notification referencing the request's ID.",
        },
        .{
            .id = "basic/transports/stdio#011-316c14",
            .page = "basic/transports/stdio",
            .line = 78,
            .section = "Cancellation",
            .anchor = "cancellation",
            .level = .must_not,
            .keywords = .{"SHOULD", "MUST NOT"},
            .party = .server,
            .text = "Servers SHOULD stop work on a cancelled request as soon as practical and MUST NOT send any further messages for it.",
        },
        .{
            .id = "basic/transports/stdio#012-4d070c",
            .page = "basic/transports/stdio",
            .line = 91,
            .section = "Shutdown",
            .anchor = "shutdown",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "The client SHOULD initiate shutdown by: Closing the input stream to the child process (the server).",
        },
        .{
            .id = "basic/transports/stdio#013-4c28c9",
            .page = "basic/transports/stdio",
            .line = 92,
            .section = "Shutdown",
            .anchor = "shutdown",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "The client SHOULD initiate shutdown by: Waiting for the server to exit.",
        },
        .{
            .id = "basic/transports/stdio#014-7ded80",
            .page = "basic/transports/stdio",
            .line = 93,
            .section = "Shutdown",
            .anchor = "shutdown",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "The client SHOULD initiate shutdown by: If the server does not exit within a reasonable time, forcibly terminating the process using the mechanism appropriate for the operating system.",
        },
        .{
            .id = "basic/transports/stdio#015-7d145c",
            .page = "basic/transports/stdio",
            .line = 102,
            .section = "Shutdown",
            .anchor = "shutdown",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD exit promptly when their standard input is closed or reads return end-of-file.",
        },
        .{
            .id = "basic/transports/stdio#016-b44a7b",
            .page = "basic/transports/stdio",
            .line = 106,
            .section = "Shutdown",
            .anchor = "shutdown",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY initiate shutdown by closing its output stream to the client and exiting.",
        },
        .{
            .id = "basic/transports/stdio#017-591564",
            .page = "basic/transports/stdio",
            .line = 111,
            .section = "Unexpected Termination",
            .anchor = "unexpected-termination",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If the server process exits unexpectedly, the client SHOULD restart it.",
        },
        .{
            .id = "basic/transports/stdio#018-eefc59",
            .page = "basic/transports/stdio",
            .line = 123,
            .section = "Backward Compatibility",
            .anchor = "backward-compatibility",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "A client that supports both modern (per-request-metadata) MCP versions and a legacy version that requires an `initialize` handshake SHOULD probe with [`server/discover`][server-discover] before sending any other request, setting its preferred modern version in `_meta`.",
        },
        .{
            .id = "basic/transports/stdio#019-7043e3",
            .page = "basic/transports/stdio",
            .line = 139,
            .section = "Backward Compatibility",
            .anchor = "backward-compatibility",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "The fallback MUST NOT be keyed to one specific error code: legacy servers respond to unknown pre-`initialize` requests with implementation-defined errors (commonly `-32601` or `-32602`) or not at all.",
        },
        .{
            .id = "basic/transports/stdio#020-bbcc9a",
            .page = "basic/transports/stdio",
            .line = 143,
            .section = "Backward Compatibility",
            .anchor = "backward-compatibility",
            .level = .should,
            .keywords = .{"RECOMMENDED"},
            .party = .client,
            .text = "A client that only supports modern versions does not need to probe, but probing is still RECOMMENDED: some legacy servers do not validate that a request arrives after `initialize` and would process an era-ambiguous method (such as `tools/call`) under legacy semantics.",
        },
        .{
            .id = "basic/transports/streamable-http#001-d22fc3",
            .page = "basic/transports/streamable-http",
            .line = 47,
            .section = "",
            .anchor = "",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "The server MUST provide a single HTTP endpoint path (hereafter referred to as the MCP endpoint) that supports POST.",
        },
        .{
            .id = "basic/transports/streamable-http#002-dd4452",
            .page = "basic/transports/streamable-http",
            .line = 58,
            .section = "Security & Endpoint",
            .anchor = "security--endpoint",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST validate the `Origin` header on all incoming connections to prevent DNS rebinding attacks.",
        },
        .{
            .id = "basic/transports/streamable-http#003-e2a913",
            .page = "basic/transports/streamable-http",
            .line = 60,
            .section = "Security & Endpoint",
            .anchor = "security--endpoint",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the `Origin` header is present and invalid, servers MUST respond with HTTP 403 Forbidden.",
        },
        .{
            .id = "basic/transports/streamable-http#004-136bcf",
            .page = "basic/transports/streamable-http",
            .line = 60,
            .section = "Security & Endpoint",
            .anchor = "security--endpoint",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The HTTP response body MAY comprise a JSON-RPC error response that has no `id`.",
        },
        .{
            .id = "basic/transports/streamable-http#005-bbd3e5",
            .page = "basic/transports/streamable-http",
            .line = 63,
            .section = "Security & Endpoint",
            .anchor = "security--endpoint",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When running locally, servers SHOULD bind only to localhost (127.0.0.1) rather than all network interfaces (0.0.0.0).",
        },
        .{
            .id = "basic/transports/streamable-http#006-af1533",
            .page = "basic/transports/streamable-http",
            .line = 65,
            .section = "Security & Endpoint",
            .anchor = "security--endpoint",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD implement proper authentication for all connections.",
        },
        .{
            .id = "basic/transports/streamable-http#007-94434b",
            .page = "basic/transports/streamable-http",
            .line = 72,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Every JSON-RPC message sent from the client MUST be a new HTTP POST request to the MCP endpoint.",
        },
        .{
            .id = "basic/transports/streamable-http#008-50086e",
            .page = "basic/transports/streamable-http",
            .line = 75,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The client MUST use HTTP POST to send JSON-RPC messages.",
        },
        .{
            .id = "basic/transports/streamable-http#009-6aa4f4",
            .page = "basic/transports/streamable-http",
            .line = 76,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The client MUST include an `Accept` header listing both `application/json` and `text/event-stream` as supported content types.",
        },
        .{
            .id = "basic/transports/streamable-http#010-32ff8c",
            .page = "basic/transports/streamable-http",
            .line = 78,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The client MUST include the request metadata headers on each POST request.",
        },
        .{
            .id = "basic/transports/streamable-http#011-039bbc",
            .page = "basic/transports/streamable-http",
            .line = 80,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The body of the HTTP POST MUST be a single JSON-RPC request or notification.",
        },
        .{
            .id = "basic/transports/streamable-http#012-c300e2",
            .page = "basic/transports/streamable-http",
            .line = 80,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "The client MUST NOT send JSON-RPC responses.",
        },
        .{
            .id = "basic/transports/streamable-http#013-15b7ae",
            .page = "basic/transports/streamable-http",
            .line = 83,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the server accepts it, the server MUST return HTTP status code `202 Accepted` with no body.",
        },
        .{
            .id = "basic/transports/streamable-http#014-910572",
            .page = "basic/transports/streamable-http",
            .line = 85,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the server cannot accept it, it MUST return an HTTP error status code (e.g., `400 Bad Request`).",
        },
        .{
            .id = "basic/transports/streamable-http#015-136bcf",
            .page = "basic/transports/streamable-http",
            .line = 85,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The HTTP response body MAY comprise a JSON-RPC error response that has no `id`.",
        },
        .{
            .id = "basic/transports/streamable-http#016-745335",
            .page = "basic/transports/streamable-http",
            .line = 88,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the body is a JSON-RPC request, the server MUST return either `Content-Type: application/json` (a single JSON object) or `Content-Type: text/event-stream` (an SSE response stream).",
        },
        .{
            .id = "basic/transports/streamable-http#017-a24561",
            .page = "basic/transports/streamable-http",
            .line = 88,
            .section = "Sending Messages",
            .anchor = "sending-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The client MUST support both.",
        },
        .{
            .id = "basic/transports/streamable-http#018-bf57aa",
            .page = "basic/transports/streamable-http",
            .line = 112,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The server MAY send JSON-RPC notifications \xe2\x80\x94 for example, [`notifications/progress`][notifications-progress] or [`notifications/message`][notifications-message] \xe2\x80\x94 before the final response.",
        },
        .{
            .id = "basic/transports/streamable-http#019-2f0a7c",
            .page = "basic/transports/streamable-http",
            .line = 112,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "These notifications MUST relate to the originating client request.",
        },
        .{
            .id = "basic/transports/streamable-http#020-d8f377",
            .page = "basic/transports/streamable-http",
            .line = 117,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The server MUST NOT send independent JSON-RPC requests on this stream.",
        },
        .{
            .id = "basic/transports/streamable-http#021-c45fd7",
            .page = "basic/transports/streamable-http",
            .line = 125,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "The final JSON-RPC response SHOULD terminate the stream.",
        },
        .{
            .id = "basic/transports/streamable-http#022-34d5ee",
            .page = "basic/transports/streamable-http",
            .line = 136,
            .section = "Receiving Messages",
            .anchor = "receiving-messages",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When initiating an SSE stream, servers SHOULD include the `X-Accel-Buffering: no` header in the HTTP response.",
        },
        .{
            .id = "basic/transports/streamable-http#023-ef6066",
            .page = "basic/transports/streamable-http",
            .line = 235,
            .section = "Cancellation",
            .anchor = "cancellation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Closing the SSE response stream MUST be treated by the server as cancellation of that request.",
        },
        .{
            .id = "basic/transports/streamable-http#024-840ea9",
            .page = "basic/transports/streamable-http",
            .line = 235,
            .section = "Cancellation",
            .anchor = "cancellation",
            .level = .must_not,
            .keywords = .{"SHOULD", "MUST NOT"},
            .party = .server,
            .text = "The server SHOULD stop work on the cancelled request as soon as practical and MUST NOT send any further messages for it.",
        },
        .{
            .id = "basic/transports/streamable-http#025-c7b1aa",
            .page = "basic/transports/streamable-http",
            .line = 252,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Every POST request to the MCP endpoint MUST include an `MCP-Protocol-Version` header.",
        },
        .{
            .id = "basic/transports/streamable-http#026-164df3",
            .page = "basic/transports/streamable-http",
            .line = 257,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "The header value MUST match the `io.modelcontextprotocol/protocolVersion` field carried in the request body's `_meta`.",
        },
        .{
            .id = "basic/transports/streamable-http#027-43fe2e",
            .page = "basic/transports/streamable-http",
            .line = 257,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the values do not match, the server MUST reject the request with `400 Bad Request` and a `HeaderMismatch` JSON-RPC error (see Server Validation).",
        },
        .{
            .id = "basic/transports/streamable-http#028-202b5e",
            .page = "basic/transports/streamable-http",
            .line = 263,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the server does not implement the requested protocol version (whether the version is unknown to the server, or is a known version the server has chosen not to support), it MUST respond with `400 Bad Request` and an [`UnsupportedProtocolVersionError`][unsupported-version] listing its supported versions.",
        },
        .{
            .id = "basic/transports/streamable-http#029-f1b691",
            .page = "basic/transports/streamable-http",
            .line = 271,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the server does not implement the requested RPC method, it MUST respond with `404 Not Found` and a JSON-RPC error with code `-32601` (`Method not found`).",
        },
        .{
            .id = "basic/transports/streamable-http#030-0254c1",
            .page = "basic/transports/streamable-http",
            .line = 277,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "A server that supports clients implementing protocol versions earlier than `2025-06-18` (which did not define the `MCP-Protocol-Version` header) MAY treat a request that omits the header as protocol version `2025-03-26`.",
        },
        .{
            .id = "basic/transports/streamable-http#031-c8df24",
            .page = "basic/transports/streamable-http",
            .line = 277,
            .section = "Protocol Version Header",
            .anchor = "protocol-version-header",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "A server that does not support such clients MUST reject a request without the header per Server Validation.",
        },
        .{
            .id = "basic/transports/streamable-http#032-e9b585",
            .page = "basic/transports/streamable-http",
            .line = 293,
            .section = "Standard Request Headers",
            .anchor = "standard-request-headers",
            .level = .must,
            .keywords = .{"REQUIRED"},
            .party = .both,
            .text = "These headers are REQUIRED for compliance.",
        },
        .{
            .id = "basic/transports/streamable-http#033-fd9723",
            .page = "basic/transports/streamable-http",
            .line = 295,
            .section = "Standard Request Headers",
            .anchor = "standard-request-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "If the `Mcp-Name` source value cannot be safely represented as a plain ASCII header value, clients MUST encode it using the Base64 sentinel format described in Value Encoding.",
        },
        .{
            .id = "basic/transports/streamable-http#034-31a0b0",
            .page = "basic/transports/streamable-http",
            .line = 358,
            .section = "Custom Headers from Tool Parameters",
            .anchor = "custom-headers-from-tool-parameters",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "MCP servers MAY designate specific tool parameters to be mirrored into HTTP headers using an `x-mcp-header` extension property in the parameter's schema within the tool's `inputSchema`.",
        },
        .{
            .id = "basic/transports/streamable-http#035-88a625",
            .page = "basic/transports/streamable-http",
            .line = 364,
            .section = "Custom Headers from Tool Parameters",
            .anchor = "custom-headers-from-tool-parameters",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "While the use of `x-mcp-header` is optional for servers, clients MUST support this feature.",
        },
        .{
            .id = "basic/transports/streamable-http#036-f12d51",
            .page = "basic/transports/streamable-http",
            .line = 364,
            .section = "Custom Headers from Tool Parameters",
            .anchor = "custom-headers-from-tool-parameters",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When a server's tool definition includes `x-mcp-header` annotations, conforming clients MUST mirror the designated parameter values into HTTP headers.",
        },
        .{
            .id = "basic/transports/streamable-http#037-3620cf",
            .page = "basic/transports/streamable-http",
            .line = 378,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Constraints on `x-mcp-header` values: MUST NOT be empty",
        },
        .{
            .id = "basic/transports/streamable-http#038-7a25a1",
            .page = "basic/transports/streamable-http",
            .line = 379,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Constraints on `x-mcp-header` values: MUST match HTTP field-name token syntax (`1*tchar`, RFC 9110 Section 5.1)",
        },
        .{
            .id = "basic/transports/streamable-http#039-918204",
            .page = "basic/transports/streamable-http",
            .line = 380,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "Constraints on `x-mcp-header` values: MUST NOT contain control characters, including carriage return (CR, `\\r`) or line feed (LF, `\\n`)",
        },
        .{
            .id = "basic/transports/streamable-http#040-320806",
            .page = "basic/transports/streamable-http",
            .line = 382,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Constraints on `x-mcp-header` values: MUST be case-insensitively unique among all `x-mcp-header` values in the `inputSchema`",
        },
        .{
            .id = "basic/transports/streamable-http#041-fdcfc9",
            .page = "basic/transports/streamable-http",
            .line = 384,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Constraints on `x-mcp-header` values: MUST only be applied to parameters with primitive types (integer, string, boolean).",
        },
        .{
            .id = "basic/transports/streamable-http#042-60184f",
            .page = "basic/transports/streamable-http",
            .line = 384,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Integer values MUST be within the safe range for JavaScript (\xe2\x88\x922^53+1 to 2^53\xe2\x88\x921)",
        },
        .{
            .id = "basic/transports/streamable-http#043-a31f64",
            .page = "basic/transports/streamable-http",
            .line = 388,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Constraints on `x-mcp-header` values: MUST only be applied to properties that are statically reachable from the schema root: reachable via a chain consisting solely of `properties` keys.",
        },
        .{
            .id = "basic/transports/streamable-http#044-245311",
            .page = "basic/transports/streamable-http",
            .line = 388,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .both,
            .text = "The chain MUST NOT pass through `items` (or any other array keyword), composition keywords (`oneOf`, `anyOf`, `allOf`, `not`), conditional keywords (`if`/`then`/`else`), or `$ref`.",
        },
        .{
            .id = "basic/transports/streamable-http#045-a33f54",
            .page = "basic/transports/streamable-http",
            .line = 402,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients using the Streamable HTTP transport MUST reject tool definitions where any `x-mcp-header` value violates these constraints.",
        },
        .{
            .id = "basic/transports/streamable-http#046-998b88",
            .page = "basic/transports/streamable-http",
            .line = 402,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Rejection means the client MUST exclude the invalid tool from the result of `tools/list`.",
        },
        .{
            .id = "basic/transports/streamable-http#047-a49250",
            .page = "basic/transports/streamable-http",
            .line = 402,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD log a warning when rejecting a tool definition, including the tool name and the reason for rejection.",
        },
        .{
            .id = "basic/transports/streamable-http#048-780a5a",
            .page = "basic/transports/streamable-http",
            .line = 402,
            .section = "Schema Extension",
            .anchor = "schema-extension",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients using other transports (e.g., stdio) MAY ignore `x-mcp-header` annotations entirely.",
        },
        .{
            .id = "basic/transports/streamable-http#049-c17076",
            .page = "basic/transports/streamable-http",
            .line = 469,
            .section = "Value Encoding",
            .anchor = "value-encoding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST encode parameter values before including them in HTTP headers to ensure safe transmission and prevent injection attacks.",
        },
        .{
            .id = "basic/transports/streamable-http#050-f69c51",
            .page = "basic/transports/streamable-http",
            .line = 478,
            .section = "Value Encoding",
            .anchor = "value-encoding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When a value cannot be safely represented as a plain ASCII header value (e.g., it contains non-ASCII characters, control characters, or has leading/trailing whitespace), clients MUST use Base64 encoding of the UTF-8 representation with the following format:",
        },
        .{
            .id = "basic/transports/streamable-http#051-5055c9",
            .page = "basic/transports/streamable-http",
            .line = 498,
            .section = "Value Encoding",
            .anchor = "value-encoding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "These markers are case-sensitive and MUST appear exactly as shown (lowercase).",
        },
        .{
            .id = "basic/transports/streamable-http#052-a9c927",
            .page = "basic/transports/streamable-http",
            .line = 498,
            .section = "Value Encoding",
            .anchor = "value-encoding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers and intermediaries that need to inspect these values MUST decode them accordingly.",
        },
        .{
            .id = "basic/transports/streamable-http#053-5ed8ff",
            .page = "basic/transports/streamable-http",
            .line = 498,
            .section = "Value Encoding",
            .anchor = "value-encoding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "In particular, servers MUST decode an encoded `Mcp-Name` or `Mcp-Param-{Name}` value before comparing it to the corresponding request body value during Server Validation.",
        },
        .{
            .id = "basic/transports/streamable-http#054-9c6bd4",
            .page = "basic/transports/streamable-http",
            .line = 506,
            .section = "Value Encoding",
            .anchor = "value-encoding",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "To avoid ambiguity, clients MUST also Base64-encode any plain-ASCII value that matches the sentinel pattern (i.e., starts with `=?base64?` and ends with `?=`).",
        },
        .{
            .id = "basic/transports/streamable-http#055-bbab2c",
            .page = "basic/transports/streamable-http",
            .line = 527,
            .section = "Client Behavior",
            .anchor = "client-behavior",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When constructing a `tools/call` request via HTTP transport, the client MUST: Extract the values for any standard headers from the request body (e.g., `method`, `params.name`, `params.uri`).",
        },
        .{
            .id = "basic/transports/streamable-http#056-c8c22b",
            .page = "basic/transports/streamable-http",
            .line = 529,
            .section = "Client Behavior",
            .anchor = "client-behavior",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When constructing a `tools/call` request via HTTP transport, the client MUST: Append the `Mcp-Method` header and, if applicable, `Mcp-Name` header to the request.",
        },
        .{
            .id = "basic/transports/streamable-http#057-ee18af",
            .page = "basic/transports/streamable-http",
            .line = 531,
            .section = "Client Behavior",
            .anchor = "client-behavior",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When constructing a `tools/call` request via HTTP transport, the client MUST: Inspect the tool's `inputSchema` for properties marked with `x-mcp-header` and extract the value at each annotated property's exact property path, omitting the header when no value is present (see Schema Extension).",
        },
        .{
            .id = "basic/transports/streamable-http#058-f2d64c",
            .page = "basic/transports/streamable-http",
            .line = 535,
            .section = "Client Behavior",
            .anchor = "client-behavior",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When constructing a `tools/call` request via HTTP transport, the client MUST: Encode the values according to the Value Encoding rules.",
        },
        .{
            .id = "basic/transports/streamable-http#059-bcbd77",
            .page = "basic/transports/streamable-http",
            .line = 537,
            .section = "Client Behavior",
            .anchor = "client-behavior",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When constructing a `tools/call` request via HTTP transport, the client MUST: Append a `Mcp-Param-{Name}: {Value}` header to the request.",
        },
        .{
            .id = "basic/transports/streamable-http#060-bcae14",
            .page = "basic/transports/streamable-http",
            .line = 539,
            .section = "Client Behavior",
            .anchor = "client-behavior",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "If the server rejects a request with a `HeaderMismatch` error because required `Mcp-Param-*` headers are missing or do not match the body, the client SHOULD call `tools/list` to check for changes to the tool's `inputSchema`, then retry the original request with the appropriate headers.",
        },
        .{
            .id = "basic/transports/streamable-http#061-cc05d4",
            .page = "basic/transports/streamable-http",
            .line = 548,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Intermediate servers that do not recognize an `Mcp-Param-{Name}` header MUST forward it and otherwise ignore it, as required by the [HTTP Semantics RFC][http-semantics].",
        },
        .{
            .id = "basic/transports/streamable-http#062-15d3eb",
            .page = "basic/transports/streamable-http",
            .line = 552,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST reject requests with a recognized `Mcp-Param-{Name}` header that contains invalid characters (see Value Encoding).",
        },
        .{
            .id = "basic/transports/streamable-http#063-d06efd",
            .page = "basic/transports/streamable-http",
            .line = 555,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Any server that processes the message body MUST validate that encoded header values, after decoding if Base64-encoded, match the corresponding values in the request body.",
        },
        .{
            .id = "basic/transports/streamable-http#064-243588",
            .page = "basic/transports/streamable-http",
            .line = 555,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST reject requests with a `400 Bad Request` HTTP status and JSON-RPC error code `-32020` (`HeaderMismatch`) if any validation fails.",
        },
        .{
            .id = "basic/transports/streamable-http#065-91d4e6",
            .page = "basic/transports/streamable-http",
            .line = 563,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Parameter value provided: Client MUST include the header",
        },
        .{
            .id = "basic/transports/streamable-http#066-6bb4df",
            .page = "basic/transports/streamable-http",
            .line = 563,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Parameter value provided: Server MUST validate header matches body",
        },
        .{
            .id = "basic/transports/streamable-http#067-338f54",
            .page = "basic/transports/streamable-http",
            .line = 564,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Parameter value is `null`: Client MUST omit the header",
        },
        .{
            .id = "basic/transports/streamable-http#068-701c57",
            .page = "basic/transports/streamable-http",
            .line = 564,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Parameter value is `null`: Server MUST NOT expect the header",
        },
        .{
            .id = "basic/transports/streamable-http#069-4d622c",
            .page = "basic/transports/streamable-http",
            .line = 565,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Parameter not in arguments: Client MUST omit the header",
        },
        .{
            .id = "basic/transports/streamable-http#070-d7b90d",
            .page = "basic/transports/streamable-http",
            .line = 565,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Parameter not in arguments: Server MUST NOT expect the header",
        },
        .{
            .id = "basic/transports/streamable-http#071-d4e1bf",
            .page = "basic/transports/streamable-http",
            .line = 566,
            .section = "Server Behavior for Custom Headers",
            .anchor = "server-behavior-for-custom-headers",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Client omits header but value is in body: Server MUST reject the request",
        },
        .{
            .id = "basic/transports/streamable-http#072-71317f",
            .page = "basic/transports/streamable-http",
            .line = 572,
            .section = "Case Sensitivity",
            .anchor = "case-sensitivity",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Clients and servers MUST use case-insensitive comparisons for header names.",
        },
        .{
            .id = "basic/transports/streamable-http#073-3b889f",
            .page = "basic/transports/streamable-http",
            .line = 582,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers that process the request body MUST reject requests where the values specified in the headers do not match the corresponding values in the request body.",
        },
        .{
            .id = "basic/transports/streamable-http#074-5667ff",
            .page = "basic/transports/streamable-http",
            .line = 591,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "When validating integer parameter values, servers SHOULD compare the header value and the body value numerically rather than as strings (e.g., `42.0` and `42` are considered equal).",
        },
        .{
            .id = "basic/transports/streamable-http#075-a99164",
            .page = "basic/transports/streamable-http",
            .line = 597,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "When rejecting a request due to header validation failure, servers MUST return HTTP status `400 Bad Request` and MUST include a JSON-RPC error response using the following error code:",
        },
        .{
            .id = "basic/transports/streamable-http#076-3bf923",
            .page = "basic/transports/streamable-http",
            .line = 626,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "For headers that permit the Base64 sentinel encoding (`Mcp-Name` and `Mcp-Param-{Name}`), servers MUST decode encoded values (see Value Encoding) before comparing them to the body value.",
        },
        .{
            .id = "basic/transports/streamable-http#077-f1bda2",
            .page = "basic/transports/streamable-http",
            .line = 634,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Intermediaries MUST return an appropriate HTTP error status (e.g., `400 Bad Request`) for validation failures but are not required to return a JSON-RPC error response.",
        },
        .{
            .id = "basic/transports/streamable-http#078-92be48",
            .page = "basic/transports/streamable-http",
            .line = 642,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Intermediaries that enforce policy based on mirrored headers (e.g., routing or rate-limiting by tenant) SHOULD verify that the `MCP-Protocol-Version` header indicates a version that requires header\xe2\x80\x93body validation.",
        },
        .{
            .id = "basic/transports/streamable-http#079-567c06",
            .page = "basic/transports/streamable-http",
            .line = 642,
            .section = "Server Validation",
            .anchor = "server-validation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "If the version is older or the header is absent, the intermediary SHOULD reject the request rather than trusting unvalidated header values.",
        },
        .{
            .id = "basic/transports/streamable-http#080-060656",
            .page = "basic/transports/streamable-http",
            .line = 652,
            .section = "Backward Compatibility",
            .anchor = "backward-compatibility",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "A client that supports both modern (per-request-metadata) MCP versions and a legacy version that requires an `initialize` handshake MAY detect which era the server implements by attempting a modern request first.",
        },
        .{
            .id = "basic/transports/streamable-http#081-efc5ff",
            .page = "basic/transports/streamable-http",
            .line = 652,
            .section = "Backward Compatibility",
            .anchor = "backward-compatibility",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "On `400 Bad Request`, the client SHOULD inspect the response body before falling back: modern servers also use `400` for [`UnsupportedProtocolVersionError`][unsupported-version], `MissingRequiredClientCapabilityError`, and header-validation failures.",
        },
        .{
            .id = "basic/transports/streamable-http#082-bd5d2b",
            .page = "basic/transports/streamable-http",
            .line = 683,
            .section = "Earlier Streamable HTTP Revisions",
            .anchor = "earlier-streamable-http-revisions",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "A server that supports only this revision and receives such traffic from an older client SHOULD respond as follows: HTTP GET or DELETE to the MCP endpoint: respond with `405 Method Not Allowed`.",
        },
        .{
            .id = "basic/transports/streamable-http#083-9298dd",
            .page = "basic/transports/streamable-http",
            .line = 685,
            .section = "Earlier Streamable HTTP Revisions",
            .anchor = "earlier-streamable-http-revisions",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "A server that supports only this revision and receives such traffic from an older client SHOULD respond as follows: An `Mcp-Session-Id` header on a request: ignore it, and do not mint or echo session IDs.",
        },
        .{
            .id = "basic/transports/streamable-http#084-20985a",
            .page = "basic/transports/streamable-http",
            .line = 687,
            .section = "Earlier Streamable HTTP Revisions",
            .anchor = "earlier-streamable-http-revisions",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "A server that supports only this revision and receives such traffic from an older client SHOULD respond as follows: A `Last-Event-ID` header: ignore it; streams are not resumable.",
        },
        .{
            .id = "basic/transports/streamable-http#085-62da9b",
            .page = "basic/transports/streamable-http",
            .line = 698,
            .section = "HTTP+SSE Transport (2024-11-05)",
            .anchor = "httpsse-transport-2024-11-05",
            .level = .should_not,
            .keywords = .{"SHOULD NOT", "SHOULD"},
            .party = .both,
            .text = "New implementations SHOULD NOT adopt it; existing implementations SHOULD migrate to Streamable HTTP.",
        },
        .{
            .id = "basic/versioning#001-95370e",
            .page = "basic/versioning",
            .line = 48,
            .section = "Protocol Version Negotiation",
            .anchor = "protocol-version-negotiation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "If the server does not implement the requested version (whether the version is unknown to the server, or is a known version the server has chosen not to support), it MUST respond with an `UnsupportedProtocolVersionError` listing the versions it does support:",
        },
        .{
            .id = "basic/versioning#002-ecd784",
            .page = "basic/versioning",
            .line = 69,
            .section = "Protocol Version Negotiation",
            .anchor = "protocol-version-negotiation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "The client SHOULD select a mutually supported version from the `supported` list and retry the request, or surface an error to the user if no compatible version exists.",
        },
        .{
            .id = "basic/versioning#003-7526dd",
            .page = "basic/versioning",
            .line = 73,
            .section = "Protocol Version Negotiation",
            .anchor = "protocol-version-negotiation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST implement `server/discover`.",
        },
        .{
            .id = "basic/versioning#004-c10fdb",
            .page = "basic/versioning",
            .line = 73,
            .section = "Protocol Version Negotiation",
            .anchor = "protocol-version-negotiation",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY call it before sending any other requests to learn the server's supported versions up front, but are not required to: a client is free to invoke any RPC inline and handle `UnsupportedProtocolVersionError` if its preferred version is not supported.",
        },
        .{
            .id = "basic/versioning#005-727c1c",
            .page = "basic/versioning",
            .line = 82,
            .section = "Extension Negotiation",
            .anchor = "extension-negotiation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Extension identifiers MUST follow the `_meta` key naming rules, with a mandatory prefix.",
        },
        .{
            .id = "basic/versioning#006-9d13bf",
            .page = "basic/versioning",
            .line = 121,
            .section = "Extension Negotiation",
            .anchor = "extension-negotiation",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "If one party supports an extension but the other does not, the supporting party MUST either revert to core protocol behavior or reject the request with an appropriate error.",
        },
        .{
            .id = "basic/versioning#007-6202a2",
            .page = "basic/versioning",
            .line = 121,
            .section = "Extension Negotiation",
            .anchor = "extension-negotiation",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Extensions SHOULD document their expected fallback behavior.",
        },
        .{
            .id = "basic/versioning#008-72bba1",
            .page = "basic/versioning",
            .line = 128,
            .section = "Backward Compatibility with Initialization-Based Versions",
            .anchor = "backward-compatibility-with-initialization-based-versions",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "A server that wishes to support both legacy clients (which expect an `initialize` handshake) and modern clients (which use per-request metadata) MAY implement both behaviors.",
        },
        .{
            .id = "basic/versioning#009-75a842",
            .page = "basic/versioning",
            .line = 148,
            .section = "Backward Compatibility with Initialization-Based Versions",
            .anchor = "backward-compatibility-with-initialization-based-versions",
            .level = .should,
            .keywords = .{"SHOULD", "MAY"},
            .party = .client,
            .text = "Clients SHOULD cache the result for the lifetime of the server process (stdio) or origin (HTTP), and MAY persist it across restarts of the same server configuration, re-probing if the cached assumption later fails.",
        },
        .{
            .id = "basic/versioning#010-06f4c4",
            .page = "basic/versioning",
            .line = 154,
            .section = "Backward Compatibility with Initialization-Based Versions",
            .anchor = "backward-compatibility-with-initialization-based-versions",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "A server that supports only modern versions SHOULD name the protocol versions it supports in any error it returns to an `initialize` request, on any transport: legacy clients have no fall-forward mechanism, and this message may be the only diagnostic they can surface to users.",
        },
        .{
            .id = "basic/versioning#011-ae340b",
            .page = "basic/versioning",
            .line = 167,
            .section = "Compatibility Matrix",
            .anchor = "compatibility-matrix",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Modern: On stdio, clients SHOULD send `server/discover` first to fail deterministically; the client then surfaces an actionable error to the user.",
        },
        .{
            .id = "basic/versioning#012-f3b249",
            .page = "basic/versioning",
            .line = 182,
            .section = "Compatibility Matrix",
            .anchor = "compatibility-matrix",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "A dual-era server MAY serve both eras concurrently on the same endpoint or process.",
        },
        .{
            .id = "client/elicitation#001-f14bc5",
            .page = "client/elicitation",
            .line = 30,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT use form mode elicitation to request sensitive information such as passwords, API keys, access tokens, or payment credentials",
        },
        .{
            .id = "client/elicitation#002-b176a1",
            .page = "client/elicitation",
            .line = 32,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST use URL mode for interactions involving such sensitive information",
        },
        .{
            .id = "client/elicitation#003-4e24ca",
            .page = "client/elicitation",
            .line = 42,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST: Provide UI that makes it clear which server is requesting information",
        },
        .{
            .id = "client/elicitation#004-ab93b2",
            .page = "client/elicitation",
            .line = 43,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST: Respect user privacy and provide clear decline and cancel options",
        },
        .{
            .id = "client/elicitation#005-fc80f1",
            .page = "client/elicitation",
            .line = 44,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST: For form mode, allow users to review and modify their responses before sending",
        },
        .{
            .id = "client/elicitation#006-498df1",
            .page = "client/elicitation",
            .line = 45,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "MCP clients MUST: For URL mode, clearly display the target domain/host and gather user consent before navigation to the target URL",
        },
        .{
            .id = "client/elicitation#007-9db435",
            .page = "client/elicitation",
            .line = 51,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients that support elicitation MUST declare the `elicitation` capability in `_meta.io.modelcontextprotocol/clientCapabilities` on each request:",
        },
        .{
            .id = "client/elicitation#008-1bae12",
            .page = "client/elicitation",
            .line = 79,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients declaring the `elicitation` capability MUST support at least one mode (`form` or `url`).",
        },
        .{
            .id = "client/elicitation#009-3914b8",
            .page = "client/elicitation",
            .line = 81,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT send elicitation requests with modes that are not supported by the client.",
        },
        .{
            .id = "client/elicitation#010-9b99a7",
            .page = "client/elicitation",
            .line = 87,
            .section = "Elicitation Requests",
            .anchor = "elicitation-requests",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "Servers MAY request information from a user during the processing of a client request, by sending an `InputRequiredResult` containing an `elicitation/create` request.",
        },
        .{
            .id = "client/elicitation#011-6855da",
            .page = "client/elicitation",
            .line = 90,
            .section = "Elicitation Requests",
            .anchor = "elicitation-requests",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "All elicitation requests MUST include the following parameters:",
        },
        .{
            .id = "client/elicitation#012-03410c",
            .page = "client/elicitation",
            .line = 102,
            .section = "Elicitation Requests",
            .anchor = "elicitation-requests",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "For backwards compatibility, servers MAY omit the `mode` field for form mode elicitation requests.",
        },
        .{
            .id = "client/elicitation#013-4db1a3",
            .page = "client/elicitation",
            .line = 102,
            .section = "Elicitation Requests",
            .anchor = "elicitation-requests",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST treat requests without a `mode` field as form mode.",
        },
        .{
            .id = "client/elicitation#014-b8a680",
            .page = "client/elicitation",
            .line = 108,
            .section = "Form Mode Elicitation Requests",
            .anchor = "form-mode-elicitation-requests",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Form mode elicitation requests MUST either specify `mode: \"form\"` or omit the `mode` field, and include these additional parameters:",
        },
        .{
            .id = "client/elicitation#015-8bf2e6",
            .page = "client/elicitation",
            .line = 237,
            .section = "Requested Schema",
            .anchor = "requested-schema",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients that support defaults SHOULD pre-populate form fields with these values.",
        },
        .{
            .id = "client/elicitation#016-fab8c9",
            .page = "client/elicitation",
            .line = 332,
            .section = "URL Mode Elicitation Requests",
            .anchor = "url-mode-elicitation-requests",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "URL mode elicitation requests MUST specify `mode: \"url\"`, a `message`, and include these additional parameters:",
        },
        .{
            .id = "client/elicitation#017-ff2b57",
            .page = "client/elicitation",
            .line = 338,
            .section = "URL Mode Elicitation Requests",
            .anchor = "url-mode-elicitation-requests",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The `url` parameter MUST contain a valid URL.",
        },
        .{
            .id = "client/elicitation#018-70482f",
            .page = "client/elicitation",
            .line = 376,
            .section = "Example: Request Sensitive Data",
            .anchor = "example-request-sensitive-data",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD provide manual controls that let the user retry or cancel the original request (or otherwise resume interacting with the client).",
        },
        .{
            .id = "client/elicitation#019-12f395",
            .page = "client/elicitation",
            .line = 475,
            .section = "Statefulness",
            .anchor = "statefulness",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "However, if state is stored, servers implementing elicitation MUST securely associate this state with individual users following the guidelines in the security best practices document.",
        },
        .{
            .id = "client/elicitation#020-a4073e",
            .page = "client/elicitation",
            .line = 477,
            .section = "Statefulness",
            .anchor = "statefulness",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "State storage MUST be protected against unauthorized access",
        },
        .{
            .id = "client/elicitation#021-8cb322",
            .page = "client/elicitation",
            .line = 478,
            .section = "Statefulness",
            .anchor = "statefulness",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "For remote MCP servers, user identification MUST be derived from credentials acquired via MCP authorization when possible (e.g. `sub` claim)",
        },
        .{
            .id = "client/elicitation#022-db9b69",
            .page = "client/elicitation",
            .line = 502,
            .section = "URL Mode Elicitation for OAuth Flows",
            .anchor = "url-mode-elicitation-for-oauth-flows",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "MCP servers MUST NOT rely on URL mode elicitation to authorize users for themselves.",
        },
        .{
            .id = "client/elicitation#023-38668d",
            .page = "client/elicitation",
            .line = 523,
            .section = "Understanding the Distinction",
            .anchor = "understanding-the-distinction",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "The third-party credentials MUST NOT transit through the MCP client: The client must never see third-party credentials to protect the security boundary",
        },
        .{
            .id = "client/elicitation#024-6d7d4a",
            .page = "client/elicitation",
            .line = 524,
            .section = "Understanding the Distinction",
            .anchor = "understanding-the-distinction",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The MCP server MUST NOT use the client's credentials for the third-party service: That would be token passthrough, which is forbidden",
        },
        .{
            .id = "client/elicitation#025-59c9a4",
            .page = "client/elicitation",
            .line = 525,
            .section = "Understanding the Distinction",
            .anchor = "understanding-the-distinction",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The user MUST authorize the MCP server directly: The interaction happens outside the MCP protocol, without involving the MCP client",
        },
        .{
            .id = "client/elicitation#026-da3b32",
            .page = "client/elicitation",
            .line = 528,
            .section = "Understanding the Distinction",
            .anchor = "understanding-the-distinction",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "The MCP server MUST NOT transmit credentials obtained through URL mode elicitation to the MCP client.",
        },
        .{
            .id = "client/elicitation#027-43d41c",
            .page = "client/elicitation",
            .line = 591,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .must,
            .keywords = .{"SHOULD NOT", "MUST"},
            .party = .server,
            .text = "Servers SHOULD NOT assume that elicitation requests will always succeed, and MUST handle cases where the user declines or cancels the elicitation, or where the client fails to process the request.",
        },
        .{
            .id = "client/elicitation#028-302fe6",
            .page = "client/elicitation",
            .line = 595,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST bind elicitation requests to the client and user identity",
        },
        .{
            .id = "client/elicitation#029-2d0c6c",
            .page = "client/elicitation",
            .line = 596,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST provide clear indication of which server is requesting information",
        },
        .{
            .id = "client/elicitation#030-ec4f08",
            .page = "client/elicitation",
            .line = 597,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD implement user approval controls",
        },
        .{
            .id = "client/elicitation#031-a08004",
            .page = "client/elicitation",
            .line = 598,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD allow users to decline elicitation requests at any time",
        },
        .{
            .id = "client/elicitation#032-4cd204",
            .page = "client/elicitation",
            .line = 599,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD present elicitation requests in a way that makes it clear what information is being requested and why",
        },
        .{
            .id = "client/elicitation#033-4fed5b",
            .page = "client/elicitation",
            .line = 605,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "MCP servers requesting elicitation: MUST NOT include sensitive information about the end-user, including credentials, personally identifiable information, etc., in the URL sent to the client in a URL elicitation request.",
        },
        .{
            .id = "client/elicitation#034-2cf25e",
            .page = "client/elicitation",
            .line = 606,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "MCP servers requesting elicitation: MUST NOT provide a URL which is pre-authenticated to access a protected resource, as the URL could be used to impersonate the user by a malicious client.",
        },
        .{
            .id = "client/elicitation#035-7d04ab",
            .page = "client/elicitation",
            .line = 607,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .server,
            .text = "MCP servers requesting elicitation: SHOULD NOT include URLs intended to be clickable in any field of a form mode elicitation request.",
        },
        .{
            .id = "client/elicitation#036-927b91",
            .page = "client/elicitation",
            .line = 608,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "MCP servers requesting elicitation: SHOULD use HTTPS URLs for non-development environments.",
        },
        .{
            .id = "client/elicitation#037-f7ff6b",
            .page = "client/elicitation",
            .line = 612,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients implementing URL mode elicitation MUST handle URLs carefully to prevent users from unknowingly clicking malicious links.",
        },
        .{
            .id = "client/elicitation#038-671fc5",
            .page = "client/elicitation",
            .line = 616,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: MUST NOT automatically pre-fetch the URL or any of its metadata.",
        },
        .{
            .id = "client/elicitation#039-898f14",
            .page = "client/elicitation",
            .line = 617,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: MUST NOT open the URL without explicit consent from the user.",
        },
        .{
            .id = "client/elicitation#040-1b6c2f",
            .page = "client/elicitation",
            .line = 618,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: MUST show the full URL to the user for examination before consent.",
        },
        .{
            .id = "client/elicitation#041-6ac848",
            .page = "client/elicitation",
            .line = 619,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: MUST open the URL provided by the server in a secure manner that does not enable the client or LLM to inspect the content or user inputs.",
        },
        .{
            .id = "client/elicitation#042-5934f2",
            .page = "client/elicitation",
            .line = 621,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: SHOULD highlight the domain of the URL to mitigate subdomain spoofing.",
        },
        .{
            .id = "client/elicitation#043-654dee",
            .page = "client/elicitation",
            .line = 622,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: SHOULD have warnings for ambiguous/suspicious URIs (i.e., containing Punycode).",
        },
        .{
            .id = "client/elicitation#044-82c380",
            .page = "client/elicitation",
            .line = 623,
            .section = "Safe URL Handling",
            .anchor = "safe-url-handling",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .client,
            .text = "When handling URL mode elicitation requests, MCP clients: SHOULD NOT render URLs as clickable in any field of an elicitation request, except for the `url` field in a URL elicitation request (with the restrictions detailed above).",
        },
        .{
            .id = "client/elicitation#045-9c7f68",
            .page = "client/elicitation",
            .line = 627,
            .section = "Identifying the User",
            .anchor = "identifying-the-user",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT rely on client-provided user identification without server verification, as this can be forged.",
        },
        .{
            .id = "client/elicitation#046-a68e26",
            .page = "client/elicitation",
            .line = 627,
            .section = "Identifying the User",
            .anchor = "identifying-the-user",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Instead, servers SHOULD follow security best practices.",
        },
        .{
            .id = "client/elicitation#047-6cd76a",
            .page = "client/elicitation",
            .line = 637,
            .section = "Form Mode Security",
            .anchor = "form-mode-security",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT request sensitive information (passwords, API keys, etc.) via form mode",
        },
        .{
            .id = "client/elicitation#048-a08fcb",
            .page = "client/elicitation",
            .line = 638,
            .section = "Form Mode Security",
            .anchor = "form-mode-security",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD validate all responses against the provided schema",
        },
        .{
            .id = "client/elicitation#049-557a99",
            .page = "client/elicitation",
            .line = 639,
            .section = "Form Mode Security",
            .anchor = "form-mode-security",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD validate received data matches the requested schema",
        },
        .{
            .id = "client/elicitation#050-a75c09",
            .page = "client/elicitation",
            .line = 643,
            .section = "Phishing",
            .anchor = "phishing",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "The MCP Server MUST verify the identity of the user who opens the URL before accepting information.",
        },
        .{
            .id = "client/elicitation#051-51ff15",
            .page = "client/elicitation",
            .line = 657,
            .section = "Phishing",
            .anchor = "phishing",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "To prevent this attack, the server MUST ensure that the user who started the elicitation request (the end-user who is accessing the server via the MCP client) is the same user who completes the authorization flow.",
        },
        .{
            .id = "client/elicitation#052-6183b2",
            .page = "client/elicitation",
            .line = 671,
            .section = "Phishing",
            .anchor = "phishing",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "In all implementations, the server MUST ensure that the mechanism to determine the user's identity is resilient to attacks where an attacker can modify the elicitation URL.",
        },
        .{
            .id = "client/roots#001-5acd21",
            .page = "client/roots",
            .line = 8,
            .section = "",
            .anchor = "",
            .level = .should_not,
            .keywords = .{"SHOULD NOT", "SHOULD"},
            .party = .both,
            .text = "New implementations SHOULD NOT adopt it; existing implementations SHOULD migrate to passing directories or files via tool parameters, resource URIs, or server configuration.",
        },
        .{
            .id = "client/roots#002-626c7b",
            .page = "client/roots",
            .line = 40,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients that support roots MUST declare the `roots` capability in `_meta.io.modelcontextprotocol/clientCapabilities` on each request:",
        },
        .{
            .id = "client/roots#003-144c5a",
            .page = "client/roots",
            .line = 100,
            .section = "Root",
            .anchor = "root",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "This MUST be a `file://` URI in the current specification.",
        },
        .{
            .id = "client/roots#004-fc9b29",
            .page = "client/roots",
            .line = 138,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST: Only expose roots with appropriate permissions",
        },
        .{
            .id = "client/roots#005-9e33d1",
            .page = "client/roots",
            .line = 139,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST: Validate all root URIs to prevent path traversal",
        },
        .{
            .id = "client/roots#006-8dccb7",
            .page = "client/roots",
            .line = 140,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST: Implement proper access controls",
        },
        .{
            .id = "client/roots#007-bb0a21",
            .page = "client/roots",
            .line = 141,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST: Monitor root accessibility",
        },
        .{
            .id = "client/roots#008-5630f5",
            .page = "client/roots",
            .line = 144,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Handle cases where roots become unavailable",
        },
        .{
            .id = "client/roots#009-ae0646",
            .page = "client/roots",
            .line = 145,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Respect root boundaries during operations",
        },
        .{
            .id = "client/roots#010-3e1198",
            .page = "client/roots",
            .line = 146,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Validate all paths against provided roots",
        },
        .{
            .id = "client/roots#011-4b7cdd",
            .page = "client/roots",
            .line = 151,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Prompt users for consent before exposing roots to servers",
        },
        .{
            .id = "client/roots#012-92ab26",
            .page = "client/roots",
            .line = 152,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Provide clear user interfaces for root management",
        },
        .{
            .id = "client/roots#013-6b1f94",
            .page = "client/roots",
            .line = 153,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Validate root accessibility before exposing",
        },
        .{
            .id = "client/roots#014-417796",
            .page = "client/roots",
            .line = 154,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD: Monitor for root changes",
        },
        .{
            .id = "client/roots#015-705908",
            .page = "client/roots",
            .line = 157,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Check for roots capability before usage",
        },
        .{
            .id = "client/roots#016-67b45b",
            .page = "client/roots",
            .line = 158,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Respect root boundaries in operations",
        },
        .{
            .id = "client/roots#017-9ce8bb",
            .page = "client/roots",
            .line = 159,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD: Cache root information appropriately",
        },
        .{
            .id = "client/sampling#001-df2beb",
            .page = "client/sampling",
            .line = 8,
            .section = "",
            .anchor = "",
            .level = .should_not,
            .keywords = .{"SHOULD NOT", "SHOULD"},
            .party = .both,
            .text = "New implementations SHOULD NOT adopt it; existing implementations SHOULD migrate to integrating directly with LLM provider APIs.",
        },
        .{
            .id = "client/sampling#002-c1c0b6",
            .page = "client/sampling",
            .line = 37,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "For trust & safety and security, there SHOULD always be a human in the loop with the ability to deny sampling requests.",
        },
        .{
            .id = "client/sampling#003-3aa87f",
            .page = "client/sampling",
            .line = 42,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Applications SHOULD: Provide UI that makes it easy and intuitive to review sampling requests",
        },
        .{
            .id = "client/sampling#004-d651eb",
            .page = "client/sampling",
            .line = 43,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Applications SHOULD: Allow users to view and edit prompts before sending",
        },
        .{
            .id = "client/sampling#005-c00878",
            .page = "client/sampling",
            .line = 44,
            .section = "User Interaction Model",
            .anchor = "user-interaction-model",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Applications SHOULD: Present generated responses for review before delivery",
        },
        .{
            .id = "client/sampling#006-f1c927",
            .page = "client/sampling",
            .line = 52,
            .section = "Tools in Sampling",
            .anchor = "tools-in-sampling",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients MUST declare support for tool use via the `sampling.tools` capability to receive tool-enabled sampling requests.",
        },
        .{
            .id = "client/sampling#007-037778",
            .page = "client/sampling",
            .line = 52,
            .section = "Tools in Sampling",
            .anchor = "tools-in-sampling",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .server,
            .text = "Servers MUST NOT send tool-enabled sampling requests to Clients that have not declared support for tool use via the `sampling.tools` capability.",
        },
        .{
            .id = "client/sampling#008-b07e35",
            .page = "client/sampling",
            .line = 56,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Clients that support sampling MUST declare the `sampling` capability in `_meta.io.modelcontextprotocol/clientCapabilities` on each request:",
        },
        .{
            .id = "client/sampling#009-45983f",
            .page = "client/sampling",
            .line = 100,
            .section = "Capabilities",
            .anchor = "capabilities",
            .level = .should,
            .keywords = .{"SHOULD", "SHOULD NOT"},
            .party = .server,
            .text = "Servers SHOULD avoid using these values (e.g. can just omit `includeContext` since it defaults to `\"none\"`), and SHOULD NOT use them unless the client declares `sampling.context` capability.",
        },
        .{
            .id = "client/sampling#010-26228a",
            .page = "client/sampling",
            .line = 380,
            .section = "Tool Result Messages",
            .anchor = "tool-result-messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When a user message contains tool results (type: \"tool_result\"), it MUST contain ONLY tool results.",
        },
        .{
            .id = "client/sampling#011-05cb78",
            .page = "client/sampling",
            .line = 438,
            .section = "Tool Use and Result Balance",
            .anchor = "tool-use-and-result-balance",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "When using tool use in sampling, every assistant message containing `ToolUseContent` blocks MUST be followed by a user message that consists entirely of `ToolResultContent` blocks, with each tool use (e.g. with `id: $id`) matched by a corresponding tool result (with `toolUseId: $id`), before any other message.",
        },
        .{
            .id = "client/sampling#012-e137d5",
            .page = "client/sampling",
            .line = 477,
            .section = "Tool Choice Modes",
            .anchor = "tool-choice-modes",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "`{mode: \"required\"}`: Model MUST use at least one tool before completing",
        },
        .{
            .id = "client/sampling#013-d32f50",
            .page = "client/sampling",
            .line = 478,
            .section = "Tool Choice Modes",
            .anchor = "tool-choice-modes",
            .level = .must_not,
            .keywords = .{"MUST NOT"},
            .party = .client,
            .text = "`{mode: \"none\"}`: Model MUST NOT use any tools",
        },
        .{
            .id = "client/sampling#014-f68fea",
            .page = "client/sampling",
            .line = 488,
            .section = "Parallel Tool Use",
            .anchor = "parallel-tool-use",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "Implementations wrapping providers that support disabling parallel tool use MAY expose this as an extension, but it is not part of the core MCP specification.",
        },
        .{
            .id = "client/sampling#015-574369",
            .page = "client/sampling",
            .line = 523,
            .section = "Messages",
            .anchor = "messages",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "Sampling messages MUST contain a `role` field of `\"user\"` or `\"assistant\"`; and a `content` field representing the message data.",
        },
        .{
            .id = "client/sampling#016-931bff",
            .page = "client/sampling",
            .line = 526,
            .section = "Messages",
            .anchor = "messages",
            .level = .should_not,
            .keywords = .{"SHOULD NOT"},
            .party = .client,
            .text = "The list of messages in a sampling request SHOULD NOT be retained between separate requests.",
        },
        .{
            .id = "client/sampling#017-89c697",
            .page = "client/sampling",
            .line = 586,
            .section = "Model Hints",
            .anchor = "model-hints",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "Clients MAY map hints to equivalent models from different providers",
        },
        .{
            .id = "client/sampling#018-b7be44",
            .page = "client/sampling",
            .line = 609,
            .section = "System Prompt",
            .anchor = "system-prompt",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "The client MAY modify or ignore this field without communicating this to the server.",
        },
        .{
            .id = "client/sampling#019-b7be44",
            .page = "client/sampling",
            .line = 624,
            .section = "Context Inclusion",
            .anchor = "context-inclusion",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "The client MAY modify or ignore this field without communicating this to the server.",
        },
        .{
            .id = "client/sampling#020-f972b7",
            .page = "client/sampling",
            .line = 638,
            .section = "Sampling Parameters",
            .anchor = "sampling-parameters",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .client,
            .text = "The client MUST respect the `maxTokens` parameter.",
        },
        .{
            .id = "client/sampling#021-73e346",
            .page = "client/sampling",
            .line = 640,
            .section = "Sampling Parameters",
            .anchor = "sampling-parameters",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .client,
            .text = "The client MAY modify or ignore `temperature`, `stopSequences` and `metadata`.",
        },
        .{
            .id = "client/sampling#022-6cb06f",
            .page = "client/sampling",
            .line = 657,
            .section = "Result Fields",
            .anchor = "result-fields",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The specification defines the following (non-exhaustive) stop reasons, although implementations MAY provide their own arbitrary values: `\"endTurn\"`: The participant is yielding the conversation to the other party.",
        },
        .{
            .id = "client/sampling#023-3de7cc",
            .page = "client/sampling",
            .line = 658,
            .section = "Result Fields",
            .anchor = "result-fields",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The specification defines the following (non-exhaustive) stop reasons, although implementations MAY provide their own arbitrary values: `\"stopSequence\"`: Message generation encountered one of the requested `stopSequences`.",
        },
        .{
            .id = "client/sampling#024-7fed84",
            .page = "client/sampling",
            .line = 659,
            .section = "Result Fields",
            .anchor = "result-fields",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The specification defines the following (non-exhaustive) stop reasons, although implementations MAY provide their own arbitrary values: `\"maxTokens\"`: The token limit was reached.",
        },
        .{
            .id = "client/sampling#025-660d1e",
            .page = "client/sampling",
            .line = 660,
            .section = "Result Fields",
            .anchor = "result-fields",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .both,
            .text = "The specification defines the following (non-exhaustive) stop reasons, although implementations MAY provide their own arbitrary values: `\"toolUse\"`: The model wants to use one or more tools.",
        },
        .{
            .id = "client/sampling#026-ec4f08",
            .page = "client/sampling",
            .line = 669,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD implement user approval controls",
        },
        .{
            .id = "client/sampling#027-e17277",
            .page = "client/sampling",
            .line = 670,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Both parties SHOULD validate message content",
        },
        .{
            .id = "client/sampling#028-0e6756",
            .page = "client/sampling",
            .line = 671,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD respect model preference hints",
        },
        .{
            .id = "client/sampling#029-8d15be",
            .page = "client/sampling",
            .line = 672,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "Clients SHOULD implement rate limiting",
        },
        .{
            .id = "client/sampling#030-74a388",
            .page = "client/sampling",
            .line = 673,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .both,
            .text = "Both parties MUST handle sensitive data appropriately",
        },
        .{
            .id = "client/sampling#031-e67ba5",
            .page = "client/sampling",
            .line = 677,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Servers MUST ensure that when replying to a `stopReason: \"toolUse\"`, each `ToolUseContent` item is responded to with a `ToolResultContent` item with a matching `toolUseId`, and that the user message contains only tool results (no other content types)",
        },
        .{
            .id = "client/sampling#032-85d56b",
            .page = "client/sampling",
            .line = 678,
            .section = "Security Considerations",
            .anchor = "security-considerations",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "Both parties SHOULD implement iteration limits for tool loops",
        },
        .{
            .id = "deprecated#001-ab9060",
            .page = "deprecated",
            .line = 12,
            .section = "",
            .anchor = "",
            .level = .should_not,
            .keywords = .{"SHOULD NOT", "SHOULD"},
            .party = .both,
            .text = "A Deprecated feature remains part of the specification but is scheduled for removal: new implementations SHOULD NOT adopt it, and existing implementations SHOULD migrate before the feature's earliest removal.",
        },
        .{
            .id = "index#001-0e5f58",
            .page = "index",
            .line = 120,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "While MCP itself cannot enforce these security principles at the protocol level, implementors SHOULD: Build robust consent and authorization flows into their applications",
        },
        .{
            .id = "index#002-e049ca",
            .page = "index",
            .line = 121,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "While MCP itself cannot enforce these security principles at the protocol level, implementors SHOULD: Provide clear documentation of security implications",
        },
        .{
            .id = "index#003-f2c003",
            .page = "index",
            .line = 122,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "While MCP itself cannot enforce these security principles at the protocol level, implementors SHOULD: Implement appropriate access controls and data protections",
        },
        .{
            .id = "index#004-f32eea",
            .page = "index",
            .line = 123,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "While MCP itself cannot enforce these security principles at the protocol level, implementors SHOULD: Follow security best practices in their integrations",
        },
        .{
            .id = "index#005-986d60",
            .page = "index",
            .line = 124,
            .section = "Implementation Guidelines",
            .anchor = "implementation-guidelines",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .both,
            .text = "While MCP itself cannot enforce these security principles at the protocol level, implementors SHOULD: Consider privacy implications in their feature designs",
        },
        .{
