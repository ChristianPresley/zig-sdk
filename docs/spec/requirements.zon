            .page = "server/prompts",
            .line = 271,
            .section = "Audio Content",
            .anchor = "audio-content",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "The audio data MUST be base64-encoded and include a valid MIME type.",
        },
        .{
