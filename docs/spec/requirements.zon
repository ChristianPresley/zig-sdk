            .page = "server/prompts",
            .line = 256,
            .section = "Image Content",
            .anchor = "image-content",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "The image data MUST be base64-encoded and include a valid MIME type.",
        },
        .{
