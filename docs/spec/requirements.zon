            .line = 311,
            .section = "Embedded Resources",
            .anchor = "embedded-resources",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Resources can contain either text or binary (blob) data and MUST include: A valid resource URI",
