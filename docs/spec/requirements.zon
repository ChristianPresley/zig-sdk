            .page = "server/prompts",
            .line = 323,
            .section = "Error Handling",
            .anchor = "error-handling",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .server,
            .text = "Servers SHOULD return standard JSON-RPC errors for common failure cases: Invalid prompt name: `-32602` (Invalid params)",
        },
        .{
