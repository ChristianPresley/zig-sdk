            .anchor = "capabilities",
            .level = .may,
            .keywords = .{"MAY"},
            .party = .server,
            .text = "The set MAY vary by the authorization presented on the request \xe2\x80\x94 for example, returning only the resources the caller's granted scopes permit \xe2\x80\x94 since credentials are per-request input, not connection state.",
        },
        .{
