            .page = "server/prompts",
            .line = 313,
            .section = "Embedded Resources",
            .anchor = "embedded-resources",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Resources can contain either text or binary (blob) data and MUST include: Either text content or base64-encoded blob data",
        },
        .{
