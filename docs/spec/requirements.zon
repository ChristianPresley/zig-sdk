            .line = 76,
            .section = "When to Call",
            .anchor = "when-to-call",
            .level = .should,
            .keywords = .{"SHOULD"},
            .party = .client,
            .text = "A client that supports both modern (per-request `_meta`) and legacy (`initialize` handshake) servers SHOULD send `server/discover` first; see stdio: Backward Compatibility for the fallback rules.",
        },
        .{
