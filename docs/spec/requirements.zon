            .line = 312,
            .section = "Embedded Resources",
            .anchor = "embedded-resources",
            .level = .must,
            .keywords = .{"MUST"},
            .party = .server,
            .text = "Resources can contain either text or binary (blob) data and MUST include: The appropriate MIME type",
        },
        .{
